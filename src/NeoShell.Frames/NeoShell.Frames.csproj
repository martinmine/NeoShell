<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A program of its own, run elevated by a logon task; no WinUI: plain Win32 message loops, one per app thread. -->
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>NeoShell window frames</AssemblyTitle>
  </PropertyGroup>

  <!-- Published inside NeoShell's folder, on the .NET that NeoShell carries (NeoShell.csproj); the SDK won't let a
       self-contained NeoShell reference a program that isn't self-contained too. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeoShell.Interop\NeoShell.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NeoShell.Tests" />
  </ItemGroup>

</Project>
