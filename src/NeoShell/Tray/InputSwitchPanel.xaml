<?xml version="1.0" encoding="utf-8"?>
<!--
    The input switcher, as Windows 11's: a header with Win+Spacebar's keys, the enabled input methods (language letters
    or an IME's glyph, language and keyboard; the one in front chosen) and a link to the keyboard settings. Win+Space
    shows the list alone.
-->
<UserControl
    x:Class="NeoShell.Tray.InputSwitchPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoShell.Tray">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///FlatButtons.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <!-- A key of the shortcut in the header: a faint outline round the key's name. -->
        <Style x:Key="KeyCapStyle" TargetType="Border">
            <Setter Property="Height" Value="16" />
            <Setter Property="MinWidth" Value="16" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Width="358">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Header and list are a shade lighter than the flyout's acrylic; the footer is the acrylic itself. -->
        <Border Grid.RowSpan="2" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" />

        <StackPanel x:Name="Header" Height="42" Padding="15,0,0,0" Orientation="Horizontal" Spacing="8">
            <TextBlock Margin="0,11,0,0" Text="Keyboard layout" />
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                AutomationProperties.Name="Windows key plus Spacebar">
                <Border Style="{StaticResource KeyCapStyle}">
                    <!-- The Windows logo: four panes, as the Start button's. -->
                    <Grid Width="8" Height="8" RowSpacing="1" ColumnSpacing="1">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Row="0" Grid.Column="0" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Rectangle Grid.Row="0" Grid.Column="1" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Rectangle Grid.Row="1" Grid.Column="0" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Rectangle Grid.Row="1" Grid.Column="1" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>
                </Border>
                <TextBlock
                    VerticalAlignment="Center"
                    Margin="1,0,-1,0"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="+" />
                <Border Style="{StaticResource KeyCapStyle}" Padding="3,0">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="Spacebar" />
                </Border>
            </StackPanel>
        </StackPanel>

        <ListView
            x:Name="MethodList"
            Grid.Row="1"
            SelectionMode="Single"
            IsItemClickEnabled="True"
            ItemClick="MethodList_ItemClick"
            AutomationProperties.AutomationId="InputMethodList"
            AutomationProperties.Name="Keyboard layout">
            <ListView.ItemContainerStyle>
                <!-- The item's plate is inset 4 by 2 by WinUI itself, as Explorer's. -->
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="16,0,12,0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="VerticalContentAlignment" Value="Top" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:InputMethodItem">
                    <Grid
                        Margin="{x:Bind ContentMargin}"
                        AutomationProperties.AutomationId="{x:Bind AutomationId}"
                        AutomationProperties.Name="{x:Bind Name}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <!-- The language's letters, set on the title's baseline; or a text service's glyph. -->
                        <TextBlock
                            Margin="0,0,0,2"
                            VerticalAlignment="Bottom"
                            FontSize="12"
                            Text="{x:Bind Code}"
                            Visibility="{x:Bind CodeVisibility}" />
                        <FontIcon
                            Margin="4,0,0,0"
                            HorizontalAlignment="Left"
                            FontSize="16"
                            Glyph="{x:Bind Glyph}"
                            Visibility="{x:Bind GlyphVisibility}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Language}" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,1,0,0"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Keyboard}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Explorer's line above the footer is darker than both sides of it. -->
        <Rectangle Grid.Row="2" Height="1" VerticalAlignment="Top" Fill="#1A000000" />
        <Button
            x:Name="Footer"
            Grid.Row="2"
            Style="{StaticResource FlatButtonStyle}"
            Width="NaN"
            Height="48"
            Margin="0,1,0,0"
            Padding="11,0,12,2"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            CornerRadius="0"
            AutomationProperties.AutomationId="MoreKeyboardSettingsButton"
            Click="Footer_Click">
            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="More keyboard settings" />
        </Button>
    </Grid>
</UserControl>
