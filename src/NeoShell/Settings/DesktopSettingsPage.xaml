<?xml version="1.0" encoding="utf-8"?>
<local:SettingsPageView
    x:Class="NeoShell.Settings.DesktopSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoShell.Settings">
    <local:SettingsPageView.Resources>
        <ResourceDictionary Source="ms-appx:///Settings/SettingsStyles.xaml" />
    </local:SettingsPageView.Resources>

    <StackPanel Spacing="4">
        <TextBlock
            x:Name="DesktopNote"
            Margin="1,0,0,8"
            Style="{StaticResource SettingsDescriptionStyle}" />

        <Button
            x:Name="BackgroundLink"
            Style="{StaticResource SettingsLinkCardStyle}"
            AutomationProperties.AutomationId="BackgroundSettingsLink"
            AutomationProperties.Name="Background"
            Click="Background_Click">
            <local:SettingsCard
                Style="{StaticResource SettingsLinkContentStyle}"
                Glyph="&#xE91B;"
                Header="Background"
                Description="Picture, solid colour or slideshow, and how it fits each display">
                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
            </local:SettingsCard>
        </Button>
        <Button
            Style="{StaticResource SettingsLinkCardStyle}"
            AutomationProperties.AutomationId="DesktopIconSettingsLink"
            AutomationProperties.Name="Desktop icon settings"
            Click="DesktopIcons_Click">
            <local:SettingsCard
                Style="{StaticResource SettingsLinkContentStyle}"
                Glyph="&#xE7F4;"
                Header="Desktop icon settings"
                Description="This PC, Recycle Bin and the other icons Windows puts on the desktop">
                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
            </local:SettingsCard>
        </Button>
    </StackPanel>
</local:SettingsPageView>
