<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NeoShell.Taskbar.Clock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Button
        x:Name="ClockButton"
        AutomationProperties.AutomationId="ClockButton"
        AutomationProperties.Name="Clock"
        Height="40"
        Padding="8,0"
        CornerRadius="4"
        BorderThickness="0"
        Click="ClockButton_Click">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TimeText" HorizontalAlignment="Right" FontSize="12" />
                <TextBlock x:Name="DateText" HorizontalAlignment="Right" FontSize="12" />
            </StackPanel>
            <!-- Do not disturb's bell, while it's on, as Explorer shows it beside the clock. -->
            <FontIcon
                x:Name="DoNotDisturbIcon"
                AutomationProperties.AutomationId="DoNotDisturbIndicator"
                Glyph="&#xF285;"
                FontSize="16"
                Visibility="Collapsed" />
        </StackPanel>
    </Button>
</UserControl>
