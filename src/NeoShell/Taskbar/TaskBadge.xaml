<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NeoShell.Taskbar.TaskBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Explorer's BadgeBackgroundBrush: the light accent on a dark taskbar, the accent itself on a light one. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TaskBadgeBackgroundBrush" Color="{ThemeResource SystemAccentColorLight2}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TaskBadgeBackgroundBrush" Color="{ThemeResource SystemAccentColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- A 16 px dot, or a pill as wide as the count. The default colours are style setters, so that clearing a glyph's
         own colour falls back to them and they still follow the theme. -->
    <Border x:Name="Plate" Height="16" MinWidth="16" CornerRadius="8" Visibility="Collapsed">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource TaskBadgeBackgroundBrush}" />
            </Style>
        </Border.Style>
        <TextBlock x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Border>
</UserControl>
