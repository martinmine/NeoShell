<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NeoShell.Taskbar.TaskbarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoShell.Taskbar"
    xmlns:tray="using:NeoShell.Tray"
    xmlns:qs="using:NeoShell.QuickSettings">

    <!-- Transparent, not null: the background must take right-clicks for the context menu. -->
    <Grid x:Name="Root" Background="Transparent" ContextRequested="Root_ContextRequested">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///FlatButtons.xaml" />
                </ResourceDictionary.MergedDictionaries>

                <!-- The search entry point's colours, measured on Explorer's taskbar (its dark brushes for the box are
                     stronger than WinUI's; on an accent-coloured taskbar it uses the dark ones). The borders are one
                     pixel round a 32 px high pill, whose top row (in light the bottom row of the box) differs. -->
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <LinearGradientBrush x:Key="SearchIconRingBrush" StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#FAFAFA" />
                            <GradientStop Offset="1" Color="#D2D2D2" />
                        </LinearGradientBrush>
                        <SolidColorBrush x:Key="SearchIconHandleBrush" Color="#D7D7D7" />
                        <LinearGradientBrush x:Key="SearchIconLensBrush" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#38FFFFFF" />
                            <GradientStop Offset="1" Color="#2CFFFFFF" />
                        </LinearGradientBrush>
                        <SolidColorBrush x:Key="SearchBoxBackground" Color="#25FFFFFF" />
                        <SolidColorBrush x:Key="SearchBoxBackgroundPointerOver" Color="#2BFFFFFF" />
                        <StaticResource x:Key="SearchBoxBackgroundPressed" ResourceKey="ControlFillColorInputActiveBrush" />
                        <LinearGradientBrush x:Key="SearchBoxBorderBrush" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.03" Color="#4EFFFFFF" />
                            <GradientStop Offset="0.03" Color="#2EFFFFFF" />
                        </LinearGradientBrush>
                        <SolidColorBrush x:Key="SearchBoxBorderBrushPressed" Color="#2EFFFFFF" />
                        <SolidColorBrush x:Key="SearchBoxHoverLensBrush" Color="#2DFFFFFF" />
                        <LinearGradientBrush x:Key="SearchPillBorderBrush" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.03" Color="#18FFFFFF" />
                            <GradientStop Offset="0.03" Color="#12FFFFFF" />
                        </LinearGradientBrush>
                        <SolidColorBrush x:Key="SearchPillBorderBrushPressed" Color="#0CFFFFFF" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <LinearGradientBrush x:Key="SearchIconRingBrush" StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#444444" />
                            <GradientStop Offset="1" Color="#1F1F1F" />
                        </LinearGradientBrush>
                        <SolidColorBrush x:Key="SearchIconHandleBrush" Color="#1F1F1F" />
                        <LinearGradientBrush x:Key="SearchIconLensBrush" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#0F000000" />
                            <GradientStop Offset="1" Color="#00000000" />
                        </LinearGradientBrush>
                        <StaticResource x:Key="SearchBoxBackground" ResourceKey="ControlFillColorDefaultBrush" />
                        <StaticResource x:Key="SearchBoxBackgroundPointerOver" ResourceKey="ControlFillColorSecondaryBrush" />
                        <StaticResource x:Key="SearchBoxBackgroundPressed" ResourceKey="ControlFillColorInputActiveBrush" />
                        <LinearGradientBrush x:Key="SearchBoxBorderBrush" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.97" Color="#0F000000" />
                            <GradientStop Offset="0.97" Color="#29000000" />
                        </LinearGradientBrush>
                        <SolidColorBrush x:Key="SearchBoxBorderBrushPressed" Color="#0F000000" />
                        <SolidColorBrush x:Key="SearchBoxHoverLensBrush" Color="#0D000000" />
                        <LinearGradientBrush x:Key="SearchPillBorderBrush" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.03" Color="#05000000" />
                            <GradientStop Offset="0.03" Color="#0B000000" />
                        </LinearGradientBrush>
                        <SolidColorBrush x:Key="SearchPillBorderBrushPressed" Color="#03000000" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>

                <!-- The search icon alone, and in the search box when hovered: a ring round a tinted lens, and a handle
                     (Explorer's is an animated icon). Drawn in a 24 px square, an app icon's size. -->
                <Style x:Key="SearchIconRingStyle" TargetType="Ellipse">
                    <Setter Property="Canvas.Left" Value="1.45" />
                    <Setter Property="Canvas.Top" Value="1" />
                    <Setter Property="Width" Value="19.2" />
                    <Setter Property="Height" Value="18.5" />
                    <Setter Property="StrokeThickness" Value="2.5" />
                </Style>
                <Style x:Key="SearchIconHandleStyle" TargetType="Line">
                    <Setter Property="X1" Value="17.9" />
                    <Setter Property="Y1" Value="18" />
                    <Setter Property="X2" Value="21.5" />
                    <Setter Property="Y2" Value="22" />
                    <Setter Property="StrokeThickness" Value="2.6" />
                    <Setter Property="StrokeStartLineCap" Value="Round" />
                    <Setter Property="StrokeEndLineCap" Value="Round" />
                </Style>

                <!-- "Search box": a 220x32 pill with the magnifier and a placeholder. Hovered, the magnifier takes
                     Windows Search's colours; pressed, the box looks like a focused text box. -->
                <Style x:Key="SearchBoxStyle" TargetType="Button">
                    <Setter Property="Width" Value="220" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Margin" Value="2,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="Plate"
                                    CornerRadius="16"
                                    BorderThickness="1"
                                    Background="{ThemeResource SearchBoxBackground}"
                                    BorderBrush="{ThemeResource SearchBoxBorderBrush}">
                                    <Border.BackgroundTransition>
                                        <BrushTransition Duration="0:0:0.133" />
                                    </Border.BackgroundTransition>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <!-- The icons cross-fade with storyboards: an OpacityTransition here crashes WinUI. -->
                                            <VisualState x:Name="Normal">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.133" />
                                                    <DoubleAnimation Storyboard.TargetName="HoverIcon" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.133" />
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="Plate.Background" Value="{ThemeResource SearchBoxBackgroundPointerOver}" />
                                                </VisualState.Setters>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.133" />
                                                    <DoubleAnimation Storyboard.TargetName="HoverIcon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.133" />
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="Plate.Background" Value="{ThemeResource SearchBoxBackgroundPressed}" />
                                                    <Setter Target="Plate.BorderBrush" Value="{ThemeResource SearchBoxBorderBrushPressed}" />
                                                    <Setter Target="Placeholder.Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </VisualState.Setters>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.133" />
                                                    <DoubleAnimation Storyboard.TargetName="HoverIcon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.133" />
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Disabled" />
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                                        <Grid Width="16" Height="16">
                                            <!-- The search icon, smaller; hovered, it grows a little as it takes the colours. -->
                                            <Viewbox x:Name="Glyph" Width="16.4" Height="16.4" Margin="0.15,-0.05,-0.55,-0.35">
                                                <Canvas Width="24" Height="24">
                                                    <Ellipse Style="{StaticResource SearchIconRingStyle}" Fill="{ThemeResource SearchIconLensBrush}" Stroke="{ThemeResource SearchIconRingBrush}" />
                                                    <Line Style="{StaticResource SearchIconHandleStyle}" Stroke="{ThemeResource SearchIconHandleBrush}" />
                                                </Canvas>
                                            </Viewbox>
                                            <Viewbox x:Name="HoverIcon" Width="18.5" Height="18.5" Margin="-1,-1,-1.5,-1.5" Opacity="0">
                                                <Canvas Width="24" Height="24">
                                                    <Ellipse Style="{StaticResource SearchIconRingStyle}" Fill="{ThemeResource SearchBoxHoverLensBrush}">
                                                        <Ellipse.Stroke>
                                                            <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                                                                <GradientStop Offset="0.1" Color="#58DC7E" />
                                                                <GradientStop Offset="0.5" Color="#1F9BB5" />
                                                                <GradientStop Offset="0.8" Color="#0078D3" />
                                                            </LinearGradientBrush>
                                                        </Ellipse.Stroke>
                                                    </Ellipse>
                                                    <Line Style="{StaticResource SearchIconHandleStyle}" Stroke="#0077D4" />
                                                </Canvas>
                                            </Viewbox>
                                        </Grid>
                                        <TextBlock
                                            x:Name="Placeholder"
                                            Margin="10,0,0,2"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Search" />
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- "Search icon and label": a 100x32 pill with the bold magnifier and "Search" centred in it, in a
                     106 px slot as tall as the taskbar. -->
                <Style x:Key="SearchPillStyle" TargetType="Button">
                    <Setter Property="Width" Value="106" />
                    <Setter Property="Height" Value="48" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid Background="Transparent">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="Plate.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="Plate.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                                    <Setter Target="Plate.BorderBrush" Value="{ThemeResource SearchPillBorderBrushPressed}" />
                                                    <Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Disabled" />
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Border
                                        x:Name="Plate"
                                        Margin="3,8"
                                        CornerRadius="16"
                                        BorderThickness="1"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource SearchPillBorderBrush}">
                                        <Border.BackgroundTransition>
                                            <BrushTransition Duration="0:0:0.15" />
                                        </Border.BackgroundTransition>
                                    </Border>
                                    <ContentPresenter
                                        x:Name="Label"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{TemplateBinding Foreground}"
                                        Content="{TemplateBinding Content}" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- The taskbar's menus: see-through, so their own backdrop shows (SetTheme). -->
                <Style x:Key="ShellMenuPresenterStyle" TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
                    <Setter Property="Background" Value="Transparent" />
                </Style>

                <!-- A task button's menu (its jump list): as wide as Explorer's whatever it holds, border included, and a pixel
                     taller at the bottom. -->
                <Style x:Key="JumpListPresenterStyle" TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource ShellMenuPresenterStyle}">
                    <Setter Property="MinWidth" Value="296" />
                    <Setter Property="MaxWidth" Value="296" />
                    <Setter Property="Padding" Value="0,2,0,3" />
                </Style>

                <!-- A jump list's category heading in a task button's menu: text only, not a command. -->
                <Style x:Key="JumpListHeaderStyle" TargetType="MenuFlyoutItem">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuFlyoutItem">
                                <TextBlock
                                    Margin="16,8,12,8"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{TemplateBinding Text}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- A tray icon: every mouse action goes to the icon's app. Its width is the container's. -->
                <DataTemplate x:Key="TrayIconTemplate" x:DataType="tray:TrayIcon">
                    <Grid
                        Height="40"
                        Background="Transparent"
                        AutomationProperties.AutomationId="TrayIcon"
                        AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                        PointerPressed="TrayIcon_PointerPressed"
                        PointerReleased="TrayIcon_PointerReleased"
                        PointerMoved="TrayIcon_PointerMoved"
                        PointerEntered="TrayIcon_PointerEntered"
                        PointerExited="TrayIcon_PointerExited"
                        PointerCaptureLost="TrayIcon_PointerCaptureLost"
                        ContextRequested="TrayIcon_ContextRequested">
                        <ToolTipService.ToolTip>
                            <!-- Placed as Explorer's (TaskbarToolTips); none for an icon without a tip. -->
                            <ToolTip Content="{x:Bind ToolTip, Mode=OneWay}" Opened="TrayIconToolTip_Opened" SizeChanged="TrayIconToolTip_SizeChanged" />
                        </ToolTipService.ToolTip>
                        <Border CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Opacity="0" />
                        <Image Width="16" Height="16" Source="{x:Bind Icon, Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--
            Spans both columns so "centred" means the middle of the screen, as in Windows 11. Placed by its left margin
            (PlaceAppsPanel): centred, it moves left of the middle when the buttons need the room.
        -->
        <StackPanel
            x:Name="AppsPanel"
            Grid.ColumnSpan="2"
            Margin="11,0,0,0"
            Orientation="Horizontal"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
            <Button
                x:Name="StartButton"
                AutomationProperties.AutomationId="StartButton"
                AutomationProperties.Name="Start"
                ToolTipService.ToolTip="Start"
                Style="{StaticResource FlatButtonStyle}"
                Click="StartButton_Click"
                ContextRequested="StartButton_ContextRequested">
                <!-- Explorer's logo: four 11 px squares. -->
                <Grid Width="23" Height="23" ColumnSpacing="1" RowSpacing="1">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Row="0" Grid.Column="0" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Rectangle Grid.Row="0" Grid.Column="1" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Rectangle Grid.Row="1" Grid.Column="0" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Rectangle Grid.Row="1" Grid.Column="1" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                </Grid>
            </Button>
            <!-- Explorer's search setting picks one of these (SetSearchMode); Explorer shows no tooltip on the label. -->
            <Button
                x:Name="SearchButton"
                AutomationProperties.AutomationId="SearchButton"
                AutomationProperties.Name="Search"
                ToolTipService.ToolTip="Search"
                Style="{StaticResource FlatButtonStyle}"
                Click="StartButton_Click">
                <Canvas x:Name="SearchButtonIcon" Width="24" Height="24">
                    <Ellipse Style="{StaticResource SearchIconRingStyle}" Fill="{ThemeResource SearchIconLensBrush}" Stroke="{ThemeResource SearchIconRingBrush}" />
                    <Line Style="{StaticResource SearchIconHandleStyle}" Stroke="{ThemeResource SearchIconHandleBrush}" />
                </Canvas>
            </Button>
            <Button
                x:Name="SearchBox"
                AutomationProperties.AutomationId="SearchBox"
                AutomationProperties.Name="Search"
                ToolTipService.ToolTip="Search"
                Style="{StaticResource SearchBoxStyle}"
                Visibility="Collapsed"
                Click="StartButton_Click" />
            <Button
                x:Name="SearchPill"
                AutomationProperties.AutomationId="SearchPill"
                AutomationProperties.Name="Search"
                Style="{StaticResource SearchPillStyle}"
                Visibility="Collapsed"
                Click="StartButton_Click">
                <StackPanel Orientation="Horizontal">
                    <!-- A pixel lower than the label's centre, as in Explorer. -->
                    <FontIcon x:Name="SearchPillIcon" Margin="0,1,0,-1" Glyph="&#xF78B;" FontSize="16" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="Search" />
                </StackPanel>
            </Button>
            <ListView
                x:Name="TaskList"
                AutomationProperties.AutomationId="TaskList"
                AutomationProperties.Name="Running applications"
                Padding="0"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="TaskList_ItemClick"
                ScrollViewer.HorizontalScrollMode="Disabled"
                ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                ScrollViewer.VerticalScrollMode="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <!-- None: a moved button would be animated as removed and added again. The window animates changes. -->
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Height" Value="48" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="UseSystemFocusVisuals" Value="True" />
                        <!-- Just the content: the default presenter insets its hover plate, smaller than Explorer's. -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TaskButton">
                        <Grid
                            Width="{x:Bind Width, Mode=OneWay}"
                            Background="Transparent"
                            AutomationProperties.AutomationId="TaskButton"
                            AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                            AutomationProperties.HelpText="{x:Bind BadgeHelpText, Mode=OneWay}"
                            PointerPressed="TaskItem_PointerPressed"
                            PointerEntered="TaskItem_PointerEntered"
                            PointerExited="TaskItem_PointerExited"
                            ContextRequested="TaskItem_ContextRequested">
                            <!-- Not a ContextFlyout: WinUI would open that at the pointer itself (TaskItem_ContextRequested). -->
                            <FlyoutBase.AttachedFlyout>
                                <MenuFlyout Opening="TaskMenu_Opening" Closed="TaskMenu_Closed" MenuFlyoutPresenterStyle="{StaticResource JumpListPresenterStyle}" />
                            </FlyoutBase.AttachedFlyout>
                            <!-- Plates as in Explorer: 40x40 behind the active app, lighter while hovered; with several
                                 windows, the edge of a second card shows on the right (its gap in its own margin, so a single
                                 window's plate keeps all 40). -->
                            <Grid Margin="2,4" Visibility="{x:Bind ActiveVisibility, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    CornerRadius="4"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1" />
                                <Border
                                    Grid.Column="1"
                                    Width="3"
                                    Margin="2,1,0,1"
                                    CornerRadius="0,4,4,0"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    Visibility="{x:Bind StackVisibility, Mode=OneWay}" />
                            </Grid>
                            <Grid Margin="2,4" Visibility="{x:Bind HoverVisibility, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                <Border
                                    Grid.Column="1"
                                    Width="3"
                                    Margin="2,1,0,1"
                                    CornerRadius="0,4,4,0"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Visibility="{x:Bind StackVisibility, Mode=OneWay}" />
                            </Grid>
                            <!-- The window asks for attention. -->
                            <Border
                                Margin="2,4"
                                CornerRadius="4"
                                Background="{ThemeResource SystemFillColorCautionBrush}"
                                Opacity="0.4"
                                Visibility="{x:Bind FlashVisibility, Mode=OneWay}" />
                            <!-- The icon 10 px in (centred on a button without a label), the label 8 px after it, as Explorer's. -->
                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <!-- Shrinks while pressed and grows while dragged (IconPress). -->
                                <Grid x:Name="TaskIcon" Width="24" Height="24">
                                    <Image Source="{x:Bind Icon, Mode=OneWay}" />
                                    <!-- The app's overlay icon and badge share the icon's top-right corner, 16 px from 6 px
                                         right of the icon and 7 above it, as in Explorer; the badge wins. -->
                                    <Image
                                        Width="16"
                                        Height="16"
                                        Margin="0,-7,-6,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Source="{x:Bind Overlay, Mode=OneWay}"
                                        Visibility="{x:Bind OverlayVisibility, Mode=OneWay}" />
                                    <local:TaskBadge
                                        Margin="0,-7,-6,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Badge="{x:Bind Badge, Mode=OneWay}" />
                                </Grid>
                                <TextBlock
                                    Width="{x:Bind LabelWidth, Mode=OneWay}"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    Visibility="{x:Bind LabelVisibility, Mode=OneWay}" />
                            </StackPanel>
                            <!-- The app's progress, along the bottom of the button. -->
                            <ProgressBar
                                Margin="8,0,8,9"
                                VerticalAlignment="Bottom"
                                MinHeight="3"
                                Height="3"
                                Maximum="100"
                                Value="{x:Bind ProgressPercent, Mode=OneWay}"
                                IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}"
                                ShowError="{x:Bind IsProgressError, Mode=OneWay}"
                                ShowPaused="{x:Bind IsProgressPaused, Mode=OneWay}"
                                Visibility="{x:Bind ProgressVisibility, Mode=OneWay}"
                                AutomationProperties.AutomationId="TaskProgress" />
                            <!-- Running: short grey pill; active: long accent pill. Under the icon, as Explorer's. -->
                            <Grid Width="44" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,5">
                                <Rectangle Width="6" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind RunningVisibility, Mode=OneWay}" />
                                <Rectangle Width="16" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind ActiveVisibility, Mode=OneWay}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <StackPanel x:Name="RightPanel" Grid.Column="1" Orientation="Horizontal">
            <!--
                The tray, on the primary taskbar while NeoShell is the shell: the hidden icons behind the chevron, then
                the promoted ones. Icons are dragged between the two and along each.
            -->
            <StackPanel x:Name="TrayArea" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <Button
                    x:Name="OverflowButton"
                    AutomationProperties.AutomationId="TrayOverflowButton"
                    AutomationProperties.Name="Show hidden icons"
                    ToolTipService.ToolTip="Show hidden icons"
                    Width="32"
                    Margin="0"
                    Style="{StaticResource FlatButtonStyle}"
                    Click="OverflowButton_Click">
                    <!--
                        ChevronUpMed at 16, as Explorer's on a bottom taskbar. Shrinks while pressed (IconPress) and points
                        down while the flyout is open.
                    -->
                    <FontIcon x:Name="OverflowChevron" Glyph="&#xE971;" FontSize="16" />
                    <FlyoutBase.AttachedFlyout>
                        <Flyout x:Name="OverflowFlyout" Opening="OverflowFlyout_Opening" Closing="OverflowFlyout_Closing">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                                    <!-- The flyout's own backdrop shows through (SetTheme). -->
                                    <Setter Property="Background" Value="Transparent" />
                                    <!-- As Explorer's: 40 by 40 icons, 4 from the edge counting the border. -->
                                    <Setter Property="Padding" Value="3" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <ItemsControl x:Name="OverflowIcons" ItemTemplate="{StaticResource TrayIconTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="5" ItemWidth="40" ItemHeight="40" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </Button>
                <ItemsControl x:Name="TrayIcons" ItemTemplate="{StaticResource TrayIconTemplate}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Width" Value="32" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
            <!--
                Privacy (while apps use the microphone or the location), network and volume, on the primary taskbar.
                As Explorer's, the chevron, the tray icons, these and the clock sit right against each other.
            -->
            <StackPanel x:Name="IndicatorArea" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <!-- Explorer's privacy indicator: the microphone, the location arrow or both, in the accent's text colour. -->
                <Button
                    x:Name="PrivacyButton"
                    AutomationProperties.AutomationId="PrivacyIndicator"
                    Width="32"
                    Margin="0"
                    Style="{StaticResource FlatButtonStyle}"
                    Visibility="Collapsed"
                    Click="Privacy_Click"
                    ContextRequested="Privacy_ContextRequested">
                    <FontIcon x:Name="PrivacyIcon" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <FlyoutBase.AttachedFlyout>
                        <MenuFlyout x:Name="PrivacyMenu" MenuFlyoutPresenterStyle="{StaticResource ShellMenuPresenterStyle}">
                            <MenuFlyoutItem
                                x:Name="MicrophonePrivacyMenuItem"
                                AutomationProperties.AutomationId="MicrophonePrivacySettingsMenuItem"
                                Text="Microphone privacy settings"
                                Click="MicrophonePrivacySettings_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE713;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Name="LocationPrivacyMenuItem"
                                AutomationProperties.AutomationId="LocationPrivacySettingsMenuItem"
                                Text="Location privacy settings"
                                Click="LocationPrivacySettings_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE713;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </FlyoutBase.AttachedFlyout>
                </Button>
                <!-- An IME's mode ("あ" or "A") while one is in front: a click switches it. -->
                <Button
                    x:Name="ImeModeButton"
                    AutomationProperties.AutomationId="ImeModeIndicator"
                    Width="32"
                    Style="{StaticResource FlatButtonStyle}"
                    Margin="0"
                    Visibility="Collapsed"
                    Click="ImeMode_Click"
                    ContextRequested="ImeMode_ContextRequested">
                    <FontIcon x:Name="ImeModeIcon" FontSize="16" />
                </Button>
                <!--
                    The input method in front, while more than one is enabled: the language's letters over the
                    keyboard's, or a text service's glyph. It opens the input switcher.
                -->
                <Button
                    x:Name="InputButton"
                    AutomationProperties.AutomationId="InputIndicator"
                    Width="44"
                    Margin="0"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Style="{StaticResource FlatButtonStyle}"
                    Visibility="Collapsed"
                    Click="InputButton_Click">
                    <Grid>
                        <!-- While the switcher is open the button keeps its hover plate, as Explorer's does. -->
                        <Border
                            x:Name="InputOpenPlate"
                            CornerRadius="4"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Visibility="Collapsed" />
                        <StackPanel x:Name="InputCodes" Margin="0,0,0,2" VerticalAlignment="Center">
                            <TextBlock x:Name="InputLanguageText" HorizontalAlignment="Center" FontSize="12" LineHeight="16" />
                            <TextBlock x:Name="InputKeyboardText" HorizontalAlignment="Center" FontSize="12" LineHeight="16" />
                        </StackPanel>
                        <FontIcon x:Name="InputGlyph" Margin="0,0,0,2" FontSize="16" Visibility="Collapsed" />
                    </Grid>
                    <FlyoutBase.AttachedFlyout>
                        <Flyout x:Name="InputFlyout" Opened="InputFlyout_Opened" Closed="InputFlyout_Closed">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="MaxWidth" Value="400" />
                                    <!-- The flyout's own backdrop shows through (SetTheme). -->
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <tray:InputSwitchPanel x:Name="InputSwitcher" />
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </Button>
                <!--
                    Network, volume and battery are one button, as on the Windows 11 taskbar: it opens Quick Settings.
                    Each icon has its own tooltip and menu.
                -->
                <Button
                    x:Name="QuickSettingsButton"
                    AutomationProperties.AutomationId="QuickSettingsButton"
                    AutomationProperties.Name="Quick Settings"
                    Width="Auto"
                    Margin="0"
                    VerticalContentAlignment="Stretch"
                    Style="{StaticResource FlatButtonStyle}"
                    Click="QuickSettingsButton_Click"
                    ContextRequested="QuickSettingsButton_ContextRequested"
                    PointerWheelChanged="Volume_PointerWheelChanged">
                    <Grid>
                        <!-- While Quick Settings is open the button keeps its hover plate, as Explorer's does. -->
                        <Border
                            x:Name="QuickSettingsOpenPlate"
                            CornerRadius="4"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Visibility="Collapsed" />
                        <StackPanel Margin="4,0" Orientation="Horizontal" Spacing="4">
                            <Grid x:Name="NetworkIndicator" Width="24" Height="40" Background="Transparent" AutomationProperties.AutomationId="NetworkIndicator">
                                <!-- Explorer's menus on the network and speaker icons; the button's flyout is Quick Settings. -->
                                <FontIcon x:Name="NetworkIcon" FontSize="16">
                                    <FlyoutBase.AttachedFlyout>
                                        <!-- Explorer's items, glyphs and separators. -->
                                        <MenuFlyout x:Name="NetworkMenu" MenuFlyoutPresenterStyle="{StaticResource ShellMenuPresenterStyle}">
                                            <MenuFlyoutItem
                                                AutomationProperties.AutomationId="DiagnoseNetworkMenuItem"
                                                Text="Diagnose network problems"
                                                Click="DiagnoseNetwork_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE90F;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem
                                                AutomationProperties.AutomationId="SpeedTestMenuItem"
                                                Text="Perform speed test"
                                                Click="SpeedTest_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xF42F;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem
                                                AutomationProperties.AutomationId="NetworkSettingsMenuItem"
                                                Text="Network and Internet settings"
                                                Click="NetworkSettings_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE713;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </FlyoutBase.AttachedFlyout>
                                </FontIcon>
                            </Grid>
                            <Grid x:Name="VolumeIndicator" Width="24" Height="40" Background="Transparent" AutomationProperties.AutomationId="VolumeIndicator">
                                <FontIcon x:Name="VolumeIcon" FontSize="16">
                                    <FlyoutBase.AttachedFlyout>
                                        <!-- Explorer's items, glyphs and separator: the first has no glyph. -->
                                        <MenuFlyout x:Name="VolumeMenu" MenuFlyoutPresenterStyle="{StaticResource ShellMenuPresenterStyle}">
                                            <MenuFlyoutItem
                                                AutomationProperties.AutomationId="TroubleshootSoundMenuItem"
                                                Text="Troubleshoot sound problems"
                                                Click="TroubleshootSound_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem
                                                AutomationProperties.AutomationId="VolumeMixerMenuItem"
                                                Text="Open volume mixer"
                                                Click="OpenVolumeMixer_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE713;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem
                                                AutomationProperties.AutomationId="SoundSettingsMenuItem"
                                                Text="Sound settings"
                                                Click="SoundSettings_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE713;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </FlyoutBase.AttachedFlyout>
                                </FontIcon>
                            </Grid>
                            <Grid
                                x:Name="BatteryIndicator"
                                Width="24"
                                Height="40"
                                Background="Transparent"
                                Visibility="Collapsed"
                                AutomationProperties.AutomationId="BatteryIndicator">
                                <FontIcon x:Name="BatteryIcon" FontSize="16" />
                            </Grid>
                            <!-- Energy saver's leaf, while it's on and there's no battery icon to show it. -->
                            <Grid
                                x:Name="EnergySaverIndicator"
                                Width="24"
                                Height="40"
                                Background="Transparent"
                                Visibility="Collapsed"
                                AutomationProperties.AutomationId="EnergySaverIndicator"
                                AutomationProperties.Name="Energy saver is on"
                                ToolTipService.ToolTip="Energy saver is on">
                                <FontIcon Glyph="&#xEC0A;" FontSize="16" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <FlyoutBase.AttachedFlyout>
                        <Flyout x:Name="QuickSettingsFlyout" Opening="QuickSettingsFlyout_Opening" Opened="QuickSettingsFlyout_Opened" Closed="QuickSettingsFlyout_Closed">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MaxWidth" Value="400" />
                                    <Setter Property="MaxHeight" Value="800" />
                                    <!-- Windows' panel border (ControlCenterPanelBorderBrush). -->
                                    <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
                                    <!-- The flyout's own backdrop shows through (SetTheme). -->
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <qs:QuickSettingsPanel x:Name="QuickSettings" />
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </Button>
            </StackPanel>
            <!-- Right against the indicators and Show desktop, as on the Windows 11 taskbar. -->
            <local:Clock x:Name="Clock" VerticalAlignment="Center" ContextRequested="Clock_ContextRequested">
                <FlyoutBase.AttachedFlyout>
                    <MenuFlyout x:Name="ClockMenu" MenuFlyoutPresenterStyle="{StaticResource ShellMenuPresenterStyle}">
                        <MenuFlyoutItem
                            AutomationProperties.AutomationId="DateTimeSettingsMenuItem"
                            Text="Adjust date and time"
                            Click="DateTimeSettings_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE713;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            AutomationProperties.AutomationId="NotificationSettingsMenuItem"
                            Text="Notifications settings"
                            Click="NotificationSettings_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE713;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </FlyoutBase.AttachedFlyout>
            </local:Clock>
            <Button
                x:Name="ShowDesktopButton"
                AutomationProperties.AutomationId="ShowDesktopButton"
                AutomationProperties.Name="Show desktop"
                ToolTipService.ToolTip="Show desktop"
                Width="12"
                Height="48"
                Padding="0"
                CornerRadius="0"
                BorderThickness="1,0,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Click="ShowDesktopButton_Click" />
        </StackPanel>

        <!--
            A tray icon being dragged: the icon at the pointer's top left, and above it a caption saying what a drop does.
            Windowed, so they go over the overflow and the desktop. Neither takes the pointer.
        -->
        <Popup
            x:Name="TrayDragPopup"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            ShouldConstrainToRootBounds="False"
            IsHitTestVisible="False">
            <Canvas Width="30" Height="58" IsHitTestVisible="False">
                <Border
                    x:Name="TrayDragCaptionBox"
                    Width="30"
                    Height="30"
                    CornerRadius="4"
                    Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}">
                    <FontIcon x:Name="TrayDragGlyph" FontSize="16" />
                </Border>
                <Image x:Name="TrayDragImage" Canvas.Left="7" Canvas.Top="42" Width="16" Height="16" />
            </Canvas>
        </Popup>
        <!-- Where a dragged tray icon would go: a line between two icons. -->
        <Popup
            x:Name="TrayDropMarkerPopup"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            ShouldConstrainToRootBounds="False"
            IsHitTestVisible="False">
            <Rectangle Width="1" Height="36" Fill="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
        </Popup>

        <FlyoutBase.AttachedFlyout>
            <!-- Opened at the pointer by Root_ContextRequested (TaskbarFlyouts). -->
            <MenuFlyout x:Name="TaskbarMenu" Opening="TaskbarMenu_Opening" MenuFlyoutPresenterStyle="{StaticResource ShellMenuPresenterStyle}">
                <!-- No icons: next to the toggles' check column, an icon column pushes every label far right. -->
                <MenuFlyoutItem
                    AutomationProperties.AutomationId="TaskManagerMenuItem"
                    Text="Task Manager"
                    Click="TaskManager_Click" />
                <MenuFlyoutSeparator />
                <RadioMenuFlyoutItem
                    x:Name="AlignCenterItem"
                    AutomationProperties.AutomationId="AlignCenterMenuItem"
                    GroupName="Alignment"
                    Text="Center taskbar items"
                    Click="Alignment_Click" />
                <RadioMenuFlyoutItem
                    x:Name="AlignLeftItem"
                    AutomationProperties.AutomationId="AlignLeftMenuItem"
                    GroupName="Alignment"
                    Text="Left-align taskbar items"
                    Click="Alignment_Click" />
                <!-- Settings' choices, in its order. -->
                <MenuFlyoutSubItem AutomationProperties.AutomationId="SearchMenuItem" Text="Search">
                    <RadioMenuFlyoutItem
                        x:Name="SearchHiddenItem"
                        AutomationProperties.AutomationId="SearchHiddenMenuItem"
                        GroupName="Search"
                        Text="Hide"
                        Click="Search_Click" />
                    <RadioMenuFlyoutItem
                        x:Name="SearchIconItem"
                        AutomationProperties.AutomationId="SearchIconMenuItem"
                        GroupName="Search"
                        Text="Search icon only"
                        Click="Search_Click" />
                    <RadioMenuFlyoutItem
                        x:Name="SearchIconAndLabelItem"
                        AutomationProperties.AutomationId="SearchIconAndLabelMenuItem"
                        GroupName="Search"
                        Text="Search icon and label"
                        Click="Search_Click" />
                    <RadioMenuFlyoutItem
                        x:Name="SearchBoxItem"
                        AutomationProperties.AutomationId="SearchBoxMenuItem"
                        GroupName="Search"
                        Text="Search box"
                        Click="Search_Click" />
                </MenuFlyoutSubItem>
                <ToggleMenuFlyoutItem
                    x:Name="ShowWidgetsItem"
                    AutomationProperties.AutomationId="ShowWidgetsMenuItem"
                    Text="Show widgets"
                    Click="ShowWidgets_Click" />
                <MenuFlyoutSubItem AutomationProperties.AutomationId="CombineMenuItem" Text="Combine taskbar buttons">
                    <RadioMenuFlyoutItem
                        x:Name="CombineAlwaysItem"
                        AutomationProperties.AutomationId="CombineAlwaysMenuItem"
                        GroupName="Combine"
                        Text="Always"
                        Click="Combine_Click" />
                    <RadioMenuFlyoutItem
                        x:Name="CombineWhenFullItem"
                        AutomationProperties.AutomationId="CombineWhenFullMenuItem"
                        GroupName="Combine"
                        Text="When taskbar is full"
                        Click="Combine_Click" />
                    <RadioMenuFlyoutItem
                        x:Name="CombineNeverItem"
                        AutomationProperties.AutomationId="CombineNeverMenuItem"
                        GroupName="Combine"
                        Text="Never"
                        Click="Combine_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem AutomationProperties.AutomationId="BackdropMenuItem" Text="Taskbar backdrop">
                    <RadioMenuFlyoutItem
                        x:Name="BackdropAcrylicItem"
                        AutomationProperties.AutomationId="BackdropAcrylicMenuItem"
                        GroupName="Backdrop"
                        Text="Acrylic"
                        Click="Backdrop_Click" />
                    <RadioMenuFlyoutItem
                        x:Name="BackdropMicaItem"
                        AutomationProperties.AutomationId="BackdropMicaMenuItem"
                        GroupName="Backdrop"
                        Text="Mica"
                        Click="Backdrop_Click" />
                    <RadioMenuFlyoutItem
                        x:Name="BackdropTranslucentItem"
                        AutomationProperties.AutomationId="BackdropTranslucentMenuItem"
                        GroupName="Backdrop"
                        Text="Translucent"
                        Click="Backdrop_Click" />
                    <RadioMenuFlyoutItem
                        x:Name="BackdropTransparentItem"
                        AutomationProperties.AutomationId="BackdropTransparentMenuItem"
                        GroupName="Backdrop"
                        Text="Transparent"
                        Click="Backdrop_Click" />
                </MenuFlyoutSubItem>
                <ToggleMenuFlyoutItem
                    x:Name="AutoHideItem"
                    AutomationProperties.AutomationId="AutoHideMenuItem"
                    Text="Automatically hide the taskbar"
                    Click="AutoHide_Click" />
                <ToggleMenuFlyoutItem
                    x:Name="HiddenIconMenuItem"
                    AutomationProperties.AutomationId="HiddenIconMenuMenuItem"
                    Text="Show hidden icon menu"
                    Click="HiddenIconMenu_Click" />
                <ToggleMenuFlyoutItem
                    x:Name="AllDisplaysItem"
                    AutomationProperties.AutomationId="AllDisplaysMenuItem"
                    Text="Show taskbar on all displays"
                    Click="AllDisplays_Click" />
                <MenuFlyoutSeparator />
                <!-- NeoShell's own settings, until it has a settings window. -->
                <MenuFlyoutItem
                    AutomationProperties.AutomationId="WindowFramesMenuItem"
                    Text="Window frames..."
                    Click="WindowFrames_Click" />
                <MenuFlyoutSeparator x:Name="ExitSeparator" />
                <MenuFlyoutItem
                    x:Name="ExitItem"
                    AutomationProperties.AutomationId="ExitMenuItem"
                    Text="Exit NeoShell"
                    Click="Exit_Click" />
            </MenuFlyout>
        </FlyoutBase.AttachedFlyout>
    </Grid>
</Window>
