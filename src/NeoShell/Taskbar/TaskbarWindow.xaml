<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NeoShell.Taskbar.TaskbarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoShell.Taskbar"
    xmlns:tray="using:NeoShell.Tray">

    <!-- Transparent, not null: the background must take right-clicks for the context menu. -->
    <Grid x:Name="Root" Background="Transparent">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///FlatButtons.xaml" />
                </ResourceDictionary.MergedDictionaries>

                <!-- A tray icon: every mouse action goes to the icon's app. -->
                <DataTemplate x:Key="TrayIconTemplate" x:DataType="tray:TrayIcon">
                    <Grid
                        Width="28"
                        Height="40"
                        Background="Transparent"
                        AutomationProperties.AutomationId="TrayIcon"
                        AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}"
                        PointerPressed="TrayIcon_PointerPressed"
                        PointerReleased="TrayIcon_PointerReleased"
                        PointerMoved="TrayIcon_PointerMoved"
                        PointerEntered="TrayIcon_PointerEntered"
                        PointerExited="TrayIcon_PointerExited"
                        ContextRequested="TrayIcon_ContextRequested">
                        <Border CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Opacity="0" />
                        <Image Width="16" Height="16" Source="{x:Bind Icon, Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Spans both columns so "centred" means the middle of the screen, as in Windows 11. -->
        <StackPanel
            x:Name="AppsPanel"
            Grid.ColumnSpan="2"
            Margin="12,0"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Button
                x:Name="StartButton"
                AutomationProperties.AutomationId="StartButton"
                AutomationProperties.Name="Start"
                ToolTipService.ToolTip="Start"
                Style="{StaticResource FlatButtonStyle}"
                Click="StartButton_Click">
                <Grid Width="18" Height="18" ColumnSpacing="1" RowSpacing="1">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Row="0" Grid.Column="0" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Rectangle Grid.Row="0" Grid.Column="1" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Rectangle Grid.Row="1" Grid.Column="0" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Rectangle Grid.Row="1" Grid.Column="1" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                </Grid>
            </Button>
            <Button
                x:Name="SearchButton"
                AutomationProperties.AutomationId="SearchButton"
                AutomationProperties.Name="Search"
                ToolTipService.ToolTip="Search"
                Style="{StaticResource FlatButtonStyle}"
                Click="StartButton_Click">
                <FontIcon Glyph="&#xE721;" FontSize="16" />
            </Button>
            <ListView
                x:Name="TaskList"
                AutomationProperties.AutomationId="TaskList"
                AutomationProperties.Name="Running applications"
                Padding="0"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="TaskList_ItemClick"
                CanDragItems="True"
                CanReorderItems="True"
                AllowDrop="True"
                DragItemsCompleted="TaskList_DragItemsCompleted"
                ScrollViewer.HorizontalScrollMode="Disabled"
                ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                ScrollViewer.VerticalScrollMode="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Height" Value="40" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="2,0" />
                        <Setter Property="CornerRadius" Value="4" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TaskButton">
                        <Grid
                            Width="{x:Bind Width, Mode=OneWay}"
                            Background="Transparent"
                            AutomationProperties.AutomationId="TaskButton"
                            AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}"
                            PointerPressed="TaskItem_PointerPressed"
                            PointerEntered="TaskItem_PointerEntered"
                            PointerExited="TaskItem_PointerExited">
                            <Grid.ContextFlyout>
                                <MenuFlyout ShouldConstrainToRootBounds="False" Opening="TaskMenu_Opening" />
                            </Grid.ContextFlyout>
                            <!-- The window asks for attention. -->
                            <Border
                                CornerRadius="4"
                                Background="{ThemeResource SystemFillColorCautionBrush}"
                                Opacity="0.4"
                                Visibility="{x:Bind FlashVisibility, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="8,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Width="24" Height="24" Source="{x:Bind Icon, Mode=OneWay}" />
                                <TextBlock
                                    Width="108"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    Visibility="{x:Bind LabelVisibility, Mode=OneWay}" />
                            </StackPanel>
                            <!-- Running: short grey pill (two for several windows); active: long accent pill. -->
                            <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1">
                                <Rectangle Width="6" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind RunningVisibility, Mode=OneWay}" />
                                <Rectangle Width="6" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind MultipleVisibility, Mode=OneWay}" />
                                <Rectangle Width="6" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind MultipleVisibility, Mode=OneWay}" />
                                <Rectangle Width="16" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind ActiveVisibility, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <StackPanel x:Name="RightPanel" Grid.Column="1" Orientation="Horizontal">
            <!-- The tray, on the primary taskbar while NeoShell is the shell: all icons, or behind a chevron. -->
            <StackPanel x:Name="TrayArea" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <Button
                    x:Name="OverflowButton"
                    AutomationProperties.AutomationId="TrayOverflowButton"
                    AutomationProperties.Name="Show hidden icons"
                    ToolTipService.ToolTip="Show hidden icons"
                    Width="28"
                    Style="{StaticResource FlatButtonStyle}">
                    <FontIcon Glyph="&#xE70E;" FontSize="12" />
                    <Button.Flyout>
                        <Flyout x:Name="OverflowFlyout" Placement="Top" ShouldConstrainToRootBounds="False">
                            <ItemsControl x:Name="OverflowIcons" ItemTemplate="{StaticResource TrayIconTemplate}" MaxWidth="140">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="5" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <ItemsControl x:Name="TrayIcons" ItemTemplate="{StaticResource TrayIconTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
            <!-- Microphone (while in use), network and volume, on the primary taskbar. -->
            <StackPanel x:Name="IndicatorArea" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <Button
                    x:Name="MicrophoneButton"
                    AutomationProperties.AutomationId="MicrophoneIndicator"
                    Width="32"
                    Style="{StaticResource FlatButtonStyle}"
                    Visibility="Collapsed"
                    Click="Microphone_Click">
                    <FontIcon Glyph="&#xE720;" FontSize="14" />
                </Button>
                <Button
                    x:Name="NetworkButton"
                    AutomationProperties.AutomationId="NetworkIndicator"
                    Width="32"
                    Style="{StaticResource FlatButtonStyle}"
                    Click="Network_Click">
                    <FontIcon x:Name="NetworkIcon" FontSize="14" />
                </Button>
                <Button
                    x:Name="VolumeButton"
                    AutomationProperties.AutomationId="VolumeIndicator"
                    Width="32"
                    Style="{StaticResource FlatButtonStyle}"
                    PointerWheelChanged="Volume_PointerWheelChanged">
                    <FontIcon x:Name="VolumeIcon" FontSize="14" />
                    <Button.Flyout>
                        <Flyout x:Name="VolumeFlyout" Placement="TopEdgeAlignedRight" ShouldConstrainToRootBounds="False" Opening="VolumeFlyout_Opening">
                            <StackPanel Width="300" Spacing="8">
                                <TextBlock x:Name="VolumeDeviceName" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Name="MuteButton"
                                        AutomationProperties.AutomationId="MuteButton"
                                        Width="40"
                                        Height="40"
                                        Padding="0"
                                        Click="Mute_Click">
                                        <FontIcon x:Name="MuteIcon" FontSize="16" />
                                    </Button>
                                    <Slider
                                        x:Name="VolumeSlider"
                                        Grid.Column="1"
                                        AutomationProperties.AutomationId="VolumeSlider"
                                        AutomationProperties.Name="Volume"
                                        Minimum="0"
                                        Maximum="100"
                                        StepFrequency="1"
                                        VerticalAlignment="Center"
                                        ValueChanged="VolumeSlider_ValueChanged" />
                                    <TextBlock x:Name="VolumeText" Grid.Column="2" Width="32" VerticalAlignment="Center" TextAlignment="Right" />
                                </Grid>
                                <HyperlinkButton
                                    AutomationProperties.AutomationId="SoundSettingsLink"
                                    Padding="0"
                                    Content="Sound settings"
                                    Click="SoundSettings_Click" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <local:Clock x:Name="Clock" Margin="4,0" VerticalAlignment="Center" />
            <Button
                x:Name="ShowDesktopButton"
                AutomationProperties.AutomationId="ShowDesktopButton"
                AutomationProperties.Name="Show desktop"
                ToolTipService.ToolTip="Show desktop"
                Width="12"
                Height="48"
                Padding="0"
                CornerRadius="0"
                BorderThickness="1,0,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Click="ShowDesktopButton_Click" />
        </StackPanel>

        <Grid.ContextFlyout>
            <!-- Unconstrained: the window is only as tall as the taskbar. -->
            <MenuFlyout x:Name="TaskbarMenu" ShouldConstrainToRootBounds="False" Opening="TaskbarMenu_Opening">
                <MenuFlyoutItem
                    AutomationProperties.AutomationId="TaskManagerMenuItem"
                    Text="Task Manager"
                    Click="TaskManager_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <RadioMenuFlyoutItem
                    x:Name="AlignCenterItem"
                    AutomationProperties.AutomationId="AlignCenterMenuItem"
                    GroupName="Alignment"
                    Text="Center taskbar items"
                    Click="Alignment_Click" />
                <RadioMenuFlyoutItem
                    x:Name="AlignLeftItem"
                    AutomationProperties.AutomationId="AlignLeftMenuItem"
                    GroupName="Alignment"
                    Text="Left-align taskbar items"
                    Click="Alignment_Click" />
                <MenuFlyoutSubItem AutomationProperties.AutomationId="CombineMenuItem" Text="Combine taskbar buttons">
                    <RadioMenuFlyoutItem
                        x:Name="CombineAlwaysItem"
                        AutomationProperties.AutomationId="CombineAlwaysMenuItem"
                        GroupName="Combine"
                        Text="Always"
                        Click="Combine_Click" />
                    <RadioMenuFlyoutItem
                        x:Name="CombineWhenFullItem"
                        AutomationProperties.AutomationId="CombineWhenFullMenuItem"
                        GroupName="Combine"
                        Text="When taskbar is full"
                        Click="Combine_Click" />
                    <RadioMenuFlyoutItem
                        x:Name="CombineNeverItem"
                        AutomationProperties.AutomationId="CombineNeverMenuItem"
                        GroupName="Combine"
                        Text="Never"
                        Click="Combine_Click" />
                </MenuFlyoutSubItem>
                <ToggleMenuFlyoutItem
                    x:Name="ShowAllTrayIconsItem"
                    AutomationProperties.AutomationId="ShowAllTrayIconsMenuItem"
                    Text="Show all tray icons"
                    Click="ShowAllTrayIcons_Click" />
                <ToggleMenuFlyoutItem
                    x:Name="AllDisplaysItem"
                    AutomationProperties.AutomationId="AllDisplaysMenuItem"
                    Text="Show taskbar on all displays"
                    Click="AllDisplays_Click" />
                <MenuFlyoutSeparator x:Name="ExitSeparator" />
                <MenuFlyoutItem
                    x:Name="ExitItem"
                    AutomationProperties.AutomationId="ExitMenuItem"
                    Text="Exit NeoShell"
                    Click="Exit_Click" />
            </MenuFlyout>
        </Grid.ContextFlyout>
    </Grid>
</Window>
