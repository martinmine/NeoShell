<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NeoShell.Taskbar.TaskbarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoShell.Taskbar"
    xmlns:tray="using:NeoShell.Tray">

    <!-- Transparent, not null: the background must take right-clicks for the context menu. -->
    <Grid x:Name="Root" Background="Transparent" ContextRequested="Root_ContextRequested">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///FlatButtons.xaml" />
                </ResourceDictionary.MergedDictionaries>

                <!-- A jump list's category heading in a task button's menu: text only, not a command. -->
                <Style x:Key="JumpListHeaderStyle" TargetType="MenuFlyoutItem">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuFlyoutItem">
                                <TextBlock
                                    Margin="12,8,12,4"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{TemplateBinding Text}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- A key in a keyboard shortcut. -->
                <Style x:Key="KeyCapStyle" TargetType="Border">
                    <Setter Property="MinWidth" Value="20" />
                    <Setter Property="Height" Value="20" />
                    <Setter Property="Padding" Value="4,0" />
                    <Setter Property="CornerRadius" Value="4" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
                </Style>

                <!-- A tray icon: every mouse action goes to the icon's app. -->
                <DataTemplate x:Key="TrayIconTemplate" x:DataType="tray:TrayIcon">
                    <Grid
                        Width="32"
                        Height="40"
                        Background="Transparent"
                        AutomationProperties.AutomationId="TrayIcon"
                        AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}"
                        PointerPressed="TrayIcon_PointerPressed"
                        PointerReleased="TrayIcon_PointerReleased"
                        PointerMoved="TrayIcon_PointerMoved"
                        PointerEntered="TrayIcon_PointerEntered"
                        PointerExited="TrayIcon_PointerExited"
                        ContextRequested="TrayIcon_ContextRequested">
                        <Border CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Opacity="0" />
                        <Image Width="16" Height="16" Source="{x:Bind Icon, Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Spans both columns so "centred" means the middle of the screen, as in Windows 11. -->
        <StackPanel
            x:Name="AppsPanel"
            Grid.ColumnSpan="2"
            Margin="11,0"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Button
                x:Name="StartButton"
                AutomationProperties.AutomationId="StartButton"
                AutomationProperties.Name="Start"
                ToolTipService.ToolTip="Start"
                Style="{StaticResource FlatButtonStyle}"
                Click="StartButton_Click">
                <!-- Explorer's logo: four 11 px squares. -->
                <Grid Width="23" Height="23" ColumnSpacing="1" RowSpacing="1">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Row="0" Grid.Column="0" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Rectangle Grid.Row="0" Grid.Column="1" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Rectangle Grid.Row="1" Grid.Column="0" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Rectangle Grid.Row="1" Grid.Column="1" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                </Grid>
            </Button>
            <Button
                x:Name="SearchButton"
                AutomationProperties.AutomationId="SearchButton"
                AutomationProperties.Name="Search"
                ToolTipService.ToolTip="Search"
                Style="{StaticResource FlatButtonStyle}"
                Click="StartButton_Click">
                <FontIcon Glyph="&#xE721;" FontSize="16" />
            </Button>
            <ListView
                x:Name="TaskList"
                AutomationProperties.AutomationId="TaskList"
                AutomationProperties.Name="Running applications"
                Padding="0"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="TaskList_ItemClick"
                ScrollViewer.HorizontalScrollMode="Disabled"
                ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                ScrollViewer.VerticalScrollMode="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <!-- None: a moved button would be animated as removed and added again. The window animates changes. -->
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Height" Value="48" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="UseSystemFocusVisuals" Value="True" />
                        <!-- Just the content: the default presenter insets its hover plate, smaller than Explorer's. -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TaskButton">
                        <Grid
                            Width="{x:Bind Width, Mode=OneWay}"
                            Background="Transparent"
                            AutomationProperties.AutomationId="TaskButton"
                            AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                            PointerPressed="TaskItem_PointerPressed"
                            PointerEntered="TaskItem_PointerEntered"
                            PointerExited="TaskItem_PointerExited"
                            ContextRequested="TaskItem_ContextRequested">
                            <!-- Not a ContextFlyout: WinUI would open that at the pointer itself (TaskItem_ContextRequested). -->
                            <FlyoutBase.AttachedFlyout>
                                <MenuFlyout Opening="TaskMenu_Opening" />
                            </FlyoutBase.AttachedFlyout>
                            <!-- Plates as in Explorer: 40x40 behind the active app, lighter while hovered; with several
                                 windows, the edge of a second card shows on the right. -->
                            <Grid Margin="2,4" ColumnSpacing="2" Visibility="{x:Bind ActiveVisibility, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    CornerRadius="4"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1" />
                                <Border
                                    Grid.Column="1"
                                    Width="3"
                                    Margin="0,1"
                                    CornerRadius="0,4,4,0"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    Visibility="{x:Bind StackVisibility, Mode=OneWay}" />
                            </Grid>
                            <Grid Margin="2,4" ColumnSpacing="2" Visibility="{x:Bind HoverVisibility, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                <Border
                                    Grid.Column="1"
                                    Width="3"
                                    Margin="0,1"
                                    CornerRadius="0,4,4,0"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Visibility="{x:Bind StackVisibility, Mode=OneWay}" />
                            </Grid>
                            <!-- The window asks for attention. -->
                            <Border
                                Margin="2,4"
                                CornerRadius="4"
                                Background="{ThemeResource SystemFillColorCautionBrush}"
                                Opacity="0.4"
                                Visibility="{x:Bind FlashVisibility, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="8,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Shrinks while pressed and grows while dragged (IconPress). -->
                                <Grid x:Name="TaskIcon" Width="24" Height="24">
                                    <Image Source="{x:Bind Icon, Mode=OneWay}" />
                                    <!-- The app's overlay badge, over the icon's bottom-right corner. -->
                                    <Image
                                        Width="14"
                                        Height="14"
                                        Margin="0,0,-4,-4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Source="{x:Bind Overlay, Mode=OneWay}"
                                        Visibility="{x:Bind OverlayVisibility, Mode=OneWay}" />
                                </Grid>
                                <TextBlock
                                    Width="108"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    Visibility="{x:Bind LabelVisibility, Mode=OneWay}" />
                            </StackPanel>
                            <!-- The app's progress, along the bottom of the button. -->
                            <ProgressBar
                                Margin="8,0,8,9"
                                VerticalAlignment="Bottom"
                                MinHeight="3"
                                Height="3"
                                Maximum="100"
                                Value="{x:Bind ProgressPercent, Mode=OneWay}"
                                IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}"
                                ShowError="{x:Bind IsProgressError, Mode=OneWay}"
                                ShowPaused="{x:Bind IsProgressPaused, Mode=OneWay}"
                                Visibility="{x:Bind ProgressVisibility, Mode=OneWay}"
                                AutomationProperties.AutomationId="TaskProgress" />
                            <!-- Running: short grey pill; active: long accent pill. -->
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5">
                                <Rectangle Width="6" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind RunningVisibility, Mode=OneWay}" />
                                <Rectangle Width="16" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind ActiveVisibility, Mode=OneWay}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <StackPanel x:Name="RightPanel" Grid.Column="1" Orientation="Horizontal">
            <!-- The tray, on the primary taskbar while NeoShell is the shell: all icons, or behind a chevron. -->
            <StackPanel x:Name="TrayArea" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <Button
                    x:Name="OverflowButton"
                    AutomationProperties.AutomationId="TrayOverflowButton"
                    AutomationProperties.Name="Show hidden icons"
                    ToolTipService.ToolTip="Show hidden icons"
                    Width="32"
                    Style="{StaticResource FlatButtonStyle}"
                    Click="OverflowButton_Click">
                    <FontIcon Glyph="&#xE70E;" FontSize="12" />
                    <FlyoutBase.AttachedFlyout>
                        <Flyout x:Name="OverflowFlyout">
                            <ItemsControl x:Name="OverflowIcons" ItemTemplate="{StaticResource TrayIconTemplate}" MaxWidth="140">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="5" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </Button>
                <ItemsControl x:Name="TrayIcons" ItemTemplate="{StaticResource TrayIconTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
            <!-- Microphone (while in use), network and volume, on the primary taskbar. -->
            <StackPanel x:Name="IndicatorArea" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <Button
                    x:Name="MicrophoneButton"
                    AutomationProperties.AutomationId="MicrophoneIndicator"
                    Width="32"
                    Style="{StaticResource FlatButtonStyle}"
                    Visibility="Collapsed"
                    Click="Microphone_Click">
                    <FontIcon Glyph="&#xE720;" FontSize="16" />
                </Button>
                <Button
                    x:Name="NetworkButton"
                    AutomationProperties.AutomationId="NetworkIndicator"
                    Width="32"
                    Style="{StaticResource FlatButtonStyle}"
                    Click="Network_Click">
                    <FontIcon x:Name="NetworkIcon" FontSize="16" />
                </Button>
                <Button
                    x:Name="VolumeButton"
                    AutomationProperties.AutomationId="VolumeIndicator"
                    Width="32"
                    Style="{StaticResource FlatButtonStyle}"
                    Click="VolumeButton_Click"
                    ContextRequested="VolumeButton_ContextRequested"
                    PointerWheelChanged="Volume_PointerWheelChanged">
                    <!-- Explorer's menu on the speaker icon, attached to the icon: the button's is the volume flyout. -->
                    <FontIcon x:Name="VolumeIcon" FontSize="16">
                        <FlyoutBase.AttachedFlyout>
                            <MenuFlyout x:Name="VolumeMenu">
                            <MenuFlyoutItem
                                AutomationProperties.AutomationId="VolumeMixerMenuItem"
                                Text="Open volume mixer"
                                Click="OpenVolumeMixer_Click" />
                            <MenuFlyoutItem
                                AutomationProperties.AutomationId="SoundSettingsMenuItem"
                                Text="Sound settings"
                                Click="SoundSettings_Click" />
                            </MenuFlyout>
                        </FlyoutBase.AttachedFlyout>
                    </FontIcon>
                    <!-- As Quick Settings' volume: the slider, and behind its button the Sound output page. -->
                    <FlyoutBase.AttachedFlyout>
                        <Flyout x:Name="VolumeFlyout" Opening="VolumeFlyout_Opening" Closed="VolumeFlyout_Closed">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MaxWidth" Value="400" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <Grid Width="360">
                                <Grid x:Name="VolumePage" Padding="12,16" ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Name="MuteButton"
                                        AutomationProperties.AutomationId="MuteButton"
                                        Style="{StaticResource FlatButtonStyle}"
                                        Click="Mute_Click">
                                        <FontIcon x:Name="MuteIcon" FontSize="16" />
                                    </Button>
                                    <Slider
                                        x:Name="VolumeSlider"
                                        Grid.Column="1"
                                        Margin="4,0"
                                        AutomationProperties.AutomationId="VolumeSlider"
                                        AutomationProperties.Name="Volume"
                                        Minimum="0"
                                        Maximum="100"
                                        StepFrequency="1"
                                        VerticalAlignment="Center"
                                        ValueChanged="VolumeSlider_ValueChanged" />
                                    <Button
                                        x:Name="SoundOutputButton"
                                        Grid.Column="2"
                                        AutomationProperties.AutomationId="SoundOutputButton"
                                        AutomationProperties.Name="Select a sound output"
                                        ToolTipService.ToolTip="Select a sound output"
                                        Style="{StaticResource FlatButtonStyle}"
                                        Width="Auto"
                                        Padding="8,0"
                                        Click="SoundOutputButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xF4C3;" FontSize="16" />
                                            <FontIcon Glyph="&#xE76C;" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid x:Name="SoundOutputPage" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Padding="8,8,12,4" Orientation="Horizontal" Spacing="8">
                                        <Button
                                            AutomationProperties.AutomationId="SoundOutputBackButton"
                                            AutomationProperties.Name="Back"
                                            Style="{StaticResource FlatButtonStyle}"
                                            Width="32"
                                            Height="32"
                                            Click="SoundOutputBack_Click">
                                            <FontIcon Glyph="&#xE72B;" FontSize="14" />
                                        </Button>
                                        <TextBlock VerticalAlignment="Center" Text="Sound output" />
                                        <!-- The shortcut that opens this page: Win+Ctrl+V. -->
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Border Style="{StaticResource KeyCapStyle}">
                                                <!-- The Windows key's logo: four squares, as on the Start button. -->
                                                <Grid Width="9" Height="9" ColumnSpacing="1" RowSpacing="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition />
                                                        <RowDefinition />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Grid.Row="0" Grid.Column="0" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    <Rectangle Grid.Row="0" Grid.Column="1" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    <Rectangle Grid.Row="1" Grid.Column="0" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    <Rectangle Grid.Row="1" Grid.Column="1" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource KeyCapStyle}">
                                                <TextBlock FontSize="10" Text="CTRL" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border Style="{StaticResource KeyCapStyle}">
                                                <TextBlock FontSize="10" Text="V" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="1" MaxHeight="440" Padding="12,0,12,8" VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Margin="4,8,0,8" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Output device" />
                                            <ListView
                                                x:Name="OutputDevices"
                                                AutomationProperties.AutomationId="OutputDeviceList"
                                                AutomationProperties.Name="Output device"
                                                SelectionMode="Single"
                                                SelectionChanged="OutputDevices_SelectionChanged" />
                                            <StackPanel x:Name="SpatialSection">
                                                <Rectangle Height="1" Margin="0,8" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                                <TextBlock Margin="4,8,0,8" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Spatial sound" />
                                                <ListView
                                                    x:Name="SpatialFormats"
                                                    AutomationProperties.AutomationId="SpatialSoundList"
                                                    AutomationProperties.Name="Spatial sound"
                                                    SelectionMode="Single"
                                                    SelectionChanged="SpatialFormats_SelectionChanged" />
                                            </StackPanel>
                                            <Rectangle Height="1" Margin="0,8" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                            <Grid Margin="4,4,0,4">
                                                <TextBlock VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Volume mixer" />
                                                <Button
                                                    HorizontalAlignment="Right"
                                                    AutomationProperties.AutomationId="VolumeMixerSettingsButton"
                                                    AutomationProperties.Name="Volume mixer settings"
                                                    ToolTipService.ToolTip="Volume mixer settings"
                                                    Style="{StaticResource FlatButtonStyle}"
                                                    Width="32"
                                                    Height="32"
                                                    Click="OpenVolumeMixer_Click">
                                                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                                                </Button>
                                            </Grid>
                                            <!-- Each app playing sound: its icon mutes it, the slider sets its volume. -->
                                            <ItemsControl
                                                x:Name="MixerList"
                                                AutomationProperties.AutomationId="VolumeMixer"
                                                AutomationProperties.Name="Volume mixer">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="tray:MixerApp">
                                                        <Grid ColumnSpacing="4" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition />
                                                            </Grid.ColumnDefinitions>
                                                            <Button
                                                                Width="40"
                                                                Height="40"
                                                                Padding="0"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                AutomationProperties.AutomationId="MixerMuteButton"
                                                                AutomationProperties.Name="{x:Bind MuteName, Mode=OneWay}"
                                                                ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}"
                                                                Click="MixerMute_Click">
                                                                <Grid Width="20" Height="20">
                                                                    <Image Source="{x:Bind Icon, Mode=OneWay}" Visibility="{x:Bind IconVisibility, Mode=OneWay}" />
                                                                    <FontIcon Glyph="&#xE7F5;" FontSize="16" Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                                                                    <!-- Muted: a crossed-out speaker over the icon's corner. -->
                                                                    <Border
                                                                        Margin="0,0,-5,-5"
                                                                        Padding="1"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Bottom"
                                                                        CornerRadius="4"
                                                                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                                        Visibility="{x:Bind MutedVisibility, Mode=OneWay}">
                                                                        <FontIcon Glyph="&#xE74F;" FontSize="9" />
                                                                    </Border>
                                                                </Grid>
                                                            </Button>
                                                            <Slider
                                                                Grid.Column="1"
                                                                Margin="4,0"
                                                                VerticalAlignment="Center"
                                                                AutomationProperties.AutomationId="MixerSlider"
                                                                AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                                                Minimum="0"
                                                                Maximum="100"
                                                                StepFrequency="1"
                                                                Value="{x:Bind Volume, Mode=TwoWay}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock
                                                x:Name="NoMixerAppsText"
                                                Margin="4,4,0,8"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="No apps are playing sound" />
                                        </StackPanel>
                                    </ScrollViewer>
                                    <Border
                                        Grid.Row="2"
                                        Padding="8,6"
                                        Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,1,0,0">
                                        <Button
                                            AutomationProperties.AutomationId="MoreVolumeSettingsButton"
                                            Padding="8,6"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Content="More volume settings"
                                            Click="SoundSettings_Click" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </Button>
            </StackPanel>
            <local:Clock x:Name="Clock" Margin="4,0" VerticalAlignment="Center" />
            <Button
                x:Name="ShowDesktopButton"
                AutomationProperties.AutomationId="ShowDesktopButton"
                AutomationProperties.Name="Show desktop"
                ToolTipService.ToolTip="Show desktop"
                Width="12"
                Height="48"
                Padding="0"
                CornerRadius="0"
                BorderThickness="1,0,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Click="ShowDesktopButton_Click" />
        </StackPanel>

        <FlyoutBase.AttachedFlyout>
            <!-- Opened above the taskbar by Root_ContextRequested (TaskbarFlyouts). -->
            <MenuFlyout x:Name="TaskbarMenu" Opening="TaskbarMenu_Opening">
                <!-- No icons: next to the toggles' check column, an icon column pushes every label far right. -->
                <MenuFlyoutItem
                    AutomationProperties.AutomationId="TaskManagerMenuItem"
                    Text="Task Manager"
                    Click="TaskManager_Click" />
                <MenuFlyoutSeparator />
                <RadioMenuFlyoutItem
                    x:Name="AlignCenterItem"
                    AutomationProperties.AutomationId="AlignCenterMenuItem"
                    GroupName="Alignment"
                    Text="Center taskbar items"
                    Click="Alignment_Click" />
                <RadioMenuFlyoutItem
                    x:Name="AlignLeftItem"
                    AutomationProperties.AutomationId="AlignLeftMenuItem"
                    GroupName="Alignment"
                    Text="Left-align taskbar items"
                    Click="Alignment_Click" />
                <ToggleMenuFlyoutItem
                    x:Name="ShowSearchItem"
                    AutomationProperties.AutomationId="ShowSearchMenuItem"
                    Text="Show search button"
                    Click="ShowSearch_Click" />
                <MenuFlyoutSubItem AutomationProperties.AutomationId="CombineMenuItem" Text="Combine taskbar buttons">
                    <RadioMenuFlyoutItem
                        x:Name="CombineAlwaysItem"
                        AutomationProperties.AutomationId="CombineAlwaysMenuItem"
                        GroupName="Combine"
                        Text="Always"
                        Click="Combine_Click" />
                    <RadioMenuFlyoutItem
                        x:Name="CombineWhenFullItem"
                        AutomationProperties.AutomationId="CombineWhenFullMenuItem"
                        GroupName="Combine"
                        Text="When taskbar is full"
                        Click="Combine_Click" />
                    <RadioMenuFlyoutItem
                        x:Name="CombineNeverItem"
                        AutomationProperties.AutomationId="CombineNeverMenuItem"
                        GroupName="Combine"
                        Text="Never"
                        Click="Combine_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem AutomationProperties.AutomationId="BackdropMenuItem" Text="Taskbar backdrop">
                    <RadioMenuFlyoutItem
                        x:Name="BackdropAcrylicItem"
                        AutomationProperties.AutomationId="BackdropAcrylicMenuItem"
                        GroupName="Backdrop"
                        Text="Acrylic"
                        Click="Backdrop_Click" />
                    <RadioMenuFlyoutItem
                        x:Name="BackdropMicaItem"
                        AutomationProperties.AutomationId="BackdropMicaMenuItem"
                        GroupName="Backdrop"
                        Text="Mica"
                        Click="Backdrop_Click" />
                    <RadioMenuFlyoutItem
                        x:Name="BackdropTranslucentItem"
                        AutomationProperties.AutomationId="BackdropTranslucentMenuItem"
                        GroupName="Backdrop"
                        Text="Translucent"
                        Click="Backdrop_Click" />
                </MenuFlyoutSubItem>
                <ToggleMenuFlyoutItem
                    x:Name="AutoHideItem"
                    AutomationProperties.AutomationId="AutoHideMenuItem"
                    Text="Automatically hide the taskbar"
                    Click="AutoHide_Click" />
                <ToggleMenuFlyoutItem
                    x:Name="ShowAllTrayIconsItem"
                    AutomationProperties.AutomationId="ShowAllTrayIconsMenuItem"
                    Text="Show all tray icons"
                    Click="ShowAllTrayIcons_Click" />
                <ToggleMenuFlyoutItem
                    x:Name="AllDisplaysItem"
                    AutomationProperties.AutomationId="AllDisplaysMenuItem"
                    Text="Show taskbar on all displays"
                    Click="AllDisplays_Click" />
                <MenuFlyoutSeparator x:Name="ExitSeparator" />
                <MenuFlyoutItem
                    x:Name="ExitItem"
                    AutomationProperties.AutomationId="ExitMenuItem"
                    Text="Exit NeoShell"
                    Click="Exit_Click" />
            </MenuFlyout>
        </FlyoutBase.AttachedFlyout>
    </Grid>
</Window>
