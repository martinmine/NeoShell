<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.cs owns Main: single instance and /exit are handled before WinUI starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeoShell.Interop\NeoShell.Interop.csproj" />
    <!-- The frame styles' model and rules, which NeoShell.Frames.exe reads from the same settings; its .exe is copied
         next to NeoShell's, where the logon task runs it from. -->
    <ProjectReference Include="..\NeoShell.Frames\NeoShell.Frames.csproj" />
  </ItemGroup>

</Project>
