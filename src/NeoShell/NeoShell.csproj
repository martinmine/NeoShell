<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.cs owns Main: single instance and /exit are handled before WinUI starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeoShell.Interop\NeoShell.Interop.csproj" />
  </ItemGroup>

  <!--
    Explorer's battery font (SystemTray's SysBatt Fluent Icons), taken from this PC's Windows: WinUI loads fonts only
    from the app's own folder (ms-appx), not from Windows'. Without it the battery shows Segoe Fluent Icons' glyphs.
  -->
  <PropertyGroup>
    <BatteryFont>$(WinDir)\SystemApps\MicrosoftWindows.Client.Core_cw5n1h2txyewy\SystemTray\Assets\Sysbatt.ttf</BatteryFont>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(BatteryFont)" Link="Assets\Sysbatt.ttf" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(BatteryFont)')" />
  </ItemGroup>

</Project>
