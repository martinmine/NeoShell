<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NeoShell.StartMenu.StartMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoShell.StartMenu">

    <Grid x:Name="Root">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///FlatButtons.xaml" />
                </ResourceDictionary.MergedDictionaries>

                <!--
                    A pinned app, or a folder of them: a plate with its first four apps' icons, two by two, as Explorer
                    draws it (40 square with its edge, the icons 16 with 2 between). An app shows the plate too, its icon shrinking into
                    the plate's first place, while another app is held over it to make a folder.
                -->
                <DataTemplate x:Key="PinTemplate" x:DataType="local:StartItem">
                    <StackPanel
                        Width="96"
                        Height="84"
                        Padding="4,12,4,4"
                        Spacing="4"
                        Background="Transparent"
                        AutomationProperties.AutomationId="{x:Bind AutomationId}"
                        AutomationProperties.Name="{x:Bind Title}">
                        <StackPanel.ContextFlyout>
                            <MenuFlyout Opening="PinMenu_Opening" />
                        </StackPanel.ContextFlyout>
                        <Grid x:Name="ItemIcon" Width="32" Height="32">
                            <Border
                                x:Name="FolderPlate"
                                Margin="-4"
                                Padding="2,3,2,0"
                                CornerRadius="4"
                                BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Opacity="{x:Bind PlateOpacity}">
                                <ItemsControl Margin="0,0,-2,-2" ItemsSource="{x:Bind MiniApps}" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" ItemWidth="18" ItemHeight="18" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:StartItem">
                                            <Image Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Source="{x:Bind Icon, Mode=OneWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <Image x:Name="AppIcon" Source="{x:Bind Icon, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            x:Name="ItemLabel"
                            Text="{x:Bind Title}"
                            FontSize="12"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            MaxLines="2"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>

                <!-- A row in All apps and in search results. -->
                <DataTemplate x:Key="ListItemTemplate" x:DataType="local:StartItem">
                    <Grid
                        Padding="4,6"
                        ColumnSpacing="12"
                        Background="Transparent"
                        AutomationProperties.AutomationId="StartListItem"
                        AutomationProperties.Name="{x:Bind Title}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.ContextFlyout>
                            <MenuFlyout Opening="ResultMenu_Opening" />
                        </Grid.ContextFlyout>
                        <Image Width="24" Height="24" Source="{x:Bind Icon, Mode=OneWay}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind Subtitle}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>

                <!--
                    An app of All apps as a tile (Grid view, an open category): as Explorer's, its name below the icon, on
                    one line above "New" (accent) or "System" and on two otherwise.
                -->
                <DataTemplate x:Key="AppTileTemplate" x:DataType="local:StartItem">
                    <Button
                        Width="96"
                        Height="84"
                        Margin="0"
                        Padding="2,12,2,0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Top"
                        AutomationProperties.AutomationId="AllAppsTile"
                        AutomationProperties.Name="{x:Bind Title}"
                        Click="AllAppsItem_Click">
                        <Button.ContextFlyout>
                            <MenuFlyout Opening="ItemMenu_Opening" />
                        </Button.ContextFlyout>
                        <StackPanel>
                            <Image x:Name="ItemIcon" Width="32" Height="32" Margin="0,0,0,4" Source="{x:Bind Icon, Mode=OneWay}" />
                            <TextBlock
                                Text="{x:Bind Title}"
                                FontSize="12"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                MaxLines="{x:Bind NameLines}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="New"
                                FontSize="12"
                                TextAlignment="Center"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Visibility="{x:Bind NewVisibility}" />
                            <TextBlock
                                Text="System"
                                FontSize="12"
                                TextAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind SystemVisibility}" />
                        </StackPanel>
                    </Button>
                </DataTemplate>

                <!-- An app of All apps as a row (List view): Explorer's 40 tall rows, the icon 12 in, the name 20 after it. -->
                <DataTemplate x:Key="AppRowTemplate" x:DataType="local:StartItem">
                    <Button
                        Height="40"
                        Margin="0"
                        Padding="12,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        AutomationProperties.AutomationId="AllAppsRow"
                        AutomationProperties.Name="{x:Bind Title}"
                        Click="AllAppsItem_Click">
                        <Button.ContextFlyout>
                            <MenuFlyout Opening="ItemMenu_Opening" />
                        </Button.ContextFlyout>
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <Image x:Name="ItemIcon" Width="24" Height="24" Source="{x:Bind Icon, Mode=OneWay}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="New"
                                    FontSize="12"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Visibility="{x:Bind NewVisibility}" />
                                <TextBlock
                                    Text="System"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="{x:Bind SystemVisibility}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </DataTemplate>

                <!--
                    A category card: a 156 square card with the first apps two by two in 68 squares (or, with more than four,
                    three and the next ones' icons in the fourth), and the category's name below, which opens it.
                -->
                <DataTemplate x:Key="CategoryTemplate" x:DataType="local:StartCategory">
                    <Grid
                        Width="156"
                        Height="192"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        AutomationProperties.AutomationId="CategoryCard"
                        AutomationProperties.Name="{x:Bind AutomationName}">
                        <Border
                            Height="156"
                            VerticalAlignment="Top"
                            CornerRadius="8"
                            BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <ItemsControl Margin="10" VerticalAlignment="Top" IsTabStop="False" ItemsSource="{x:Bind Cells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" ItemWidth="68" ItemHeight="68" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:CategoryCell">
                                    <Button
                                        Width="68"
                                        Height="68"
                                        Margin="0"
                                        AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                        AutomationProperties.Name="{x:Bind Name}"
                                        ToolTipService.ToolTip="{x:Bind ToolTip}"
                                        Click="CategoryCell_Click">
                                        <Button.ContextFlyout>
                                            <MenuFlyout Opening="CategoryCellMenu_Opening" />
                                        </Button.ContextFlyout>
                                        <Grid>
                                            <Image Width="32" Height="32" Source="{x:Bind App.Icon, Mode=OneWay}" Visibility="{x:Bind AppVisibility}" />
                                            <!-- 16 icons 2 apart, in Explorer's 34 square. -->
                                            <ItemsControl
                                                Width="36"
                                                Height="36"
                                                Margin="2,2,0,0"
                                                IsHitTestVisible="False"
                                                ItemsSource="{x:Bind Overflow}"
                                                Visibility="{x:Bind OverflowVisibility}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" ItemWidth="18" ItemHeight="18" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="local:StartItem">
                                                        <Image Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Source="{x:Bind Icon, Mode=OneWay}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button
                            Height="32"
                            Margin="0,160,0,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Content="{x:Bind Name}"
                            FontSize="12"
                            AutomationProperties.AutomationId="CategoryButton"
                            AutomationProperties.Name="{x:Bind Name}"
                            Click="CategoryButton_Click" />
                    </Grid>
                </DataTemplate>

                <!-- A letter's apps in the name views, under a header as wide as the rows, which opens the letters. -->
                <DataTemplate x:Key="LetterGridGroupTemplate" x:DataType="local:StartGroup">
                    <StackPanel>
                        <Button
                            Height="40"
                            Margin="20,9,28,4"
                            Padding="12,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            AutomationProperties.AutomationId="LetterHeader"
                            AutomationProperties.Name="{x:Bind HeaderName}"
                            Click="LetterHeader_Click">
                            <Grid>
                                <TextBlock Text="{x:Bind Key}" Visibility="{x:Bind TextVisibility}" />
                                <FontIcon Glyph="{x:Bind Key}" FontSize="16" HorizontalAlignment="Left" Visibility="{x:Bind GlyphVisibility}" />
                            </Grid>
                        </Button>
                        <ItemsControl IsTabStop="False" ItemsSource="{x:Bind Items}" ItemTemplate="{StaticResource AppTileTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="96" ItemHeight="84" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>

                <DataTemplate x:Key="LetterListGroupTemplate" x:DataType="local:StartGroup">
                    <StackPanel>
                        <Button
                            Height="40"
                            Margin="20,9,28,4"
                            Padding="12,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            AutomationProperties.AutomationId="LetterHeader"
                            AutomationProperties.Name="{x:Bind HeaderName}"
                            Click="LetterHeader_Click">
                            <Grid>
                                <TextBlock Text="{x:Bind Key}" Visibility="{x:Bind TextVisibility}" />
                                <FontIcon Glyph="{x:Bind Key}" FontSize="16" HorizontalAlignment="Left" Visibility="{x:Bind GlyphVisibility}" />
                            </Grid>
                        </Button>
                        <ItemsControl Margin="20,0,28,0" IsTabStop="False" ItemsSource="{x:Bind Items}" ItemTemplate="{StaticResource AppRowTemplate}" />
                    </StackPanel>
                </DataTemplate>

                <DataTemplate x:Key="GroupHeaderTemplate" x:DataType="local:StartGroup">
                    <TextBlock Text="{x:Bind Key}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                </DataTemplate>

                <!-- Group headers without the default's divider line and tall row. -->
                <Style x:Key="GroupHeaderContainerStyle" TargetType="ListViewHeaderItem">
                    <Setter Property="Padding" Value="16,12,16,4" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewHeaderItem">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- A category of an app's jump list in its menu: Explorer's headings, 16 in and 32 tall. -->
                <Style x:Key="JumpListHeaderStyle" TargetType="MenuFlyoutItem">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuFlyoutItem">
                                <TextBlock
                                    Margin="16,8,12,8"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{TemplateBinding Text}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="32,16,32,8">
            <TextBox
                x:Name="SearchBox"
                AutomationProperties.AutomationId="StartSearchBox"
                AutomationProperties.Name="Search"
                Height="32"
                CornerRadius="16"
                Padding="42,6,12,0"
                PlaceholderText="Search for apps and documents"
                TextChanged="SearchBox_TextChanged"
                KeyDown="SearchBox_KeyDown" />
            <FontIcon
                Margin="16,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Glyph="&#xE721;"
                FontSize="14"
                IsHitTestVisible="False" />
        </Grid>

        <!--
            Home, as Explorer's 25H2 Start with Recommended off: pinned apps, then All with its three views, on one
            scrolling page; Settings' Pinned and All switch each off. Pinned apps start 8 further left than the rest, as
            in Explorer, so that's the padding; more would clip them.
        -->
        <ScrollViewer x:Name="HomeView" Grid.Row="1" Margin="0,8,0,0" Padding="32,0,24,16">
            <StackPanel>
                <StackPanel x:Name="PinnedSection">
                    <TextBlock Margin="31,29,0,16" Text="Pinned" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <!-- The grid's 10 below its items aren't Explorer's. -->
                    <GridView
                        x:Name="PinnedGrid"
                        Margin="0,0,0,-10"
                        AutomationProperties.AutomationId="PinnedApps"
                        AutomationProperties.Name="Pinned"
                        ItemTemplate="{StaticResource PinTemplate}"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="Item_Click"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <!-- Dragged by hand (see PinnedGrid_PointerPressed), without item transitions: the move at the drop
                             would be animated as a removal and an addition, and the icon vanish and come back. -->
                        <GridView.ItemContainerTransitions>
                            <TransitionCollection />
                        </GridView.ItemContainerTransitions>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </GridView.ItemContainerStyle>
                    </GridView>
                    <TextBlock
                        x:Name="NoPinnedText"
                        Margin="32,8,0,8"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Pin apps from All to keep them here." />
                </StackPanel>

                <!--
                    All: Explorer's categories (cards of apps, each opening into a panel), or the apps by name as tiles or
                    rows under their letters, "Most used" first when Settings asks for it. The view is Explorer's choice
                    too (AllAppsViewMode).
                -->
                <StackPanel x:Name="AllSection">
                    <Grid x:Name="AllHeading" Height="32" Margin="31,31,28,0">
                        <TextBlock Text="All" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <DropDownButton
                            x:Name="ViewButton"
                            Height="32"
                            Padding="12,0,10,0"
                            HorizontalAlignment="Right"
                            AutomationProperties.AutomationId="AllAppsViewButton">
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="ViewFlyout" Placement="BottomEdgeAlignedRight">
                                    <RadioMenuFlyoutItem
                                        x:Name="CategoryViewMenuItem"
                                        Text="Category"
                                        GroupName="AllAppsView"
                                        AutomationProperties.AutomationId="CategoryViewMenuItem"
                                        Click="ViewItem_Click" />
                                    <RadioMenuFlyoutItem
                                        x:Name="GridViewMenuItem"
                                        Text="Grid"
                                        GroupName="AllAppsView"
                                        AutomationProperties.AutomationId="GridViewMenuItem"
                                        Click="ViewItem_Click" />
                                    <RadioMenuFlyoutItem
                                        x:Name="ListViewMenuItem"
                                        Text="List"
                                        GroupName="AllAppsView"
                                        AutomationProperties.AutomationId="ListViewMenuItem"
                                        Click="ViewItem_Click" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>
                    <!-- Cards 156 wide, 27 apart, rows 12 apart, four to a row. -->
                    <ItemsControl
                        x:Name="CategoryCards"
                        Margin="32,9,0,0"
                        IsTabStop="False"
                        ItemTemplate="{StaticResource CategoryTemplate}"
                        AutomationProperties.AutomationId="AllAppsCategories"
                        AutomationProperties.Name="Categories">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="183" ItemHeight="204" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <!-- Explorer's first letter sits 10 higher than the gap between its letters gives. -->
                    <ItemsControl
                        x:Name="LetterGroups"
                        Margin="0,-10,0,0"
                        IsTabStop="False"
                        AutomationProperties.AutomationId="AllAppsList"
                        AutomationProperties.Name="All" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--
            The letters, as Explorer's All zooms out to them from a letter's header: Most used, &, #, A to Z and other
            scripts, four to a row in 48 squares 4 apart, those without apps dimmed. A letter jumps to its apps.
        -->
        <Grid x:Name="LetterView" Grid.Row="1" Visibility="Collapsed" Background="Transparent">
            <TextBlock Margin="63,37,0,0" VerticalAlignment="Top" Text="All" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <Button
                Height="32"
                Margin="0,31,52,0"
                Padding="12,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                AutomationProperties.AutomationId="LetterBackButton"
                AutomationProperties.Name="Back"
                Click="LetterBack_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE76B;" FontSize="10" />
                    <TextBlock Text="Back" />
                </StackPanel>
            </Button>
            <ItemsControl
                x:Name="LetterGrid"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsTabStop="False"
                RenderTransformOrigin="0.5,0.5"
                AutomationProperties.AutomationId="LetterGrid">
                <ItemsControl.RenderTransform>
                    <ScaleTransform x:Name="LetterGridScale" />
                </ItemsControl.RenderTransform>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="52" ItemHeight="52" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>

        <!-- Search results: apps first, then files grouped by kind. -->
        <Grid x:Name="SearchView" Grid.Row="1" Margin="40,8,40,8" Visibility="Collapsed">
            <ListView
                x:Name="ResultsList"
                AutomationProperties.AutomationId="SearchResults"
                AutomationProperties.Name="Search results"
                ItemTemplate="{StaticResource ListItemTemplate}"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="Item_Click">
                <ListView.GroupStyle>
                    <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" HeaderContainerStyle="{StaticResource GroupHeaderContainerStyle}" />
                </ListView.GroupStyle>
            </ListView>
            <TextBlock
                x:Name="NoResultsText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No results"
                Visibility="Collapsed" />
        </Grid>

        <!--
            An open folder, as Explorer's: a panel of its own acrylic in the middle of Start, 450 by 378 with the name
            at the top (a box to rename it in) and the apps in rows of four below. It grows out of the folder's tile.
            A click beside it closes it.
        -->
        <Grid
            x:Name="FolderLayer"
            Grid.RowSpan="3"
            Background="Transparent"
            Visibility="Collapsed"
            PointerPressed="FolderLayer_PointerPressed">
            <Border
                x:Name="FolderPanel"
                Width="450"
                Height="378"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                RenderTransformOrigin="0.5,0.5"
                AutomationProperties.AutomationId="FolderPanel">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="FolderTransform" />
                </Border.RenderTransform>
                <Grid>
                    <TextBox
                        x:Name="FolderNameBox"
                        Width="320"
                        Height="40"
                        Margin="0,32,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        VerticalContentAlignment="Center"
                        TextAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        AutomationProperties.AutomationId="FolderNameBox"
                        AutomationProperties.Name="Folder name"
                        KeyDown="FolderNameBox_KeyDown"
                        LostFocus="FolderNameBox_LostFocus" />
                    <TextBlock
                        x:Name="CategoryTitle"
                        Height="40"
                        Margin="0,32,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Padding="0,6,0,0"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Visibility="Collapsed"
                        AutomationProperties.AutomationId="CategoryTitle" />
                    <!-- Four 96 tiles to a row, as the folder's; the scroll bar takes no room from them. -->
                    <ScrollViewer
                        x:Name="CategoryAppsView"
                        Width="400"
                        Margin="32,92,0,0"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed">
                        <ItemsControl
                            x:Name="CategoryApps"
                            Width="384"
                            HorizontalAlignment="Left"
                            IsTabStop="False"
                            ItemTemplate="{StaticResource AppTileTemplate}"
                            AutomationProperties.AutomationId="CategoryApps"
                            AutomationProperties.Name="Category">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="96" ItemHeight="84" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <GridView
                        x:Name="FolderGrid"
                        Width="384"
                        Margin="32,92,32,0"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="FolderApps"
                        AutomationProperties.Name="Folder"
                        ItemTemplate="{StaticResource PinTemplate}"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="Item_Click">
                        <GridView.ItemContainerTransitions>
                            <TransitionCollection />
                        </GridView.ItemContainerTransitions>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </GridView.ItemContainerStyle>
                    </GridView>
                </Grid>
            </Border>
        </Grid>

        <!-- What a dragged pin is drawn as, above everything, so it can leave a folder's panel. -->
        <Canvas x:Name="DragLayer" Grid.RowSpan="3" IsHitTestVisible="False" />

        <!-- Corners to drag for resizing; the bottom stays on the taskbar. -->
        <local:ResizeGrip
            x:Name="LeftGrip"
            Grid.RowSpan="3"
            IsLeft="True"
            Width="16"
            Height="16"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Transparent"
            AutomationProperties.AutomationId="StartResizeGripLeft"
            AutomationProperties.Name="Resize Start"
            PointerPressed="Grip_PointerPressed"
            PointerMoved="Grip_PointerMoved"
            PointerReleased="Grip_PointerReleased"
            PointerCaptureLost="Grip_PointerReleased" />
        <local:ResizeGrip
            x:Name="RightGrip"
            Grid.RowSpan="3"
            Width="16"
            Height="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="Transparent"
            AutomationProperties.AutomationId="StartResizeGrip"
            AutomationProperties.Name="Resize Start"
            PointerPressed="Grip_PointerPressed"
            PointerMoved="Grip_PointerMoved"
            PointerReleased="Grip_PointerReleased"
            PointerCaptureLost="Grip_PointerReleased" />

        <!-- User; Switch to Explorer, the folders chosen for Start (see ShowPlaces), Power. -->
        <Grid
            Grid.Row="2"
            Padding="52,12,53,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <!--
                The user opens Explorer's account card above it: the account, Sign out, and "…" for the PC's other
                accounts. Filled as it opens (AccountFlyout_Opening); see docs/design.md, "Account menu".
            -->
            <Button
                x:Name="UserButton"
                Width="Auto"
                Margin="0"
                Padding="12,4"
                HorizontalAlignment="Left"
                Style="{StaticResource FlatButtonStyle}"
                AutomationProperties.AutomationId="UserButton">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <PersonPicture x:Name="UserPicture" Width="32" Height="32" />
                    <TextBlock x:Name="UserName" VerticalAlignment="Center" FontSize="12" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout
                        x:Name="AccountFlyout"
                        Placement="Top"
                        ShouldConstrainToRootBounds="False"
                        Opening="AccountFlyout_Opening"
                        Closed="AccountFlyout_Closed">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <!-- The flyout's own backdrop shows through (Show). -->
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <StackPanel x:Name="AccountCard" Width="360">
                            <StackPanel.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.MergedDictionaries>
                                        <ResourceDictionary Source="ms-appx:///FlatButtons.xaml" />
                                    </ResourceDictionary.MergedDictionaries>
                                </ResourceDictionary>
                            </StackPanel.Resources>
                            <!-- Microsoft's logo and name, Sign out, "…". -->
                            <Grid Height="40" Margin="16,8,8,0">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <!-- Microsoft's logo as Explorer's SVG draws it: four squares with a little space around them. -->
                                    <Grid Width="20" Height="20" Padding="1" ColumnSpacing="1" RowSpacing="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Rectangle Fill="#F25022" />
                                        <Rectangle Grid.Column="1" Fill="#7FBA00" />
                                        <Rectangle Grid.Row="1" Fill="#00A4EF" />
                                        <Rectangle Grid.Row="1" Grid.Column="1" Fill="#FFB900" />
                                    </Grid>
                                    <TextBlock
                                        Text="Microsoft"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <Button
                                        x:Name="SignOutButton"
                                        Width="Auto"
                                        Margin="0"
                                        Padding="13,0"
                                        Content="Sign out"
                                        FontSize="14"
                                        Style="{StaticResource FlatButtonStyle}"
                                        AutomationProperties.AutomationId="SignOutButton"
                                        Click="SignOut_Click" />
                                    <Button
                                        x:Name="MoreOptionsButton"
                                        Margin="0"
                                        Style="{StaticResource FlatButtonStyle}"
                                        AutomationProperties.AutomationId="MoreOptionsButton"
                                        AutomationProperties.Name="More options"
                                        ToolTipService.ToolTip="More options">
                                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                                        <Button.Flyout>
                                            <Flyout
                                                x:Name="MoreOptionsFlyout"
                                                Placement="BottomEdgeAlignedLeft"
                                                ShouldConstrainToRootBounds="False">
                                                <Flyout.FlyoutPresenterStyle>
                                                    <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="MinWidth" Value="0" />
                                                        <Setter Property="MinHeight" Value="0" />
                                                        <Setter Property="Background" Value="Transparent" />
                                                    </Style>
                                                </Flyout.FlyoutPresenterStyle>
                                                <StackPanel x:Name="MoreOptionsPanel" Width="241" Padding="4,0,4,4">
                                                    <StackPanel.Resources>
                                                        <ResourceDictionary>
                                                            <ResourceDictionary.MergedDictionaries>
                                                                <ResourceDictionary Source="ms-appx:///FlatButtons.xaml" />
                                                            </ResourceDictionary.MergedDictionaries>
                                                        </ResourceDictionary>
                                                    </StackPanel.Resources>
                                                    <TextBlock
                                                        Margin="12,13,0,8"
                                                        Text="Other users"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        AutomationProperties.HeadingLevel="Level1" />
                                                    <!-- The other accounts, then Switch user (AccountFlyout_Opening). -->
                                                    <ItemsControl
                                                        x:Name="OtherUsersList"
                                                        IsTabStop="False"
                                                        XYFocusKeyboardNavigation="Enabled"
                                                        AutomationProperties.AutomationId="OtherUsersList"
                                                        AutomationProperties.Name="Other users">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="local:AccountRow">
                                                                <Button
                                                                    Width="233"
                                                                    Height="48"
                                                                    Margin="0"
                                                                    Padding="9,0"
                                                                    HorizontalContentAlignment="Left"
                                                                    Style="{StaticResource FlatButtonStyle}"
                                                                    AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                                                    AutomationProperties.Name="{x:Bind Name}"
                                                                    ToolTipService.ToolTip="{x:Bind Name}"
                                                                    Click="AccountRow_Click">
                                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                                        <Grid Width="30" Height="30">
                                                                            <Ellipse Visibility="{x:Bind PictureVisibility}">
                                                                                <Ellipse.Fill>
                                                                                    <ImageBrush ImageSource="{x:Bind Picture}" />
                                                                                </Ellipse.Fill>
                                                                            </Ellipse>
                                                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                                                                        </Grid>
                                                                        <StackPanel VerticalAlignment="Center">
                                                                            <TextBlock MaxWidth="167" Text="{x:Bind Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock
                                                                                Text="{x:Bind Subtitle}"
                                                                                FontSize="12"
                                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                Visibility="{x:Bind SubtitleVisibility}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <!-- The account: picture, name, its email or "Local account", Manage my account. -->
                            <Grid Margin="16,12,0,18" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <!-- Blank until the picture is ready, as Explorer's, rather than initials. -->
                                <Ellipse Width="58" Height="58" VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="AccountPicture" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="AccountName" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="AccountKind"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                    <HyperlinkButton
                                        x:Name="ManageAccountLink"
                                        Margin="-1,3,0,0"
                                        Padding="1"
                                        BorderThickness="0"
                                        FontSize="12"
                                        AutomationProperties.AutomationId="ManageAccountLink"
                                        Click="ManageAccount_Click" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <!-- Explorer's buttons here touch, 40 apart. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </StackPanel.Resources>
                <Button
                    x:Name="SwitchToExplorerButton"
                    AutomationProperties.AutomationId="SwitchToExplorerButton"
                    AutomationProperties.Name="Switch to Explorer"
                    ToolTipService.ToolTip="Switch to Explorer"
                    Click="SwitchToExplorerButton_Click">
                    <FontIcon Glyph="&#xE8AB;" FontSize="16" />
                </Button>
                <StackPanel x:Name="PlacesPanel" Orientation="Horizontal" Background="Transparent">
                    <StackPanel.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem AutomationProperties.AutomationId="PersonalizePlacesMenuItem" Text="Personalise this list" Click="PersonalizePlaces_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE771;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </StackPanel.ContextFlyout>
                </StackPanel>
                <!-- Its menu is filled as it opens (PowerMenu_Opening); the dot shows while an update waits. -->
                <Button
                    x:Name="PowerButton"
                    AutomationProperties.AutomationId="PowerButton"
                    AutomationProperties.Name="Power"
                    ToolTipService.ToolTip="Power">
                    <Grid>
                        <FontIcon x:Name="PowerGlyph" Glyph="&#xE7E8;" FontSize="16" />
                        <FontIcon x:Name="PowerUpdateDot" Glyph="&#xEC83;" FontSize="16" Foreground="#FF9900" Visibility="Collapsed" />
                    </Grid>
                    <Button.Flyout>
                        <MenuFlyout x:Name="PowerFlyout" Placement="TopEdgeAlignedRight" Opening="PowerMenu_Opening" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
