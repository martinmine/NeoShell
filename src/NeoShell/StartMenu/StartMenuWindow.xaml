<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NeoShell.StartMenu.StartMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoShell.StartMenu">

    <Grid x:Name="Root">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///FlatButtons.xaml" />
                </ResourceDictionary.MergedDictionaries>

                <!--
                    A pinned app, or a folder of them: a plate with its first four apps' icons, two by two, as Explorer
                    draws it (40 square with its edge, the icons 16 with 2 between). An app shows the plate too, its icon shrinking into
                    the plate's first place, while another app is held over it to make a folder.
                -->
                <DataTemplate x:Key="PinTemplate" x:DataType="local:StartItem">
                    <StackPanel
                        Width="96"
                        Height="84"
                        Padding="4,12,4,4"
                        Spacing="4"
                        Background="Transparent"
                        AutomationProperties.AutomationId="{x:Bind AutomationId}"
                        AutomationProperties.Name="{x:Bind Title}">
                        <StackPanel.ContextFlyout>
                            <MenuFlyout Opening="PinMenu_Opening" />
                        </StackPanel.ContextFlyout>
                        <Grid x:Name="ItemIcon" Width="32" Height="32">
                            <Border
                                x:Name="FolderPlate"
                                Margin="-4"
                                Padding="2,3,2,0"
                                CornerRadius="4"
                                BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Opacity="{x:Bind PlateOpacity}">
                                <ItemsControl Margin="0,0,-2,-2" ItemsSource="{x:Bind MiniApps}" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" ItemWidth="18" ItemHeight="18" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:StartItem">
                                            <Image Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Source="{x:Bind Icon, Mode=OneWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <Image x:Name="AppIcon" Source="{x:Bind Icon, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            x:Name="ItemLabel"
                            Text="{x:Bind Title}"
                            FontSize="12"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            MaxLines="2"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>

                <!-- A row in All apps and in search results. -->
                <DataTemplate x:Key="ListItemTemplate" x:DataType="local:StartItem">
                    <Grid
                        Padding="4,6"
                        ColumnSpacing="12"
                        Background="Transparent"
                        AutomationProperties.AutomationId="StartListItem"
                        AutomationProperties.Name="{x:Bind Title}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.ContextFlyout>
                            <MenuFlyout Opening="ResultMenu_Opening" />
                        </Grid.ContextFlyout>
                        <Image Width="24" Height="24" Source="{x:Bind Icon, Mode=OneWay}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind Subtitle}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>

                <!-- A recent app: as Windows shows them, a bigger icon and when it was last started. -->
                <DataTemplate x:Key="RecentItemTemplate" x:DataType="local:StartItem">
                    <Grid
                        Padding="12,0"
                        ColumnSpacing="12"
                        Background="Transparent"
                        AutomationProperties.AutomationId="RecentApp"
                        AutomationProperties.Name="{x:Bind Title}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.ContextFlyout>
                            <MenuFlyout Opening="ItemMenu_Opening" />
                        </Grid.ContextFlyout>
                        <Image x:Name="ItemIcon" Width="32" Height="32" Source="{x:Bind Icon, Mode=OneWay}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind Subtitle}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>

                <!-- A row in All: icon and name only. -->
                <DataTemplate x:Key="AppItemTemplate" x:DataType="local:StartItem">
                    <Grid
                        Padding="4,2"
                        ColumnSpacing="12"
                        Background="Transparent"
                        AutomationProperties.AutomationId="StartListItem"
                        AutomationProperties.Name="{x:Bind Title}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.ContextFlyout>
                            <MenuFlyout Opening="ItemMenu_Opening" />
                        </Grid.ContextFlyout>
                        <Image Width="24" Height="24" Source="{x:Bind Icon, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>

                <DataTemplate x:Key="GroupHeaderTemplate" x:DataType="local:StartGroup">
                    <TextBlock Text="{x:Bind Key}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                </DataTemplate>

                <!-- Group headers without the default's divider line and tall row. -->
                <Style x:Key="GroupHeaderContainerStyle" TargetType="ListViewHeaderItem">
                    <Setter Property="Padding" Value="16,12,16,4" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewHeaderItem">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- A category of an app's jump list in its menu: Explorer's headings, 16 in and 32 tall. -->
                <Style x:Key="JumpListHeaderStyle" TargetType="MenuFlyoutItem">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuFlyoutItem">
                                <TextBlock
                                    Margin="16,8,12,8"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{TemplateBinding Text}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="32,16,32,8">
            <TextBox
                x:Name="SearchBox"
                AutomationProperties.AutomationId="StartSearchBox"
                AutomationProperties.Name="Search"
                Height="32"
                CornerRadius="16"
                Padding="42,6,12,0"
                PlaceholderText="Search for apps and documents"
                TextChanged="SearchBox_TextChanged"
                KeyDown="SearchBox_KeyDown" />
            <FontIcon
                Margin="16,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Glyph="&#xE721;"
                FontSize="14"
                IsHitTestVisible="False" />
        </Grid>

        <!--
            Home, as in Windows 11: pinned apps, then recent apps, on one scrolling page. Pinned apps start 8 further left
            than the rest, as in Explorer, so that's the padding; more would clip them.
        -->
        <ScrollViewer x:Name="HomeView" Grid.Row="1" Padding="32,0,24,16">
            <StackPanel>
                <Grid Margin="32,20,24,12">
                    <TextBlock Text="Pinned" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <Button
                        x:Name="AllAppsButton"
                        AutomationProperties.AutomationId="AllAppsButton"
                        HorizontalAlignment="Right"
                        Padding="10,4"
                        Click="AllAppsButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="All apps" FontSize="12" />
                            <FontIcon Glyph="&#xE76C;" FontSize="10" />
                        </StackPanel>
                    </Button>
                </Grid>
                <GridView
                    x:Name="PinnedGrid"
                    AutomationProperties.AutomationId="PinnedApps"
                    AutomationProperties.Name="Pinned"
                    ItemTemplate="{StaticResource PinTemplate}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="Item_Click"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <!-- Dragged by hand (see PinnedGrid_PointerPressed), without item transitions: the move at the drop
                         would be animated as a removal and an addition, and the icon vanish and come back. -->
                    <GridView.ItemContainerTransitions>
                        <TransitionCollection />
                    </GridView.ItemContainerTransitions>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>
                <TextBlock
                    x:Name="NoPinnedText"
                    Margin="32,8,0,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Pin apps from All apps to keep them here." />

                <StackPanel x:Name="RecentSection" Visibility="Collapsed">
                    <TextBlock Margin="32,28,0,15" Text="Recent" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <!--
                        Laid out as Explorer's: three columns 256 wide with 20 between the items, icons in line with the
                        heading. The last column's gap may hang off the right edge.
                    -->
                    <GridView
                        x:Name="RecentGrid"
                        Margin="20,0,-20,0"
                        AutomationProperties.AutomationId="RecentApps"
                        AutomationProperties.Name="Recent"
                        ItemTemplate="{StaticResource RecentItemTemplate}"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="Item_Click"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                                <Setter Property="Margin" Value="0,0,20,0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemWidth="256" ItemHeight="56" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- All apps, alphabetical. -->
        <Grid x:Name="AllAppsView" Grid.Row="1" Margin="40,0,40,8" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid Margin="24,20,8,12">
                <TextBlock Text="All apps" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <Button
                    x:Name="BackButton"
                    AutomationProperties.AutomationId="StartBackButton"
                    HorizontalAlignment="Right"
                    Padding="10,4"
                    Click="BackButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE76B;" FontSize="10" />
                        <TextBlock Text="Back" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>
            <ListView
                x:Name="AllAppsList"
                Grid.Row="1"
                AutomationProperties.AutomationId="AllAppsList"
                AutomationProperties.Name="All apps"
                ItemTemplate="{StaticResource AppItemTemplate}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="Item_Click">
                <ListView.GroupStyle>
                    <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" HeaderContainerStyle="{StaticResource GroupHeaderContainerStyle}" />
                </ListView.GroupStyle>
            </ListView>
        </Grid>

        <!-- Search results: apps first, then files grouped by kind. -->
        <Grid x:Name="SearchView" Grid.Row="1" Margin="40,8,40,8" Visibility="Collapsed">
            <ListView
                x:Name="ResultsList"
                AutomationProperties.AutomationId="SearchResults"
                AutomationProperties.Name="Search results"
                ItemTemplate="{StaticResource ListItemTemplate}"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="Item_Click">
                <ListView.GroupStyle>
                    <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" HeaderContainerStyle="{StaticResource GroupHeaderContainerStyle}" />
                </ListView.GroupStyle>
            </ListView>
            <TextBlock
                x:Name="NoResultsText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No results"
                Visibility="Collapsed" />
        </Grid>

        <!--
            An open folder, as Explorer's: a panel of its own acrylic in the middle of Start, 450 by 378 with the name
            at the top (a box to rename it in) and the apps in rows of four below. It grows out of the folder's tile.
            A click beside it closes it.
        -->
        <Grid
            x:Name="FolderLayer"
            Grid.RowSpan="3"
            Background="Transparent"
            Visibility="Collapsed"
            PointerPressed="FolderLayer_PointerPressed">
            <Border
                x:Name="FolderPanel"
                Width="450"
                Height="378"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                RenderTransformOrigin="0.5,0.5"
                AutomationProperties.AutomationId="FolderPanel">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="FolderTransform" />
                </Border.RenderTransform>
                <Grid>
                    <TextBox
                        x:Name="FolderNameBox"
                        Width="320"
                        Height="40"
                        Margin="0,32,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        VerticalContentAlignment="Center"
                        TextAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        AutomationProperties.AutomationId="FolderNameBox"
                        AutomationProperties.Name="Folder name"
                        KeyDown="FolderNameBox_KeyDown"
                        LostFocus="FolderNameBox_LostFocus" />
                    <GridView
                        x:Name="FolderGrid"
                        Width="384"
                        Margin="32,92,32,0"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="FolderApps"
                        AutomationProperties.Name="Folder"
                        ItemTemplate="{StaticResource PinTemplate}"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="Item_Click">
                        <GridView.ItemContainerTransitions>
                            <TransitionCollection />
                        </GridView.ItemContainerTransitions>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </GridView.ItemContainerStyle>
                    </GridView>
                </Grid>
            </Border>
        </Grid>

        <!-- What a dragged pin is drawn as, above everything, so it can leave a folder's panel. -->
        <Canvas x:Name="DragLayer" Grid.RowSpan="3" IsHitTestVisible="False" />

        <!-- Corners to drag for resizing; the bottom stays on the taskbar. -->
        <local:ResizeGrip
            x:Name="LeftGrip"
            Grid.RowSpan="3"
            IsLeft="True"
            Width="16"
            Height="16"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Transparent"
            AutomationProperties.AutomationId="StartResizeGripLeft"
            AutomationProperties.Name="Resize Start"
            PointerPressed="Grip_PointerPressed"
            PointerMoved="Grip_PointerMoved"
            PointerReleased="Grip_PointerReleased"
            PointerCaptureLost="Grip_PointerReleased" />
        <local:ResizeGrip
            x:Name="RightGrip"
            Grid.RowSpan="3"
            Width="16"
            Height="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="Transparent"
            AutomationProperties.AutomationId="StartResizeGrip"
            AutomationProperties.Name="Resize Start"
            PointerPressed="Grip_PointerPressed"
            PointerMoved="Grip_PointerMoved"
            PointerReleased="Grip_PointerReleased"
            PointerCaptureLost="Grip_PointerReleased" />

        <!-- User; Switch to Explorer, the folders chosen for Start (see ShowPlaces), Power. -->
        <Grid
            Grid.Row="2"
            Padding="52,12,53,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <!--
                The user opens Explorer's account card above it: the account, Sign out, and "…" for the PC's other
                accounts. Filled as it opens (AccountFlyout_Opening); see docs/design.md, "Account menu".
            -->
            <Button
                x:Name="UserButton"
                Width="Auto"
                Margin="0"
                Padding="12,4"
                HorizontalAlignment="Left"
                Style="{StaticResource FlatButtonStyle}"
                AutomationProperties.AutomationId="UserButton">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <PersonPicture x:Name="UserPicture" Width="32" Height="32" />
                    <TextBlock x:Name="UserName" VerticalAlignment="Center" FontSize="12" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout
                        x:Name="AccountFlyout"
                        Placement="Top"
                        ShouldConstrainToRootBounds="False"
                        Opening="AccountFlyout_Opening"
                        Closed="AccountFlyout_Closed">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <!-- The flyout's own backdrop shows through (Show). -->
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <StackPanel x:Name="AccountCard" Width="360">
                            <StackPanel.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.MergedDictionaries>
                                        <ResourceDictionary Source="ms-appx:///FlatButtons.xaml" />
                                    </ResourceDictionary.MergedDictionaries>
                                </ResourceDictionary>
                            </StackPanel.Resources>
                            <!-- Microsoft's logo and name, Sign out, "…". -->
                            <Grid Height="40" Margin="16,8,8,0">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <!-- Microsoft's logo as Explorer's SVG draws it: four squares with a little space around them. -->
                                    <Grid Width="20" Height="20" Padding="1" ColumnSpacing="1" RowSpacing="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Rectangle Fill="#F25022" />
                                        <Rectangle Grid.Column="1" Fill="#7FBA00" />
                                        <Rectangle Grid.Row="1" Fill="#00A4EF" />
                                        <Rectangle Grid.Row="1" Grid.Column="1" Fill="#FFB900" />
                                    </Grid>
                                    <TextBlock
                                        Text="Microsoft"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <Button
                                        x:Name="SignOutButton"
                                        Width="Auto"
                                        Margin="0"
                                        Padding="13,0"
                                        Content="Sign out"
                                        FontSize="14"
                                        Style="{StaticResource FlatButtonStyle}"
                                        AutomationProperties.AutomationId="SignOutButton"
                                        Click="SignOut_Click" />
                                    <Button
                                        x:Name="MoreOptionsButton"
                                        Margin="0"
                                        Style="{StaticResource FlatButtonStyle}"
                                        AutomationProperties.AutomationId="MoreOptionsButton"
                                        AutomationProperties.Name="More options"
                                        ToolTipService.ToolTip="More options">
                                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                                        <Button.Flyout>
                                            <Flyout
                                                x:Name="MoreOptionsFlyout"
                                                Placement="BottomEdgeAlignedLeft"
                                                ShouldConstrainToRootBounds="False">
                                                <Flyout.FlyoutPresenterStyle>
                                                    <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="MinWidth" Value="0" />
                                                        <Setter Property="MinHeight" Value="0" />
                                                        <Setter Property="Background" Value="Transparent" />
                                                    </Style>
                                                </Flyout.FlyoutPresenterStyle>
                                                <StackPanel x:Name="MoreOptionsPanel" Width="241" Padding="4,0,4,4">
                                                    <StackPanel.Resources>
                                                        <ResourceDictionary>
                                                            <ResourceDictionary.MergedDictionaries>
                                                                <ResourceDictionary Source="ms-appx:///FlatButtons.xaml" />
                                                            </ResourceDictionary.MergedDictionaries>
                                                        </ResourceDictionary>
                                                    </StackPanel.Resources>
                                                    <TextBlock
                                                        Margin="12,13,0,8"
                                                        Text="Other users"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        AutomationProperties.HeadingLevel="Level1" />
                                                    <!-- The other accounts, then Switch user (AccountFlyout_Opening). -->
                                                    <ItemsControl
                                                        x:Name="OtherUsersList"
                                                        IsTabStop="False"
                                                        XYFocusKeyboardNavigation="Enabled"
                                                        AutomationProperties.AutomationId="OtherUsersList"
                                                        AutomationProperties.Name="Other users">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="local:AccountRow">
                                                                <Button
                                                                    Width="233"
                                                                    Height="48"
                                                                    Margin="0"
                                                                    Padding="9,0"
                                                                    HorizontalContentAlignment="Left"
                                                                    Style="{StaticResource FlatButtonStyle}"
                                                                    AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                                                    AutomationProperties.Name="{x:Bind Name}"
                                                                    ToolTipService.ToolTip="{x:Bind Name}"
                                                                    Click="AccountRow_Click">
                                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                                        <Grid Width="30" Height="30">
                                                                            <Ellipse Visibility="{x:Bind PictureVisibility}">
                                                                                <Ellipse.Fill>
                                                                                    <ImageBrush ImageSource="{x:Bind Picture}" />
                                                                                </Ellipse.Fill>
                                                                            </Ellipse>
                                                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                                                                        </Grid>
                                                                        <StackPanel VerticalAlignment="Center">
                                                                            <TextBlock MaxWidth="167" Text="{x:Bind Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock
                                                                                Text="{x:Bind Subtitle}"
                                                                                FontSize="12"
                                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                Visibility="{x:Bind SubtitleVisibility}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <!-- The account: picture, name, its email or "Local account", Manage my account. -->
                            <Grid Margin="16,12,0,18" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <!-- Blank until the picture is ready, as Explorer's, rather than initials. -->
                                <Ellipse Width="58" Height="58" VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="AccountPicture" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="AccountName" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="AccountKind"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                    <HyperlinkButton
                                        x:Name="ManageAccountLink"
                                        Margin="-1,3,0,0"
                                        Padding="1"
                                        BorderThickness="0"
                                        FontSize="12"
                                        AutomationProperties.AutomationId="ManageAccountLink"
                                        Click="ManageAccount_Click" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <!-- Explorer's buttons here touch, 40 apart. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </StackPanel.Resources>
                <Button
                    x:Name="SwitchToExplorerButton"
                    AutomationProperties.AutomationId="SwitchToExplorerButton"
                    AutomationProperties.Name="Switch to Explorer"
                    ToolTipService.ToolTip="Switch to Explorer"
                    Click="SwitchToExplorerButton_Click">
                    <FontIcon Glyph="&#xE8AB;" FontSize="16" />
                </Button>
                <StackPanel x:Name="PlacesPanel" Orientation="Horizontal" Background="Transparent">
                    <StackPanel.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem AutomationProperties.AutomationId="PersonalizePlacesMenuItem" Text="Personalise this list" Click="PersonalizePlaces_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE771;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </StackPanel.ContextFlyout>
                </StackPanel>
                <!-- Its menu is filled as it opens (PowerMenu_Opening); the dot shows while an update waits. -->
                <Button
                    x:Name="PowerButton"
                    AutomationProperties.AutomationId="PowerButton"
                    AutomationProperties.Name="Power"
                    ToolTipService.ToolTip="Power">
                    <Grid>
                        <FontIcon x:Name="PowerGlyph" Glyph="&#xE7E8;" FontSize="16" />
                        <FontIcon x:Name="PowerUpdateDot" Glyph="&#xEC83;" FontSize="16" Foreground="#FF9900" Visibility="Collapsed" />
                    </Grid>
                    <Button.Flyout>
                        <MenuFlyout x:Name="PowerFlyout" Placement="TopEdgeAlignedRight" Opening="PowerMenu_Opening" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
