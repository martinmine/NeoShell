<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NeoShell.StartMenu.StartMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoShell.StartMenu">

    <Grid x:Name="Root">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///FlatButtons.xaml" />
                </ResourceDictionary.MergedDictionaries>


                <!-- A row in All apps and in search results. -->
                <DataTemplate x:Key="ListItemTemplate" x:DataType="local:StartItem">
                    <Grid
                        Padding="4,6"
                        ColumnSpacing="12"
                        Background="Transparent"
                        AutomationProperties.AutomationId="StartListItem"
                        AutomationProperties.Name="{x:Bind Title}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.ContextFlyout>
                            <MenuFlyout Opening="ItemMenu_Opening" />
                        </Grid.ContextFlyout>
                        <Image Width="24" Height="24" Source="{x:Bind Icon, Mode=OneWay}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind Subtitle}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>

                <DataTemplate x:Key="GroupHeaderTemplate" x:DataType="local:StartGroup">
                    <TextBlock Text="{x:Bind Key}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                </DataTemplate>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox
            x:Name="SearchBox"
            AutomationProperties.AutomationId="StartSearchBox"
            AutomationProperties.Name="Search"
            Margin="32,32,32,12"
            Height="36"
            CornerRadius="18"
            Padding="16,8,12,0"
            PlaceholderText="Search for apps and documents"
            TextChanged="SearchBox_TextChanged"
            KeyDown="SearchBox_KeyDown" />

        <Grid Grid.Row="1" Margin="24,0,24,8">
            <!-- Home: pinned apps. -->
            <Grid x:Name="HomeView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid Margin="8,8,8,12">
                    <TextBlock Text="Pinned" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <Button
                        x:Name="AllAppsButton"
                        AutomationProperties.AutomationId="AllAppsButton"
                        HorizontalAlignment="Right"
                        Padding="10,4"
                        Click="AllAppsButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="All apps" FontSize="12" />
                            <FontIcon Glyph="&#xE76C;" FontSize="10" />
                        </StackPanel>
                    </Button>
                </Grid>
                <GridView
                    x:Name="PinnedGrid"
                    Grid.Row="1"
                    AutomationProperties.AutomationId="PinnedApps"
                    AutomationProperties.Name="Pinned"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="Item_Click"
                    CanDragItems="True"
                    CanReorderItems="True"
                    AllowDrop="True"
                    DragItemsCompleted="PinnedGrid_DragItemsCompleted">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:StartItem">
                            <StackPanel
                                Width="92"
                                Height="84"
                                Padding="4,10,4,4"
                                Spacing="6"
                                Background="Transparent"
                                AutomationProperties.AutomationId="PinnedApp"
                                AutomationProperties.Name="{x:Bind Title}">
                                <StackPanel.ContextFlyout>
                                    <MenuFlyout Opening="ItemMenu_Opening" />
                                </StackPanel.ContextFlyout>
                                <Image Width="32" Height="32" Source="{x:Bind Icon, Mode=OneWay}" />
                                <TextBlock
                                    Text="{x:Bind Title}"
                                    FontSize="12"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    MaxLines="2"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <TextBlock
                    x:Name="NoPinnedText"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Pin apps from All apps to keep them here." />
            </Grid>

            <!-- All apps, alphabetical. -->
            <Grid x:Name="AllAppsView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid Margin="8,8,8,12">
                    <TextBlock Text="All apps" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <Button
                        x:Name="BackButton"
                        AutomationProperties.AutomationId="StartBackButton"
                        HorizontalAlignment="Right"
                        Padding="10,4"
                        Click="BackButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE76B;" FontSize="10" />
                            <TextBlock Text="Back" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ListView
                    x:Name="AllAppsList"
                    Grid.Row="1"
                    AutomationProperties.AutomationId="AllAppsList"
                    AutomationProperties.Name="All apps"

                    ItemTemplate="{StaticResource ListItemTemplate}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="Item_Click">
                    <ListView.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" />
                    </ListView.GroupStyle>
                </ListView>
            </Grid>

            <!-- Search results: apps first, then files grouped by kind. -->
            <Grid x:Name="SearchView" Visibility="Collapsed">
                <ListView
                    x:Name="ResultsList"
                    AutomationProperties.AutomationId="SearchResults"
                    AutomationProperties.Name="Search results"

                    ItemTemplate="{StaticResource ListItemTemplate}"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="Item_Click">
                    <ListView.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" />
                    </ListView.GroupStyle>
                </ListView>
                <TextBlock
                    x:Name="NoResultsText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No results"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!-- User, Switch to Explorer, Settings, Power. -->
        <Grid
            Grid.Row="2"
            Padding="48,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <PersonPicture x:Name="UserPicture" Width="32" Height="32" />
                <TextBlock x:Name="UserName" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button
                    x:Name="SwitchToExplorerButton"
                    AutomationProperties.AutomationId="SwitchToExplorerButton"
                    AutomationProperties.Name="Switch to Explorer"
                    ToolTipService.ToolTip="Switch to Explorer"
                    Style="{StaticResource FlatButtonStyle}"
                    Click="SwitchToExplorerButton_Click">
                    <FontIcon Glyph="&#xE8AB;" FontSize="16" />
                </Button>
                <Button
                    AutomationProperties.AutomationId="SettingsButton"
                    AutomationProperties.Name="Settings"
                    ToolTipService.ToolTip="Settings"
                    Style="{StaticResource FlatButtonStyle}"
                    Click="SettingsButton_Click">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
                <Button
                    AutomationProperties.AutomationId="PowerButton"
                    AutomationProperties.Name="Power"
                    ToolTipService.ToolTip="Power"
                    Style="{StaticResource FlatButtonStyle}">
                    <FontIcon Glyph="&#xE7E8;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedRight">
                            <MenuFlyoutItem AutomationProperties.AutomationId="LockMenuItem" Text="Lock" Click="Lock_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem AutomationProperties.AutomationId="SignOutMenuItem" Text="Sign out" Click="SignOut_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xF3B1;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem AutomationProperties.AutomationId="SleepMenuItem" Text="Sleep" Click="Sleep_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE708;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem AutomationProperties.AutomationId="RestartMenuItem" Text="Restart" Click="Restart_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE777;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem AutomationProperties.AutomationId="ShutDownMenuItem" Text="Shut down" Click="ShutDown_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7E8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
