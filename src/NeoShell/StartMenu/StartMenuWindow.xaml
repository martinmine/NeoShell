<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NeoShell.StartMenu.StartMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoShell.StartMenu">

    <Grid x:Name="Root">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///FlatButtons.xaml" />
                </ResourceDictionary.MergedDictionaries>


                <!-- A row in All apps and in search results. -->
                <DataTemplate x:Key="ListItemTemplate" x:DataType="local:StartItem">
                    <Grid
                        Padding="4,6"
                        ColumnSpacing="12"
                        Background="Transparent"
                        AutomationProperties.AutomationId="StartListItem"
                        AutomationProperties.Name="{x:Bind Title}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.ContextFlyout>
                            <MenuFlyout Opening="ItemMenu_Opening" />
                        </Grid.ContextFlyout>
                        <Image Width="24" Height="24" Source="{x:Bind Icon, Mode=OneWay}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind Subtitle}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>

                <!-- A recent app: as Windows shows them, a bigger icon and when it was last started. -->
                <DataTemplate x:Key="RecentItemTemplate" x:DataType="local:StartItem">
                    <Grid
                        Padding="12,0"
                        ColumnSpacing="12"
                        Background="Transparent"
                        AutomationProperties.AutomationId="RecentApp"
                        AutomationProperties.Name="{x:Bind Title}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.ContextFlyout>
                            <MenuFlyout Opening="ItemMenu_Opening" />
                        </Grid.ContextFlyout>
                        <Image x:Name="ItemIcon" Width="32" Height="32" Source="{x:Bind Icon, Mode=OneWay}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind Subtitle}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>

                <!-- A row in All: icon and name only. -->
                <DataTemplate x:Key="AppItemTemplate" x:DataType="local:StartItem">
                    <Grid
                        Padding="4,2"
                        ColumnSpacing="12"
                        Background="Transparent"
                        AutomationProperties.AutomationId="StartListItem"
                        AutomationProperties.Name="{x:Bind Title}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.ContextFlyout>
                            <MenuFlyout Opening="ItemMenu_Opening" />
                        </Grid.ContextFlyout>
                        <Image Width="24" Height="24" Source="{x:Bind Icon, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>

                <DataTemplate x:Key="GroupHeaderTemplate" x:DataType="local:StartGroup">
                    <TextBlock Text="{x:Bind Key}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                </DataTemplate>

                <!-- Group headers without the default's divider line and tall row. -->
                <Style x:Key="GroupHeaderContainerStyle" TargetType="ListViewHeaderItem">
                    <Setter Property="Padding" Value="16,12,16,4" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewHeaderItem">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="32,16,32,8">
            <TextBox
                x:Name="SearchBox"
                AutomationProperties.AutomationId="StartSearchBox"
                AutomationProperties.Name="Search"
                Height="32"
                CornerRadius="16"
                Padding="42,6,12,0"
                PlaceholderText="Search for apps and documents"
                TextChanged="SearchBox_TextChanged"
                KeyDown="SearchBox_KeyDown" />
            <FontIcon
                Margin="16,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Glyph="&#xE721;"
                FontSize="14"
                IsHitTestVisible="False" />
        </Grid>

        <!--
            Home, as in Windows 11: pinned apps, then recent apps, on one scrolling page. Pinned apps start 8 further left
            than the rest, as in Explorer, so that's the padding; more would clip them.
        -->
        <ScrollViewer x:Name="HomeView" Grid.Row="1" Padding="32,0,24,16">
            <StackPanel>
                <Grid Margin="32,20,24,12">
                    <TextBlock Text="Pinned" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <Button
                        x:Name="AllAppsButton"
                        AutomationProperties.AutomationId="AllAppsButton"
                        HorizontalAlignment="Right"
                        Padding="10,4"
                        Click="AllAppsButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="All apps" FontSize="12" />
                            <FontIcon Glyph="&#xE76C;" FontSize="10" />
                        </StackPanel>
                    </Button>
                </Grid>
                <GridView
                    x:Name="PinnedGrid"
                    AutomationProperties.AutomationId="PinnedApps"
                    AutomationProperties.Name="Pinned"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="Item_Click"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <!-- Dragged by hand (see PinnedGrid_PointerPressed), without item transitions: the move at the drop
                         would be animated as a removal and an addition, and the icon vanish and come back. -->
                    <GridView.ItemContainerTransitions>
                        <TransitionCollection />
                    </GridView.ItemContainerTransitions>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:StartItem">
                            <StackPanel
                                Width="96"
                                Height="84"
                                Padding="4,12,4,4"
                                Spacing="4"
                                Background="Transparent"
                                AutomationProperties.AutomationId="PinnedApp"
                                AutomationProperties.Name="{x:Bind Title}">
                                <StackPanel.ContextFlyout>
                                    <MenuFlyout Opening="ItemMenu_Opening" />
                                </StackPanel.ContextFlyout>
                                <Image x:Name="ItemIcon" Width="32" Height="32" Source="{x:Bind Icon, Mode=OneWay}" />
                                <TextBlock
                                    Text="{x:Bind Title}"
                                    FontSize="12"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    MaxLines="2"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <TextBlock
                    x:Name="NoPinnedText"
                    Margin="32,8,0,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Pin apps from All apps to keep them here." />

                <StackPanel x:Name="RecentSection" Visibility="Collapsed">
                    <TextBlock Margin="32,28,0,15" Text="Recent" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <!--
                        Laid out as Explorer's: three columns 256 wide with 20 between the items, icons in line with the
                        heading. The last column's gap may hang off the right edge.
                    -->
                    <GridView
                        x:Name="RecentGrid"
                        Margin="20,0,-20,0"
                        AutomationProperties.AutomationId="RecentApps"
                        AutomationProperties.Name="Recent"
                        ItemTemplate="{StaticResource RecentItemTemplate}"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="Item_Click"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                                <Setter Property="Margin" Value="0,0,20,0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemWidth="256" ItemHeight="56" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- All apps, alphabetical. -->
        <Grid x:Name="AllAppsView" Grid.Row="1" Margin="40,0,40,8" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid Margin="24,20,8,12">
                <TextBlock Text="All apps" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <Button
                    x:Name="BackButton"
                    AutomationProperties.AutomationId="StartBackButton"
                    HorizontalAlignment="Right"
                    Padding="10,4"
                    Click="BackButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE76B;" FontSize="10" />
                        <TextBlock Text="Back" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>
            <ListView
                x:Name="AllAppsList"
                Grid.Row="1"
                AutomationProperties.AutomationId="AllAppsList"
                AutomationProperties.Name="All apps"
                ItemTemplate="{StaticResource AppItemTemplate}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="Item_Click">
                <ListView.GroupStyle>
                    <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" HeaderContainerStyle="{StaticResource GroupHeaderContainerStyle}" />
                </ListView.GroupStyle>
            </ListView>
        </Grid>

        <!-- Search results: apps first, then files grouped by kind. -->
        <Grid x:Name="SearchView" Grid.Row="1" Margin="40,8,40,8" Visibility="Collapsed">
            <ListView
                x:Name="ResultsList"
                AutomationProperties.AutomationId="SearchResults"
                AutomationProperties.Name="Search results"
                ItemTemplate="{StaticResource ListItemTemplate}"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="Item_Click">
                <ListView.GroupStyle>
                    <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" HeaderContainerStyle="{StaticResource GroupHeaderContainerStyle}" />
                </ListView.GroupStyle>
            </ListView>
            <TextBlock
                x:Name="NoResultsText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No results"
                Visibility="Collapsed" />
        </Grid>

        <!-- Corners to drag for resizing; the bottom stays on the taskbar. -->
        <local:ResizeGrip
            x:Name="LeftGrip"
            Grid.RowSpan="3"
            IsLeft="True"
            Width="16"
            Height="16"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Transparent"
            AutomationProperties.AutomationId="StartResizeGripLeft"
            AutomationProperties.Name="Resize Start"
            PointerPressed="Grip_PointerPressed"
            PointerMoved="Grip_PointerMoved"
            PointerReleased="Grip_PointerReleased"
            PointerCaptureLost="Grip_PointerReleased" />
        <local:ResizeGrip
            x:Name="RightGrip"
            Grid.RowSpan="3"
            Width="16"
            Height="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="Transparent"
            AutomationProperties.AutomationId="StartResizeGrip"
            AutomationProperties.Name="Resize Start"
            PointerPressed="Grip_PointerPressed"
            PointerMoved="Grip_PointerMoved"
            PointerReleased="Grip_PointerReleased"
            PointerCaptureLost="Grip_PointerReleased" />

        <!-- User, Switch to Explorer, Settings, Power. -->
        <Grid
            Grid.Row="2"
            Padding="64,12,48,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <PersonPicture x:Name="UserPicture" Width="32" Height="32" />
                <TextBlock x:Name="UserName" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button
                    x:Name="SwitchToExplorerButton"
                    AutomationProperties.AutomationId="SwitchToExplorerButton"
                    AutomationProperties.Name="Switch to Explorer"
                    ToolTipService.ToolTip="Switch to Explorer"
                    Style="{StaticResource FlatButtonStyle}"
                    Click="SwitchToExplorerButton_Click">
                    <FontIcon Glyph="&#xE8AB;" FontSize="16" />
                </Button>
                <Button
                    AutomationProperties.AutomationId="SettingsButton"
                    AutomationProperties.Name="Settings"
                    ToolTipService.ToolTip="Settings"
                    Style="{StaticResource FlatButtonStyle}"
                    Click="SettingsButton_Click">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
                <Button
                    AutomationProperties.AutomationId="PowerButton"
                    AutomationProperties.Name="Power"
                    ToolTipService.ToolTip="Power"
                    Style="{StaticResource FlatButtonStyle}">
                    <FontIcon Glyph="&#xE7E8;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedRight">
                            <MenuFlyoutItem AutomationProperties.AutomationId="LockMenuItem" Text="Lock" Click="Lock_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem AutomationProperties.AutomationId="SignOutMenuItem" Text="Sign out" Click="SignOut_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xF3B1;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem AutomationProperties.AutomationId="SleepMenuItem" Text="Sleep" Click="Sleep_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE708;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem AutomationProperties.AutomationId="RestartMenuItem" Text="Restart" Click="Restart_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE777;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem AutomationProperties.AutomationId="ShutDownMenuItem" Text="Shut down" Click="ShutDown_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7E8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
