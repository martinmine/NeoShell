<?xml version="1.0" encoding="utf-8"?>
<!--
    The notification center, as Explorer's: a heading with Do not disturb and Clear all, then the notifications by
    app, the newest app first. A group shows its newest notification with "+N notifications" until expanded.
-->
<UserControl
    x:Class="NeoShell.Notifications.NotificationPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:themes="using:NeoShell.Themes">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Padding="16,12,16,4" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <themes:Heading Text="Notifications" Subtitle="通知" Style="{StaticResource PlainHeadingStyle}" />
            <ToggleButton
                x:Name="DoNotDisturbButton"
                Grid.Column="1"
                Width="28"
                Height="26"
                Padding="0"
                AutomationProperties.AutomationId="DoNotDisturbButton"
                AutomationProperties.Name="Do not disturb"
                ToolTipService.ToolTip="Do not disturb"
                Click="DoNotDisturbButton_Click">
                <FontIcon Glyph="&#xF285;" FontSize="14" />
            </ToggleButton>
            <Button
                x:Name="ClearAllButton"
                Grid.Column="2"
                Height="26"
                Padding="8,0"
                FontSize="12"
                AutomationProperties.AutomationId="ClearAllNotificationsButton"
                Content="Clear all"
                Click="ClearAllButton_Click" />
        </Grid>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="1"
            Margin="0,24,0,40"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="No new notifications" />
        <ScrollViewer x:Name="Scroller" Grid.Row="1" Padding="6,0,6,6" HorizontalScrollMode="Disabled">
            <StackPanel x:Name="Groups" Spacing="4" />
        </ScrollViewer>

        <themes:Decoration Grid.RowSpan="2" Title="Notifications" Subtitle="通知" Style="{StaticResource PanelDecorationStyle}" />
    </Grid>
</UserControl>
