<?xml version="1.0" encoding="utf-8"?>
<local:WidgetView
    x:Class="NeoShell.Widgets.PicturesWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoShell.Widgets">
    <!-- The whole card, its corners rounded as the card's. Double-clicking opens the picture shown. -->
    <Grid Height="200" Background="Transparent" DoubleTapped="Picture_DoubleTapped">
        <Border x:Name="Picture" CornerRadius="8" AutomationProperties.AutomationId="PicturesWidgetImage" />
        <TextBlock
            x:Name="StatusText"
            Margin="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            AutomationProperties.AutomationId="PicturesWidgetStatus" />
    </Grid>
</local:WidgetView>
