<?xml version="1.0" encoding="utf-8"?>
<!-- One stock in the stocks widget: its symbol, name, price and change, and when expanded the day's chart. -->
<UserControl
    x:Class="NeoShell.Widgets.StockRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///FlatButtons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="2">
        <!-- Up in Windows' green, down in its red, as the theme has them. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Direction">
                <VisualState x:Name="Level" />
                <VisualState x:Name="Rise">
                    <VisualState.Setters>
                        <Setter Target="ChangeText.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="Line.Stroke" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Fall">
                    <VisualState.Setters>
                        <Setter Target="ChangeText.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="Line.Stroke" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Button
            x:Name="Header"
            Padding="4,2"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            CornerRadius="4"
            BorderThickness="0"
            Click="Header_Click">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="SymbolText" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="NameText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock x:Name="PriceText" HorizontalAlignment="Right" />
                    <TextBlock
                        x:Name="ChangeText"
                        HorizontalAlignment="Right"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <FontIcon x:Name="Chevron" Grid.Column="2" Glyph="&#xE70D;" FontSize="8" />
            </Grid>
        </Button>
        <!-- The day so far against the last close (the dashed line). -->
        <Grid
            x:Name="Graph"
            Height="56"
            Margin="4,0"
            CornerRadius="4"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            Visibility="Collapsed"
            SizeChanged="Graph_SizeChanged">
            <Line
                x:Name="CloseLine"
                Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                StrokeThickness="1"
                StrokeDashArray="3,3" />
            <Polyline
                x:Name="Line"
                Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                StrokeThickness="1.5"
                StrokeLineJoin="Round" />
        </Grid>
    </StackPanel>
</UserControl>
