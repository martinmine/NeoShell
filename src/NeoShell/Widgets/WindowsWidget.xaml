<?xml version="1.0" encoding="utf-8"?>
<local:WidgetView
    x:Class="NeoShell.Widgets.WindowsWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoShell.Widgets">
    <local:WidgetView.Resources>
        <Style x:Key="InfoTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </local:WidgetView.Resources>
    <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <!-- Windows 11's flag: four white panes, as tall as the text beside it. -->
        <Grid
            Width="82"
            Height="82"
            VerticalAlignment="Center"
            ColumnSpacing="4"
            RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Rectangle Fill="White" />
            <Rectangle Grid.Column="1" Fill="White" />
            <Rectangle Grid.Row="1" Fill="White" />
            <Rectangle Grid.Row="1" Grid.Column="1" Fill="White" />
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock
                x:Name="NameText"
                AutomationProperties.AutomationId="WindowsName"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="VersionText" AutomationProperties.AutomationId="WindowsVersion" Style="{StaticResource InfoTextStyle}" />
            <TextBlock x:Name="BuildText" AutomationProperties.AutomationId="WindowsBuild" Style="{StaticResource InfoTextStyle}" />
            <TextBlock x:Name="ArchitectureText" AutomationProperties.AutomationId="WindowsArchitecture" Style="{StaticResource InfoTextStyle}" />
            <TextBlock x:Name="InstalledText" AutomationProperties.AutomationId="WindowsInstalled" Style="{StaticResource InfoTextStyle}" />
        </StackPanel>
    </Grid>
</local:WidgetView>
