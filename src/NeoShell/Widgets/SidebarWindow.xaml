<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NeoShell.Widgets.SidebarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoShell.Widgets">

    <!-- Transparent, not null: right-clicks between the widgets open the sidebar's menu. -->
    <Grid x:Name="Root" Background="Transparent" ContextRequested="Root_ContextRequested">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///FlatButtons.xaml" />
                </ResourceDictionary.MergedDictionaries>

                <!-- See-through, so the menus' own backdrop shows (SetTheme). -->
                <Style x:Key="SidebarMenuPresenterStyle" TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <FlyoutBase.AttachedFlyout>
            <MenuFlyout x:Name="SidebarMenu" MenuFlyoutPresenterStyle="{StaticResource SidebarMenuPresenterStyle}" Opening="SidebarMenu_Opening">
                <ToggleMenuFlyoutItem
                    x:Name="ShowPanelItem"
                    AutomationProperties.AutomationId="ShowWidgetPanelMenuItem"
                    Text="Show panel background"
                    Click="ShowPanelItem_Click" />
                <MenuFlyoutSubItem x:Name="AddSubMenu" AutomationProperties.AutomationId="AddWidgetMenuItem" Text="Add widget" />
            </MenuFlyout>
        </FlyoutBase.AttachedFlyout>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Just the add button, which shows only while the pointer is over it (or its menu is open). -->
        <Grid x:Name="Header" Padding="8,4,8,0">
            <Button
                x:Name="AddButton"
                HorizontalAlignment="Right"
                Opacity="0"
                PointerEntered="AddButton_PointerEntered"
                PointerExited="AddButton_PointerExited"
                AutomationProperties.AutomationId="AddWidgetButton"
                AutomationProperties.Name="Add widget"
                ToolTipService.ToolTip="Add widget"
                Style="{StaticResource FlatButtonStyle}"
                Width="32"
                Height="32">
                <FontIcon Glyph="&#xE710;" FontSize="14" />
                <Button.Flyout>
                    <MenuFlyout
                        x:Name="AddMenu"
                        Placement="BottomEdgeAlignedRight"
                        MenuFlyoutPresenterStyle="{StaticResource SidebarMenuPresenterStyle}"
                        Opening="AddMenu_Opening"
                        Closed="AddMenu_Closed" />
                </Button.Flyout>
            </Button>
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" AutomationProperties.AutomationId="WidgetSidebarScroller">
            <!-- No spacing: each card keeps its own gap below (CardGap), so a lifted one leaves none. -->
            <StackPanel x:Name="Cards" Padding="12,8,12,0">
                <!-- The cards slide aside for a widget dragged over them, and back. -->
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <!-- Where a widget dragged over the sidebar would go; moved among the cards while it's dragged. -->
                <Border
                    x:Name="DropSlot"
                    Margin="0,0,0,12"
                    CornerRadius="8"
                    BorderThickness="1"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <!-- Dragging the left edge resizes the sidebar; its width is set for the monitor (SidebarLayout.GripWidth). -->
        <local:EdgeGrip
            x:Name="Grip"
            Grid.RowSpan="2"
            Width="14"
            HorizontalAlignment="Left"
            Background="Transparent"
            AutomationProperties.AutomationId="WidgetSidebarGrip"
            PointerPressed="Grip_PointerPressed"
            PointerMoved="Grip_PointerMoved"
            PointerReleased="Grip_PointerReleased"
            PointerCaptureLost="Grip_PointerCaptureLost" />
    </Grid>
</Window>
