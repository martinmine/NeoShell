<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NeoShell.Widgets.SidebarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoShell.Widgets">

    <!-- Transparent, not null: right-clicks between the widgets open the sidebar's menu. -->
    <Grid x:Name="Root" Background="Transparent" ContextRequested="Root_ContextRequested">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///FlatButtons.xaml" />
                </ResourceDictionary.MergedDictionaries>

                <!-- See-through, so the menus' own backdrop shows (SetTheme). -->
                <Style x:Key="SidebarMenuPresenterStyle" TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <FlyoutBase.AttachedFlyout>
            <MenuFlyout x:Name="SidebarMenu" MenuFlyoutPresenterStyle="{StaticResource SidebarMenuPresenterStyle}" Opening="SidebarMenu_Opening">
                <ToggleMenuFlyoutItem
                    x:Name="ShowPanelItem"
                    AutomationProperties.AutomationId="ShowWidgetPanelMenuItem"
                    Text="Show panel background"
                    Click="ShowPanelItem_Click" />
                <MenuFlyoutSubItem x:Name="AddSubMenu" AutomationProperties.AutomationId="AddWidgetMenuItem" Text="Add widget" />
            </MenuFlyout>
        </FlyoutBase.AttachedFlyout>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid x:Name="Header" Padding="16,8,8,0">
            <TextBlock Text="Widgets" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Button
                x:Name="AddButton"
                HorizontalAlignment="Right"
                AutomationProperties.AutomationId="AddWidgetButton"
                AutomationProperties.Name="Add widget"
                ToolTipService.ToolTip="Add widget"
                Style="{StaticResource FlatButtonStyle}"
                Width="32"
                Height="32">
                <FontIcon Glyph="&#xE710;" FontSize="14" />
                <Button.Flyout>
                    <MenuFlyout
                        x:Name="AddMenu"
                        Placement="BottomEdgeAlignedRight"
                        MenuFlyoutPresenterStyle="{StaticResource SidebarMenuPresenterStyle}"
                        Opening="AddMenu_Opening" />
                </Button.Flyout>
            </Button>
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" AutomationProperties.AutomationId="WidgetSidebarScroller">
            <StackPanel x:Name="Cards" Padding="12,8,12,12" Spacing="12" />
        </ScrollViewer>

        <!-- Dragging the left edge resizes the sidebar. -->
        <local:EdgeGrip
            x:Name="Grip"
            Grid.RowSpan="2"
            Width="6"
            HorizontalAlignment="Left"
            Background="Transparent"
            AutomationProperties.AutomationId="WidgetSidebarGrip"
            PointerPressed="Grip_PointerPressed"
            PointerMoved="Grip_PointerMoved"
            PointerReleased="Grip_PointerReleased"
            PointerCaptureLost="Grip_PointerCaptureLost" />
    </Grid>
</Window>
