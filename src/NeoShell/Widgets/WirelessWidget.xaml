<?xml version="1.0" encoding="utf-8"?>
<local:WidgetView
    x:Class="NeoShell.Widgets.WirelessWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoShell.Widgets">
    <StackPanel Spacing="4">
        <TextBlock
            Height="28"
            Margin="4,0"
            Text="Wireless devices"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <StackPanel x:Name="Rows" AutomationProperties.AutomationId="WirelessDeviceList" />
        <TextBlock
            x:Name="StatusText"
            Margin="4,0"
            AutomationProperties.AutomationId="WirelessStatus"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Text="Looking for devices…" />
    </StackPanel>
</local:WidgetView>
