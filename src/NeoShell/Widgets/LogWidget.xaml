<?xml version="1.0" encoding="utf-8"?>
<local:WidgetView
    x:Class="NeoShell.Widgets.LogWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoShell.Widgets">
    <!-- A line's parts (CreateLine), coloured by the window's theme. -->
    <local:WidgetView.Resources>
        <Style x:Key="LogTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="LogTimeStyle" TargetType="TextBlock" BasedOn="{StaticResource LogTextStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="LogInfoStyle" TargetType="TextBlock" BasedOn="{StaticResource LogTextStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="LogWindowStyle" TargetType="TextBlock" BasedOn="{StaticResource LogTextStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="LogOpenStyle" TargetType="TextBlock" BasedOn="{StaticResource LogTextStyle}">
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="LogWarnStyle" TargetType="TextBlock" BasedOn="{StaticResource LogTextStyle}">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>
        <Style x:Key="LogErrorStyle" TargetType="TextBlock" BasedOn="{StaticResource LogTextStyle}">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </local:WidgetView.Resources>

    <StackPanel Spacing="4">
        <TextBlock Margin="4,0" Text="Event log" Style="{StaticResource WidgetTitleStyle}" />
        <!-- Newest at the bottom, as in a terminal; new lines slide in and push the others up. -->
        <StackPanel x:Name="Lines" AutomationProperties.AutomationId="LogLines">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="0" FromHorizontalOffset="24" />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <StackPanel.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Cursor" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.55" Value="0" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:1.1" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </StackPanel.Triggers>
            <TextBlock Text="&gt; " Style="{StaticResource LogOpenStyle}" />
            <TextBlock x:Name="Cursor" Text="&#x2588;" Style="{StaticResource LogOpenStyle}" />
        </StackPanel>
    </StackPanel>
</local:WidgetView>
