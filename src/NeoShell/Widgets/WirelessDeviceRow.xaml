<?xml version="1.0" encoding="utf-8"?>
<!-- One device in the wireless devices widget: its kind, name, battery bar and level, as WirelessStatus shows them. -->
<UserControl
    x:Class="NeoShell.Widgets.WirelessDeviceRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Padding="4,4" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon x:Name="KindIcon" FontSize="16" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
            <TextBlock x:Name="NameText" FontSize="12" TextTrimming="CharacterEllipsis" />
            <ProgressBar x:Name="Bar" Maximum="100" />
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
            <FontIcon x:Name="ChargingIcon" Glyph="&#xE945;" FontSize="12" ToolTipService.ToolTip="Charging" />
            <TextBlock
                x:Name="LevelText"
                MinWidth="32"
                FontSize="12"
                TextAlignment="Right"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
