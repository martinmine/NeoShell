<?xml version="1.0" encoding="utf-8"?>
<local:WidgetView
    x:Class="NeoShell.Widgets.StocksWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoShell.Widgets">
    <!-- No heading: the widget's buttons show over the top right while the pointer is near them (ContentUnderButtons). -->
    <StackPanel Spacing="4">
        <StackPanel x:Name="Rows" AutomationProperties.AutomationId="StockList" Spacing="2" />
        <TextBlock
            x:Name="StatusText"
            Margin="4,0"
            AutomationProperties.AutomationId="StocksStatus"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Text="Loading…" />
    </StackPanel>
</local:WidgetView>
