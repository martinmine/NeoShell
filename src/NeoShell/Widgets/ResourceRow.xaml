<?xml version="1.0" encoding="utf-8"?>
<!-- One resource in the resource usage widget: its name and use, a bar, and when expanded the last minute's graph. -->
<UserControl
    x:Class="NeoShell.Widgets.ResourceRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///FlatButtons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="2">
        <Button
            x:Name="Header"
            Padding="4,2"
            FontSize="12"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            CornerRadius="4"
            BorderThickness="0"
            Click="Header_Click">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LabelText" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ValueText" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <FontIcon x:Name="Chevron" Grid.Column="2" Glyph="&#xE70D;" FontSize="8" />
            </Grid>
        </Button>
        <!--
            Drawn as a ProgressBar looks rather than one: a ProgressBar animates every change of value, which for
            bars updated each second kept the compositor drawing nearly all the time.
        -->
        <Grid x:Name="Bar" Height="3" Margin="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="BarFilled" Width="0*" />
                <ColumnDefinition x:Name="BarEmpty" Width="100*" />
            </Grid.ColumnDefinitions>
            <Rectangle
                Grid.ColumnSpan="2"
                Height="1"
                VerticalAlignment="Center"
                Fill="{ThemeResource ProgressBarBackground}" />
            <Rectangle x:Name="BarFill" RadiusX="1.5" RadiusY="1.5" />
        </Grid>
        <Grid
            x:Name="Graph"
            Height="56"
            Margin="4,0"
            CornerRadius="4"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            Visibility="Collapsed"
            SizeChanged="Graph_SizeChanged">
            <Polygon x:Name="Area" />
            <Polyline x:Name="Line" StrokeThickness="1.5" StrokeLineJoin="Round" />
        </Grid>
    </StackPanel>
</UserControl>
