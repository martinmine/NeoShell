<?xml version="1.0" encoding="utf-8"?>
<!-- One resource in the resource usage widget: its name and use, a bar, and when expanded the last minute's graph. -->
<UserControl
    x:Class="NeoShell.Widgets.ResourceRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///FlatButtons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="2">
        <Button
            x:Name="Header"
            Padding="4,2"
            FontSize="12"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            CornerRadius="4"
            BorderThickness="0"
            Click="Header_Click">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LabelText" />
                <TextBlock x:Name="ValueText" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <FontIcon x:Name="Chevron" Grid.Column="2" Glyph="&#xE70D;" FontSize="8" />
            </Grid>
        </Button>
        <ProgressBar x:Name="Bar" Margin="4,0" Maximum="100" />
        <Grid
            x:Name="Graph"
            Height="56"
            Margin="4,0"
            CornerRadius="4"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            Visibility="Collapsed"
            SizeChanged="Graph_SizeChanged">
            <Polygon x:Name="Area" />
            <Polyline x:Name="Line" StrokeThickness="1.5" StrokeLineJoin="Round" />
        </Grid>
    </StackPanel>
</UserControl>
