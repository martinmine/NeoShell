<?xml version="1.0" encoding="utf-8"?>
<local:WidgetView
    x:Class="NeoShell.Widgets.PuzzleWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoShell.Widgets">
    <local:WidgetView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///FlatButtons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TileButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Margin" Value="1" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Margin" Value="0" />
            </Style>
        </ResourceDictionary>
    </local:WidgetView.Resources>

    <!-- No heading: the widget's buttons show over the top right while the pointer is over it. -->
    <StackPanel Spacing="6">
        <!-- Square, as wide as the card. The tiles slide to their places. -->
        <Grid x:Name="BoardArea" SizeChanged="BoardArea_SizeChanged">
            <Grid x:Name="Board" AutomationProperties.AutomationId="PuzzleBoard">
                <Grid.ChildrenTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </Grid.ChildrenTransitions>
            </Grid>
            <!-- The whole picture: while the peek button is held, and once solved. -->
            <Border x:Name="WholePicture" Margin="1" CornerRadius="4" Visibility="Collapsed" IsHitTestVisible="False">
                <Image x:Name="WholeImage" Stretch="UniformToFill" />
            </Border>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TimeText"
                AutomationProperties.AutomationId="PuzzleTime"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button
                x:Name="PeekButton"
                Grid.Column="1"
                AutomationProperties.AutomationId="PuzzlePeekButton"
                AutomationProperties.Name="Show the picture"
                ToolTipService.ToolTip="Hold to see the picture"
                Style="{StaticResource ToolButtonStyle}">
                <FontIcon Glyph="&#xE890;" FontSize="14" />
            </Button>
            <Button
                Grid.Column="2"
                AutomationProperties.AutomationId="PuzzleShuffleButton"
                AutomationProperties.Name="Shuffle"
                ToolTipService.ToolTip="Shuffle"
                Style="{StaticResource ToolButtonStyle}"
                Click="ShuffleButton_Click">
                <FontIcon Glyph="&#xE8B1;" FontSize="14" />
            </Button>
        </Grid>
    </StackPanel>
</local:WidgetView>
