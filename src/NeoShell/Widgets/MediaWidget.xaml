<?xml version="1.0" encoding="utf-8"?>
<local:WidgetView
    x:Class="NeoShell.Widgets.MediaWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoShell.Widgets">
    <local:WidgetView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///FlatButtons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Flat while there's nothing to control, too. -->
            <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
        </ResourceDictionary>
    </local:WidgetView.Resources>

    <StackPanel Spacing="8">
        <TextBlock
            Height="28"
            Text="Now playing"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <!-- The art, over a note that shows without any. -->
            <Grid x:Name="Artwork" Width="64" Height="64">
                <Border CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <FontIcon Glyph="&#xE8D6;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <Border x:Name="ArtImage" CornerRadius="4" Visibility="Collapsed" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    x:Name="TitleText"
                    AutomationProperties.AutomationId="MediaTitle"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    Text="Nothing playing" />
                <TextBlock
                    x:Name="ArtistText"
                    AutomationProperties.AutomationId="MediaArtist"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
            <Button
                x:Name="PreviousButton"
                AutomationProperties.AutomationId="MediaPreviousButton"
                AutomationProperties.Name="Previous"
                ToolTipService.ToolTip="Previous"
                Style="{StaticResource FlatButtonStyle}"
                IsEnabled="False"
                Click="PreviousButton_Click">
                <FontIcon Glyph="&#xE892;" FontSize="16" />
            </Button>
            <Button
                x:Name="PlayPauseButton"
                AutomationProperties.AutomationId="MediaPlayPauseButton"
                AutomationProperties.Name="Play"
                ToolTipService.ToolTip="Play"
                Style="{StaticResource FlatButtonStyle}"
                IsEnabled="False"
                Click="PlayPauseButton_Click">
                <FontIcon x:Name="PlayPauseGlyph" Glyph="&#xE768;" FontSize="16" />
            </Button>
            <Button
                x:Name="NextButton"
                AutomationProperties.AutomationId="MediaNextButton"
                AutomationProperties.Name="Next"
                ToolTipService.ToolTip="Next"
                Style="{StaticResource FlatButtonStyle}"
                IsEnabled="False"
                Click="NextButton_Click">
                <FontIcon Glyph="&#xE893;" FontSize="16" />
            </Button>
        </StackPanel>
    </StackPanel>
</local:WidgetView>
