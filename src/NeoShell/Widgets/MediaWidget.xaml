<?xml version="1.0" encoding="utf-8"?>
<local:WidgetView
    x:Class="NeoShell.Widgets.MediaWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoShell.Widgets">
    <local:WidgetView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///FlatButtons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Flat while there's nothing to control, too. -->
            <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />

            <Style x:Key="MediaButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Margin" Value="0" />
            </Style>
        </ResourceDictionary>
    </local:WidgetView.Resources>

    <!-- No heading: the widget's buttons show over the top right while the pointer is over it. -->
    <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <!-- The art, over a note that shows without any. -->
        <Grid x:Name="Artwork" Width="64" Height="64">
            <Border CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <FontIcon Glyph="&#xE8D6;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
            <Border x:Name="ArtImage" CornerRadius="4" Visibility="Collapsed" />
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock
                x:Name="TitleText"
                AutomationProperties.AutomationId="MediaTitle"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                Text="Nothing playing" />
            <TextBlock
                x:Name="ArtistText"
                AutomationProperties.AutomationId="MediaArtist"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis" />
            <StackPanel Margin="-6,2,0,0" Orientation="Horizontal">
                <Button
                    x:Name="PreviousButton"
                    AutomationProperties.AutomationId="MediaPreviousButton"
                    AutomationProperties.Name="Previous"
                    ToolTipService.ToolTip="Previous"
                    Style="{StaticResource MediaButtonStyle}"
                    IsEnabled="False"
                    Click="PreviousButton_Click">
                    <FontIcon Glyph="&#xE892;" FontSize="14" />
                </Button>
                <Button
                    x:Name="PlayPauseButton"
                    AutomationProperties.AutomationId="MediaPlayPauseButton"
                    AutomationProperties.Name="Play"
                    ToolTipService.ToolTip="Play"
                    Style="{StaticResource MediaButtonStyle}"
                    IsEnabled="False"
                    Click="PlayPauseButton_Click">
                    <FontIcon x:Name="PlayPauseGlyph" Glyph="&#xE768;" FontSize="14" />
                </Button>
                <Button
                    x:Name="NextButton"
                    AutomationProperties.AutomationId="MediaNextButton"
                    AutomationProperties.Name="Next"
                    ToolTipService.ToolTip="Next"
                    Style="{StaticResource MediaButtonStyle}"
                    IsEnabled="False"
                    Click="NextButton_Click">
                    <FontIcon Glyph="&#xE893;" FontSize="14" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</local:WidgetView>
