<?xml version="1.0" encoding="utf-8"?>
<local:WidgetView
    x:Class="NeoShell.Widgets.WeatherWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoShell.Widgets">
    <StackPanel Spacing="8">
        <TextBlock
            Height="28"
            Text="Weather"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <Grid x:Name="Current" ColumnSpacing="12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="NowSymbol" FontSize="40" VerticalAlignment="Center" />
            <TextBlock
                x:Name="NowTemperature"
                Grid.Column="1"
                AutomationProperties.AutomationId="WeatherTemperature"
                FontSize="36"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Name="NowDescription" AutomationProperties.AutomationId="WeatherDescription" TextWrapping="Wrap" />
                <TextBlock x:Name="NowWind" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- The next hours, one column each. -->
        <Grid x:Name="Hours" Visibility="Collapsed" />

        <TextBlock
            x:Name="StatusText"
            AutomationProperties.AutomationId="WeatherStatus"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Text="Loading…" />

        <TextBlock
            Text="Data from MET Norway"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
    </StackPanel>
</local:WidgetView>
