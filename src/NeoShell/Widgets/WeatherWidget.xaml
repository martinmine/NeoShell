<?xml version="1.0" encoding="utf-8"?>
<local:WidgetView
    x:Class="NeoShell.Widgets.WeatherWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoShell.Widgets">
    <!-- No heading: the widget's buttons show over the top right while the pointer is over it. -->
    <StackPanel Spacing="8">
        <Grid x:Name="Current" ColumnSpacing="8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="NowSymbol" FontSize="28" VerticalAlignment="Center" />
            <TextBlock
                x:Name="NowTemperature"
                Grid.Column="1"
                AutomationProperties.AutomationId="WeatherTemperature"
                FontSize="28"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Center">
                <TextBlock
                    x:Name="NowDescription"
                    AutomationProperties.AutomationId="WeatherDescription"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="NowWind"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- The next hours, one column each. -->
        <Grid x:Name="Hours" Visibility="Collapsed" />

        <TextBlock
            x:Name="StatusText"
            Margin="0,0,64,0"
            AutomationProperties.AutomationId="WeatherStatus"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Text="Loading…" />
    </StackPanel>
</local:WidgetView>
