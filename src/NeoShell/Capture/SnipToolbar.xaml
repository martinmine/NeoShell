<?xml version="1.0" encoding="utf-8"?>
<!--
    The snip overlay's toolbar, as Snipping Tool's at the top centre of the primary monitor: snip or record, the
    snipping area and close. Recording, quick mark-up, the colour picker and the text extractor aren't NeoShell's:
    the switch shows recording unavailable, and the others are left out.
-->
<UserControl
    x:Class="NeoShell.Capture.SnipToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoShell.Capture">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///FlatButtons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Measured on Snipping Tool's: the border and the separators are white (black in light mode) at 20 and 10 %. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SnipToolbarBorderBrush" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="SnipToolbarSeparatorBrush" Color="#19FFFFFF" />
                    <StaticResource x:Key="ComboBoxBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SnipToolbarBorderBrush" Color="#33000000" />
                    <SolidColorBrush x:Key="SnipToolbarSeparatorBrush" Color="#19000000" />
                    <StaticResource x:Key="ComboBoxBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Background="{ThemeResource SystemControlAcrylicElementBrush}"
        BorderBrush="{ThemeResource SnipToolbarBorderBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="8,4">
        <StackPanel Orientation="Horizontal">
            <!-- Snip (on) or record, as Snipping Tool's switch; recording needs Explorer, so it's shown unavailable. -->
            <Grid
                Width="76"
                Height="32"
                CornerRadius="4"
                BorderThickness="1"
                Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                AutomationProperties.AutomationId="SnipCaptureModeSwitch"
                AutomationProperties.Name="Capture mode set to snipping"
                ToolTipService.ToolTip="Snip"
                ToolTipService.Placement="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border
                    Margin="-1,-1,0,-1"
                    CornerRadius="4"
                    BorderThickness="1"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlElevationBorderBrush}" />
                <FontIcon Glyph="&#xE722;" FontSize="16" />
                <Rectangle
                    Width="16"
                    Height="3"
                    RadiusX="1.5"
                    RadiusY="1.5"
                    VerticalAlignment="Bottom"
                    Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                <FontIcon Grid.Column="1" Glyph="&#xE714;" FontSize="16" Foreground="{ThemeResource TextFillColorDisabledBrush}" />
            </Grid>

            <!-- Only the mode's glyph fits when closed; the list shows glyphs and names. -->
            <ComboBox
                x:Name="ModeBox"
                Width="64"
                Height="40"
                Margin="4,0,0,0"
                Padding="16,0,0,0"
                VerticalAlignment="Center"
                BorderThickness="0"
                AutomationProperties.AutomationId="SnipModeBox"
                AutomationProperties.Name="Snipping Area Drop-down Menu"
                ToolTipService.ToolTip="Snipping area"
                ToolTipService.Placement="Bottom"
                Loaded="ModeBox_Loaded"
                SelectionChanged="ModeBox_SelectionChanged">
                <!-- Snipping Tool's list is 8 pixels wider than its names need. -->
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
                        <Setter Property="Padding" Value="11,5,19,7" />
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="local:SnipModeChoice">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                            <TextBlock Text="{x:Bind Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Rectangle
                Width="1"
                Height="24"
                Margin="4,0,8,0"
                VerticalAlignment="Center"
                Fill="{ThemeResource SnipToolbarSeparatorBrush}" />

            <Button
                x:Name="CloseButton"
                Style="{StaticResource FlatButtonStyle}"
                Width="32"
                Height="32"
                Margin="0"
                AutomationProperties.AutomationId="SnipCloseButton"
                AutomationProperties.Name="Close"
                ToolTipService.ToolTip="Close (Esc)"
                ToolTipService.Placement="Bottom"
                Click="CloseButton_Click">
                <FontIcon Glyph="&#xE711;" FontSize="16" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
