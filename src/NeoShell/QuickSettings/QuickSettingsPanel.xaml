<?xml version="1.0" encoding="utf-8"?>
<!--
    Quick Settings, as Windows 11 lays it out: pages of tiles, the volume slider and a footer; tiles with a chevron
    and the volume's button open pages that slide in from the right, each with a back button and a link to Settings.
-->
<UserControl
    x:Class="NeoShell.QuickSettings.QuickSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoShell.QuickSettings"
    xmlns:tray="using:NeoShell.Tray">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///FlatButtons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A tile, or half of a split tile: accent-filled while its feature is on. -->
            <Style x:Key="TileButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Height" Value="48" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="BackButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="AutomationProperties.Name" Value="Back" />
                <Setter Property="ToolTipService.ToolTip" Value="Back" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="4,8,0,8" />
            </Style>

            <!-- The bar at the bottom of a page, with its link to Settings: 48 high, as Windows'. -->
            <Style x:Key="PageFooterStyle" TargetType="Border">
                <Setter Property="Height" Value="48" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="Background" Value="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
            </Style>

            <Style x:Key="FooterLinkStyle" TargetType="Button">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- An accessibility feature: glyph, name and description, and its switch with its state in words. -->
            <DataTemplate x:Key="AssistiveRowTemplate" x:DataType="local:AssistiveFeature">
                <Grid Padding="4,8" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Name}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Top" Margin="0,2,0,0" FontSize="16" Glyph="{x:Bind Glyph}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Description}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind StateText, Mode=OneWay}" Visibility="{x:Bind SwitchVisibility}" />
                        <ToggleSwitch
                            MinWidth="0"
                            OnContent=""
                            OffContent=""
                            AutomationProperties.AutomationId="{x:Bind AutomationId}"
                            AutomationProperties.Name="{x:Bind Name}"
                            Visibility="{x:Bind SwitchVisibility}"
                            IsOn="{x:Bind IsOn, Mode=TwoWay}" />
                        <!-- Features Windows offers no way to switch from outside Settings: a link to their page. -->
                        <Button
                            Style="{StaticResource FlatButtonStyle}"
                            Width="32"
                            Height="32"
                            AutomationProperties.AutomationId="{x:Bind AutomationId}"
                            AutomationProperties.Name="{x:Bind LinkName}"
                            ToolTipService.ToolTip="{x:Bind LinkName}"
                            Visibility="{x:Bind LinkVisibility}"
                            Click="AssistiveLink_Click">
                            <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Width="360">
        <!-- Tiles, volume and footer. -->
        <Grid x:Name="MainPage">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Three tiles of 96 with gaps of 12 from the left edge's 24; the page dots sit in the right margin. -->
            <Grid Height="212" Background="Transparent" PointerWheelChanged="Tiles_PointerWheelChanged">
                <ItemsControl
                    x:Name="TileGrid"
                    Width="324"
                    Margin="24,22,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    IsTabStop="False"
                    AutomationProperties.AutomationId="QuickSettingsTiles">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemWidth="108" ItemHeight="96" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:QuickTile">
                            <StackPanel Width="96" HorizontalAlignment="Left" Spacing="8">
                                <!-- A split tile's halves touch: their borders make Windows' 2-pixel divider. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton
                                        Grid.ColumnSpan="{x:Bind MainColumnSpan, Mode=OneWay}"
                                        Style="{StaticResource TileButtonStyle}"
                                        CornerRadius="{x:Bind MainCornerRadius, Mode=OneWay}"
                                        AutomationProperties.AutomationId="{x:Bind TileId}"
                                        AutomationProperties.Name="{x:Bind Name}"
                                        ToolTipService.ToolTip="{x:Bind Name}"
                                        IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                                        IsChecked="{x:Bind IsOn, Mode=OneWay}"
                                        Click="Tile_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="{x:Bind GlyphSize, Mode=OneWay}" />
                                            <FontIcon Glyph="&#xE76C;" FontSize="10" Visibility="{x:Bind InlineChevronVisibility, Mode=OneWay}" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton
                                        Grid.Column="1"
                                        Style="{StaticResource TileButtonStyle}"
                                        CornerRadius="0,4,4,0"
                                        AutomationProperties.AutomationId="{x:Bind PageId}"
                                        AutomationProperties.Name="{x:Bind PageName}"
                                        ToolTipService.ToolTip="{x:Bind PageName}"
                                        Visibility="{x:Bind SplitVisibility, Mode=OneWay}"
                                        IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                                        IsChecked="{x:Bind IsOn, Mode=OneWay}"
                                        Click="TilePage_Click">
                                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                    </ToggleButton>
                                </Grid>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{x:Bind Label, Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Which page of tiles is shown; the arrows turn them, as the mouse wheel does. -->
                <StackPanel Width="20" Margin="0,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
                    <Button
                        x:Name="PreviousTilesButton"
                        AutomationProperties.AutomationId="PreviousTilesButton"
                        AutomationProperties.Name="Previous page"
                        Style="{StaticResource FlatButtonStyle}"
                        Width="20"
                        Height="20"
                        Margin="0"
                        Click="PreviousTiles_Click">
                        <FontIcon Glyph="&#xEDDB;" FontSize="8" />
                    </Button>
                    <StackPanel x:Name="PageDots" HorizontalAlignment="Center" Spacing="6" />
                    <Button
                        x:Name="NextTilesButton"
                        AutomationProperties.AutomationId="NextTilesButton"
                        AutomationProperties.Name="Next page"
                        Style="{StaticResource FlatButtonStyle}"
                        Width="20"
                        Height="20"
                        Margin="0"
                        Click="NextTiles_Click">
                        <FontIcon Glyph="&#xEDDC;" FontSize="8" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- The sliders: brightness (where the screen's can be set) over volume, the two slider tracks lined up. -->
            <Grid
                Grid.Row="1"
                Padding="12,16"
                ColumnSpacing="4"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <FontIcon
                    x:Name="BrightnessIcon"
                    Width="40"
                    Height="40"
                    Margin="2,0,2,8"
                    FontSize="16"
                    Glyph="&#xE706;"
                    Visibility="Collapsed" />
                <Slider
                    x:Name="BrightnessSlider"
                    Grid.Column="1"
                    Margin="4,0,4,8"
                    AutomationProperties.AutomationId="BrightnessSlider"
                    AutomationProperties.Name="Brightness"
                    Minimum="0"
                    Maximum="100"
                    StepFrequency="1"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    ValueChanged="BrightnessSlider_ValueChanged" />
                <Button
                    x:Name="MuteButton"
                    Grid.Row="1"
                    AutomationProperties.AutomationId="MuteButton"
                    Style="{StaticResource FlatButtonStyle}"
                    Click="Mute_Click">
                    <FontIcon x:Name="MuteIcon" FontSize="16" />
                </Button>
                <Slider
                    x:Name="VolumeSlider"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="4,0"
                    AutomationProperties.AutomationId="VolumeSlider"
                    AutomationProperties.Name="Volume"
                    Minimum="0"
                    Maximum="100"
                    StepFrequency="1"
                    VerticalAlignment="Center"
                    ValueChanged="VolumeSlider_ValueChanged" />
                <Button
                    Grid.Row="1"
                    Grid.Column="2"
                    AutomationProperties.AutomationId="SoundOutputButton"
                    AutomationProperties.Name="Select a sound output"
                    ToolTipService.ToolTip="Select a sound output"
                    Style="{StaticResource FlatButtonStyle}"
                    Width="Auto"
                    Padding="8,0"
                    Click="SoundOutputButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xF4C3;" FontSize="16" />
                        <FontIcon Glyph="&#xE76C;" FontSize="10" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid
                Grid.Row="2"
                Height="48"
                Padding="12,0,8,0"
                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <StackPanel
                    x:Name="BatteryInfo"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="BatteryInfo">
                    <FontIcon x:Name="BatteryIcon" FontSize="16" />
                    <TextBlock x:Name="BatteryText" VerticalAlignment="Center" />
                </StackPanel>
                <Button
                    HorizontalAlignment="Right"
                    AutomationProperties.AutomationId="AllSettingsButton"
                    AutomationProperties.Name="All settings"
                    ToolTipService.ToolTip="All settings"
                    Style="{StaticResource FlatButtonStyle}"
                    Width="32"
                    Height="32"
                    Click="AllSettings_Click">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
            </Grid>
        </Grid>

        <!-- Sound output: output device, spatial sound and the volume mixer. -->
        <Grid x:Name="SoundOutputPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Padding="8,8,12,4" Orientation="Horizontal" Spacing="8">
                <Button AutomationProperties.AutomationId="SoundOutputBackButton" Style="{StaticResource BackButtonStyle}" Click="Back_Click">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Sound output" />
                <local:ShortcutKeys Shortcut="Ctrl V" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" MaxHeight="440" Padding="12,0,12,8" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Output device" />
                    <ListView
                        x:Name="OutputDevices"
                        AutomationProperties.AutomationId="OutputDeviceList"
                        AutomationProperties.Name="Output device"
                        SelectionMode="Single"
                        SelectionChanged="OutputDevices_SelectionChanged" />
                    <StackPanel x:Name="SpatialSection">
                        <Rectangle Height="1" Margin="0,8" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Spatial sound" />
                        <ListView
                            x:Name="SpatialFormats"
                            AutomationProperties.AutomationId="SpatialSoundList"
                            AutomationProperties.Name="Spatial sound"
                            SelectionMode="Single"
                            SelectionChanged="SpatialFormats_SelectionChanged" />
                    </StackPanel>
                    <Rectangle Height="1" Margin="0,8" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Margin="4,4,0,4">
                        <TextBlock VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Volume mixer" />
                        <Button
                            HorizontalAlignment="Right"
                            AutomationProperties.AutomationId="VolumeMixerSettingsButton"
                            AutomationProperties.Name="Volume mixer settings"
                            ToolTipService.ToolTip="Volume mixer settings"
                            Style="{StaticResource FlatButtonStyle}"
                            Width="32"
                            Height="32"
                            Click="OpenVolumeMixer_Click">
                            <FontIcon Glyph="&#xE713;" FontSize="14" />
                        </Button>
                    </Grid>
                    <!-- Each app playing sound: its icon mutes it, the slider sets its volume. -->
                    <ItemsControl
                        x:Name="MixerList"
                        AutomationProperties.AutomationId="VolumeMixer"
                        AutomationProperties.Name="Volume mixer">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="tray:MixerApp">
                                <Grid ColumnSpacing="4" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Width="40"
                                        Height="40"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        AutomationProperties.AutomationId="MixerMuteButton"
                                        AutomationProperties.Name="{x:Bind MuteName, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}"
                                        Click="MixerMute_Click">
                                        <Grid Width="20" Height="20">
                                            <Image Source="{x:Bind Icon, Mode=OneWay}" Visibility="{x:Bind IconVisibility, Mode=OneWay}" />
                                            <FontIcon Glyph="&#xE7F5;" FontSize="16" Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                                            <!-- Muted: a crossed-out speaker over the icon's corner. -->
                                            <Border
                                                Margin="0,0,-5,-5"
                                                Padding="1"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                CornerRadius="4"
                                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                Visibility="{x:Bind MutedVisibility, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE74F;" FontSize="9" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Slider
                                        Grid.Column="1"
                                        Margin="4,0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="MixerSlider"
                                        AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                        Minimum="0"
                                        Maximum="100"
                                        StepFrequency="1"
                                        Value="{x:Bind Volume, Mode=TwoWay}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        x:Name="NoMixerAppsText"
                        Margin="4,4,0,8"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="No apps are playing sound" />
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Style="{StaticResource PageFooterStyle}">
                <Button
                    AutomationProperties.AutomationId="MoreVolumeSettingsButton"
                    Style="{StaticResource FooterLinkStyle}"
                    Content="More volume settings"
                    Click="SoundSettings_Click" />
            </Border>
        </Grid>

        <!-- Wi-Fi: the switch, the networks in range, connecting to one. -->
        <Grid x:Name="WifiPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Padding="8,8,12,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button AutomationProperties.AutomationId="WifiBackButton" Style="{StaticResource BackButtonStyle}" Click="Back_Click">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <TextBlock Grid.Column="1" Style="{StaticResource PageTitleStyle}" Text="Wi-Fi" />
                <Button
                    x:Name="WifiRefreshButton"
                    Grid.Column="2"
                    AutomationProperties.AutomationId="WifiRefreshButton"
                    AutomationProperties.Name="Refresh"
                    ToolTipService.ToolTip="Refresh"
                    Style="{StaticResource FlatButtonStyle}"
                    Width="32"
                    Height="32"
                    Click="WifiRefresh_Click">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <ToggleSwitch
                    x:Name="WifiSwitch"
                    Grid.Column="3"
                    MinWidth="0"
                    OnContent=""
                    OffContent=""
                    AutomationProperties.AutomationId="WifiSwitch"
                    AutomationProperties.Name="Wi-Fi"
                    Toggled="WifiSwitch_Toggled" />
            </Grid>
            <Grid Grid.Row="1" MinHeight="240" MaxHeight="400">
                <ListView
                    x:Name="WifiList"
                    Padding="8,0,8,8"
                    AutomationProperties.AutomationId="WifiNetworkList"
                    AutomationProperties.Name="Wi-Fi networks"
                    SelectionMode="Single"
                    SelectionChanged="WifiList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:WifiItem">
                            <StackPanel Padding="0,8" Spacing="8" AutomationProperties.Name="{x:Bind Name}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,0,0">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                                        <FontIcon
                                            Glyph="&#xE72E;"
                                            FontSize="9"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Visibility="{x:Bind LockVisibility}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Status, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                                <!-- The chosen network: connect (with its key when Windows has none), or disconnect. -->
                                <StackPanel Spacing="8" Margin="32,0,0,0" Visibility="{x:Bind ExpandedVisibility, Mode=OneWay}">
                                    <CheckBox
                                        AutomationProperties.AutomationId="WifiConnectAutomatically"
                                        Content="Connect automatically"
                                        IsChecked="{x:Bind ConnectAutomatically, Mode=TwoWay}"
                                        Visibility="{x:Bind ConnectVisibility, Mode=OneWay}" />
                                    <PasswordBox
                                        AutomationProperties.AutomationId="WifiPassword"
                                        PlaceholderText="Enter the network security key"
                                        Password="{x:Bind Password, Mode=TwoWay}"
                                        Visibility="{x:Bind PasswordVisibility, Mode=OneWay}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button
                                            AutomationProperties.AutomationId="WifiConnectButton"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Content="{x:Bind ActionText, Mode=OneWay}"
                                            IsEnabled="{x:Bind IsIdle, Mode=OneWay}"
                                            Click="WifiAction_Click" />
                                        <Button
                                            AutomationProperties.AutomationId="WifiCancelButton"
                                            Content="Cancel"
                                            Visibility="{x:Bind PasswordVisibility, Mode=OneWay}"
                                            Click="WifiCancel_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="WifiMessage" Margin="24" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                    <ProgressRing x:Name="WifiProgress" IsActive="False" Visibility="Collapsed" />
                    <TextBlock x:Name="WifiMessageText" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="2" Style="{StaticResource PageFooterStyle}">
                <Button
                    AutomationProperties.AutomationId="MoreWifiSettingsButton"
                    Style="{StaticResource FooterLinkStyle}"
                    Content="More Wi-Fi settings"
                    Click="WifiSettings_Click" />
            </Border>
        </Grid>

        <!-- Bluetooth: the switch and the paired devices; audio devices connect and disconnect here. -->
        <Grid x:Name="BluetoothPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Padding="8,8,12,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button AutomationProperties.AutomationId="BluetoothBackButton" Style="{StaticResource BackButtonStyle}" Click="Back_Click">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <TextBlock Grid.Column="1" Style="{StaticResource PageTitleStyle}" Text="Bluetooth" />
                <ToggleSwitch
                    x:Name="BluetoothSwitch"
                    Grid.Column="2"
                    MinWidth="0"
                    OnContent=""
                    OffContent=""
                    AutomationProperties.AutomationId="BluetoothSwitch"
                    AutomationProperties.Name="Bluetooth"
                    Toggled="BluetoothSwitch_Toggled" />
            </Grid>
            <Grid Grid.Row="1" MinHeight="240" MaxHeight="400">
                <ListView
                    x:Name="BluetoothList"
                    Padding="8,0,8,8"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="BluetoothList_ItemClick"
                    AutomationProperties.AutomationId="BluetoothDeviceList"
                    AutomationProperties.Name="Paired devices">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:BluetoothItem">
                            <StackPanel Padding="0,8" Spacing="8" AutomationProperties.Name="{x:Bind Name}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                AutomationProperties.AutomationId="BluetoothDeviceStatus"
                                                Style="{StaticResource SecondaryTextStyle}"
                                                Text="{x:Bind Status, Mode=OneWay}" />
                                            <!-- The battery, as Windows shows it for devices that report one. -->
                                            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind DeviceBatteryVisibility, Mode=OneWay}">
                                                <FontIcon
                                                    Glyph="{x:Bind DeviceBatteryGlyph, Mode=OneWay}"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock
                                                    AutomationProperties.AutomationId="BluetoothDeviceBattery"
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind DeviceBatteryText, Mode=OneWay}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <!-- A connected audio device, chosen: disconnect it. -->
                                <Button
                                    MinWidth="148"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.AutomationId="BluetoothDisconnectButton"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Content="Disconnect"
                                    IsEnabled="{x:Bind IsIdle, Mode=OneWay}"
                                    Visibility="{x:Bind DisconnectVisibility, Mode=OneWay}"
                                    Click="BluetoothDisconnect_Click" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    x:Name="BluetoothMessage"
                    Margin="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </Grid>
            <Border Grid.Row="2" Style="{StaticResource PageFooterStyle}">
                <Button
                    AutomationProperties.AutomationId="MoreBluetoothSettingsButton"
                    Style="{StaticResource FooterLinkStyle}"
                    Content="More Bluetooth settings"
                    Click="BluetoothSettings_Click" />
            </Border>
        </Grid>

        <!-- Accessibility: assistive technologies by need. -->
        <Grid x:Name="AccessibilityPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Padding="8,8,12,4" Orientation="Horizontal" Spacing="8">
                <Button AutomationProperties.AutomationId="AccessibilityBackButton" Style="{StaticResource BackButtonStyle}" Click="Back_Click">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Accessibility" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" Height="300" Padding="12,0,12,8" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Vision" />
                    <ItemsControl x:Name="VisionFeatures" IsTabStop="False" ItemTemplate="{StaticResource AssistiveRowTemplate}" />
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Hearing" />
                    <ItemsControl x:Name="HearingFeatures" IsTabStop="False" ItemTemplate="{StaticResource AssistiveRowTemplate}" />
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Motor and Mobility" />
                    <ItemsControl x:Name="MobilityFeatures" IsTabStop="False" ItemTemplate="{StaticResource AssistiveRowTemplate}" />
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Style="{StaticResource PageFooterStyle}">
                <Button
                    AutomationProperties.AutomationId="MoreAccessibilitySettingsButton"
                    Style="{StaticResource FooterLinkStyle}"
                    Content="More Accessibility settings"
                    Click="AccessibilitySettings_Click" />
            </Border>
        </Grid>

        <!-- Cast: wireless displays (Miracast), or a cable where the PC can't. -->
        <Grid x:Name="CastPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Padding="8,8,12,4" Orientation="Horizontal" Spacing="8">
                <Button AutomationProperties.AutomationId="CastBackButton" Style="{StaticResource BackButtonStyle}" Click="Back_Click">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Cast" />
                <local:ShortcutKeys Shortcut="K" />
            </StackPanel>
            <StackPanel Grid.Row="1" Height="300" Padding="16,24" Spacing="8">
                <TextBlock x:Name="CastTitle" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="18" TextWrapping="Wrap" />
                <TextBlock x:Name="CastText" TextWrapping="Wrap" />
                <Button
                    x:Name="FindDisplaysButton"
                    Margin="0,8,0,0"
                    AutomationProperties.AutomationId="FindWirelessDisplaysButton"
                    Content="Find wireless displays"
                    Click="FindDisplays_Click" />
            </StackPanel>
            <Border Grid.Row="2" Style="{StaticResource PageFooterStyle}">
                <Button
                    x:Name="MoreCastSettingsButton"
                    AutomationProperties.AutomationId="MoreCastSettingsButton"
                    Style="{StaticResource FooterLinkStyle}"
                    Content="More cast settings"
                    Click="DisplaySettings_Click" />
            </Border>
        </Grid>

        <!-- Project: how the screens are used together, as Win+P. -->
        <Grid x:Name="ProjectPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Padding="8,8,12,4" Orientation="Horizontal" Spacing="8">
                <Button AutomationProperties.AutomationId="ProjectBackButton" Style="{StaticResource BackButtonStyle}" Click="Back_Click">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Project" />
                <local:ShortcutKeys Shortcut="P" />
            </StackPanel>
            <ListView
                x:Name="ProjectionModes"
                Grid.Row="1"
                Height="300"
                Padding="4,0,4,8"
                AutomationProperties.AutomationId="ProjectionModeList"
                AutomationProperties.Name="Project"
                SelectionMode="Single"
                SelectionChanged="ProjectionModes_SelectionChanged" />
            <Border Grid.Row="2" Style="{StaticResource PageFooterStyle}">
                <Button
                    AutomationProperties.AutomationId="MoreDisplaySettingsButton"
                    Style="{StaticResource FooterLinkStyle}"
                    Content="More Display settings"
                    Click="DisplaySettings_Click" />
            </Border>
        </Grid>

        <!-- VPN: the VPN connections set up in Windows, connected or hung up from here. -->
        <Grid x:Name="VpnPage" MinHeight="400" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Padding="8,8,12,4" Orientation="Horizontal" Spacing="8">
                <Button AutomationProperties.AutomationId="VpnBackButton" Style="{StaticResource BackButtonStyle}" Click="Back_Click">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="VPN" />
            </StackPanel>
            <Grid Grid.Row="1" MaxHeight="400">
                <ListView
                    x:Name="VpnList"
                    Padding="1,4,1,8"
                    AutomationProperties.AutomationId="VpnConnectionList"
                    AutomationProperties.Name="VPN connections"
                    SelectionMode="Single"
                    SelectionChanged="VpnList_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Padding" Value="16,0,16,0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:VpnItem">
                            <StackPanel Padding="0,8" Spacing="35" AutomationProperties.Name="{x:Bind Name}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE705;" FontSize="26" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Status}" Visibility="{x:Bind StatusVisibility}" />
                                    </StackPanel>
                                </Grid>
                                <!-- The chosen connection: connect, or disconnect the connected one. -->
                                <Button
                                    MinWidth="148"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.AutomationId="VpnConnectButton"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Content="{x:Bind ActionText}"
                                    Visibility="{x:Bind ExpandedVisibility, Mode=OneWay}"
                                    Click="VpnAction_Click" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    x:Name="VpnMessage"
                    Margin="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Text="No VPN connections"
                    Visibility="Collapsed" />
            </Grid>
            <Border Grid.Row="2" Style="{StaticResource PageFooterStyle}">
                <!-- Smaller and dimmer than the other pages' links, as Windows'. -->
                <Button
                    AutomationProperties.AutomationId="MoreVpnSettingsButton"
                    Style="{StaticResource FooterLinkStyle}"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Content="More VPN settings"
                    Click="VpnSettings_Click" />
            </Border>
        </Grid>

        <!-- Nearby sharing: its switch, and what turning it on does. -->
        <Grid x:Name="NearbySharingPage" MinHeight="400" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Padding="8,8,12,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button AutomationProperties.AutomationId="NearbySharingBackButton" Style="{StaticResource BackButtonStyle}" Click="Back_Click">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <TextBlock Grid.Column="1" Style="{StaticResource PageTitleStyle}" Text="Nearby sharing" />
                <ToggleSwitch
                    x:Name="NearbySharingSwitch"
                    Grid.Column="2"
                    MinWidth="0"
                    OnContent=""
                    OffContent=""
                    AutomationProperties.AutomationId="NearbySharingSwitch"
                    AutomationProperties.Name="Nearby sharing"
                    Toggled="NearbySharingSwitch_Toggled" />
            </Grid>
            <StackPanel Grid.Row="1" Padding="16,24" Spacing="8">
                <TextBlock x:Name="NearbySharingTitle" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="18" TextWrapping="Wrap" />
                <TextBlock x:Name="NearbySharingText" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Row="2" Style="{StaticResource PageFooterStyle}">
                <Button
                    AutomationProperties.AutomationId="MoreNearbySharingSettingsButton"
                    Style="{StaticResource FooterLinkStyle}"
                    Content="More Nearby sharing settings"
                    Click="NearbySharingSettings_Click" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
