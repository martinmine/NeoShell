<?xml version="1.0" encoding="utf-8"?>
<!--
    The Windows 11 theme: WinUI's own controls and colours, as Explorer looks. Every key here is one the views look up,
    so every theme defines them all (ThemeTests checks).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:themes="using:NeoShell.Themes">

    <!-- Explorer's logo on the Start button: four 11 px squares. -->
    <DataTemplate x:Key="StartLogoTemplate">
        <Grid Width="23" Height="23" ColumnSpacing="1" RowSpacing="1">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
            <Rectangle Grid.Row="0" Grid.Column="1" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
            <Rectangle Grid.Row="1" Grid.Column="0" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
            <Rectangle Grid.Row="1" Grid.Column="1" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
        </Grid>
    </DataTemplate>

    <!-- Windows 11 draws nothing over its surfaces. -->
    <Style x:Key="CardDecorationStyle" TargetType="themes:Decoration">
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>
    <Style x:Key="PanelDecorationStyle" TargetType="themes:Decoration">
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>
    <Style x:Key="TaskbarDecorationStyle" TargetType="themes:Decoration">
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>
    <Style x:Key="DesktopDecorationStyle" TargetType="themes:Decoration">
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style TargetType="themes:Heading">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="themes:Heading">
                    <TextBlock VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{TemplateBinding Text}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A heading in body text, as the notification center's. -->
    <Style x:Key="PlainHeadingStyle" TargetType="themes:Heading">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="themes:Heading">
                    <TextBlock VerticalAlignment="Center" Text="{TemplateBinding Text}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A widget's card in the sidebar, or a floating widget's window. -->
    <Style x:Key="WidgetCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    </Style>
    <Thickness x:Key="WidgetCardPadding">12</Thickness>
    <!-- The title inside a widget, beside its settings and close buttons. -->
    <Style x:Key="WidgetTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Under a task button: a short grey pill while the app runs, a long accent one while it's active. -->
    <Style x:Key="TaskRunningIndicatorStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="3" />
        <Setter Property="RadiusX" Value="1.5" />
        <Setter Property="RadiusY" Value="1.5" />
        <Setter Property="Fill" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>
    <Style x:Key="TaskActiveIndicatorStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="3" />
        <Setter Property="RadiusX" Value="1.5" />
        <Setter Property="RadiusY" Value="1.5" />
        <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    </Style>

    <Style x:Key="ClockTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <CornerRadius x:Key="SearchBoxCornerRadius">16</CornerRadius>

    <!-- Figures and logs. -->
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas</FontFamily>
</ResourceDictionary>
