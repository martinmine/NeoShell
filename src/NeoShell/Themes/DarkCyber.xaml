<?xml version="1.0" encoding="utf-8"?>
<!--
    Dark Cyber: black, white and signal red; Bahnschrift for text and Cascadia Mono for figures, capitals in headings,
    Japanese beside them; square corners with white markers on the edges, and a little movement.

    WinUI's own controls are recoloured rather than replaced: their brushes are redefined here (their templates look
    them up by name), and DarkCyber.Controls.xaml points each control's brushes at these. Its text styles are
    redefined too, since they name their font themselves.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:themes="using:NeoShell.Themes">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/DarkCyber.Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ===== Palette ===== -->
    <Color x:Key="CyberBlack">#FF050507</Color>
    <Color x:Key="CyberWhite">#FFF2F2F2</Color>
    <Color x:Key="CyberGray">#FF9B9BA3</Color>
    <Color x:Key="CyberDim">#FF5E5E68</Color>
    <Color x:Key="CyberRed">#FFFF2A3D</Color>
    <Color x:Key="CyberRedDim">#FF9E1625</Color>

    <SolidColorBrush x:Key="CyberBlackBrush" Color="{StaticResource CyberBlack}" />
    <SolidColorBrush x:Key="CyberWhiteBrush" Color="{StaticResource CyberWhite}" />
    <SolidColorBrush x:Key="CyberGrayBrush" Color="{StaticResource CyberGray}" />
    <SolidColorBrush x:Key="CyberDimBrush" Color="{StaticResource CyberDim}" />
    <SolidColorBrush x:Key="CyberRedBrush" Color="{StaticResource CyberRed}" />
    <SolidColorBrush x:Key="CyberRedDimBrush" Color="{StaticResource CyberRedDim}" />
    <SolidColorBrush x:Key="CyberLineBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="CyberMarkerBrush" Color="#E6FFFFFF" />

    <LinearGradientBrush x:Key="CyberScanBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#00FF2A3D" />
        <GradientStop Offset="0.5" Color="#FFFF2A3D" />
        <GradientStop Offset="1" Color="#00FF2A3D" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CyberScanlineBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#00FF2A3D" />
        <GradientStop Offset="0.85" Color="#30FF2A3D" />
        <GradientStop Offset="1" Color="#B0FF2A3D" />
    </LinearGradientBrush>

    <!-- Windows' accent colour is red here, whatever the user picked. -->
    <Color x:Key="SystemAccentColor">#FFFF2A3D</Color>
    <Color x:Key="SystemAccentColorLight1">#FFFF4A5A</Color>
    <Color x:Key="SystemAccentColorLight2">#FFFF6B78</Color>
    <Color x:Key="SystemAccentColorLight3">#FFFF9AA3</Color>
    <Color x:Key="SystemAccentColorDark1">#FFD81E30</Color>
    <Color x:Key="SystemAccentColorDark2">#FFB01625</Color>
    <Color x:Key="SystemAccentColorDark3">#FF7A0E19</Color>

    <!-- ===== Type ===== -->
    <FontFamily x:Key="CyberFont">Bahnschrift</FontFamily>
    <FontFamily x:Key="CyberDisplayFont">Bahnschrift SemiBold SemiCondensed</FontFamily>
    <FontFamily x:Key="CyberMonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="CyberJapaneseFont">Yu Gothic UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="ContentControlThemeFontFamily">Bahnschrift</FontFamily>

    <themes:UpperCaseConverter x:Key="UpperCase" />

    <!-- Plain text blocks, and those in WinUI's own templates. -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CyberFont}" />
    </Style>

    <Style x:Key="BaseTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CyberFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineStackingStrategy" Value="MaxHeight" />
        <Setter Property="TextLineBounds" Value="Full" />
    </Style>
    <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="BodyStrongTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" />
    <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource CyberDisplayFont}" />
        <Setter Property="FontSize" Value="20" />
    </Style>
    <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource CyberDisplayFont}" />
        <Setter Property="FontSize" Value="28" />
    </Style>
    <Style x:Key="TitleLargeTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource CyberDisplayFont}" />
        <Setter Property="FontSize" Value="40" />
    </Style>
    <Style x:Key="DisplayTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource CyberDisplayFont}" />
        <Setter Property="FontSize" Value="68" />
    </Style>

    <!-- Square everything. -->
    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="SearchBoxCornerRadius">0</CornerRadius>


    <!-- ===== NeoShell's own slots (see Windows11.xaml) ===== -->

    <!-- A white diamond with a red core that breathes. -->
    <DataTemplate x:Key="StartLogoTemplate">
        <Grid Width="24" Height="24">
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Core" Storyboard.TargetProperty="Opacity">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0.35" />
                                <LinearDoubleKeyFrame KeyTime="0:0:2.8" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
            <Rectangle Width="15" Height="15" Stroke="{StaticResource CyberWhiteBrush}" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="45" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="Core" Width="6" Height="6" Fill="{StaticResource CyberRedBrush}" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="45" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>
    </DataTemplate>

    <!-- A widget's card: its name in capitals at the top, a blinking red pip, and white corner markers. -->
    <Style x:Key="CardDecorationStyle" TargetType="themes:Decoration">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="themes:Decoration">
                    <Grid>
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Markers" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Label" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.14" Value="0.2" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.22" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pip" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.6" Value="0.15" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.8" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="0.15" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:3.2" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                        <StackPanel x:Name="Label" Margin="12,9,40,0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Top">
                            <Rectangle x:Name="Pip" Width="5" Height="5" Fill="{StaticResource CyberRedBrush}" VerticalAlignment="Center" />
                            <TextBlock
                                FontFamily="{StaticResource CyberDisplayFont}"
                                FontSize="11"
                                CharacterSpacing="180"
                                Foreground="{StaticResource CyberWhiteBrush}"
                                Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UpperCase}}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CyberJapaneseFont}"
                                FontSize="10"
                                Foreground="{StaticResource CyberDimBrush}"
                                Text="{TemplateBinding Subtitle}" />
                        </StackPanel>
                        <Grid x:Name="Markers">
                            <Path HorizontalAlignment="Left" VerticalAlignment="Top" Data="M0,9 L0,0 L9,0" Stroke="{StaticResource CyberMarkerBrush}" StrokeThickness="1.5" />
                            <Path HorizontalAlignment="Right" VerticalAlignment="Top" Data="M0,0 L9,0 L9,9" Stroke="{StaticResource CyberMarkerBrush}" StrokeThickness="1.5" />
                            <Path HorizontalAlignment="Left" VerticalAlignment="Bottom" Data="M0,0 L0,9 L9,9" Stroke="{StaticResource CyberMarkerBrush}" StrokeThickness="1.5" />
                            <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Data="M9,0 L9,9 L0,9" Stroke="{StaticResource CyberMarkerBrush}" StrokeThickness="1.5" />
                            <!-- A short red rule on the bottom edge. -->
                            <Rectangle Width="28" Height="2" Margin="0,0,16,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{StaticResource CyberRedBrush}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A panel (Start, the notification center): large corner brackets, a label in the top-right corner, ticks down
        the right edge, and on opening a red scan line sweeping down.
    -->
    <Style x:Key="PanelDecorationStyle" TargetType="themes:Decoration">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="themes:Decoration">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="Intro">
                                <VisualState x:Name="Hidden">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Markers" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Scan" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Shown">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Markers" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="0.25" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="MarkersScale" Storyboard.TargetProperty="ScaleX" From="1.04" To="1" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="MarkersScale" Storyboard.TargetProperty="ScaleY" From="1.04" To="1" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Scan" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.7" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ScanMove" Storyboard.TargetProperty="Y" From="-60" To="1400" Duration="0:0:0.9">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Rectangle x:Name="Scan" Height="60" VerticalAlignment="Top" Fill="{StaticResource CyberScanlineBrush}" Opacity="0">
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="ScanMove" />
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <Grid x:Name="Markers" Margin="1" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="MarkersScale" />
                            </Grid.RenderTransform>
                            <Path HorizontalAlignment="Left" VerticalAlignment="Top" Data="M0,16 L0,0 L16,0" Stroke="{StaticResource CyberMarkerBrush}" StrokeThickness="2" />
                            <Path HorizontalAlignment="Right" VerticalAlignment="Top" Data="M0,0 L16,0 L16,16" Stroke="{StaticResource CyberMarkerBrush}" StrokeThickness="2" />
                            <Path HorizontalAlignment="Left" VerticalAlignment="Bottom" Data="M0,0 L0,16 L16,16" Stroke="{StaticResource CyberMarkerBrush}" StrokeThickness="2" />
                            <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Data="M16,0 L16,16 L0,16" Stroke="{StaticResource CyberMarkerBrush}" StrokeThickness="2" />
                            <Rectangle Width="56" Height="2" Margin="24,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{StaticResource CyberRedBrush}" />
                            <!-- Ticks down the right edge, like a ruler. -->
                            <StackPanel Margin="0,48,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="7">
                                <Rectangle Width="6" Height="1" Fill="{StaticResource CyberLineBrush}" />
                                <Rectangle Width="3" Height="1" HorizontalAlignment="Right" Fill="{StaticResource CyberLineBrush}" />
                                <Rectangle Width="3" Height="1" HorizontalAlignment="Right" Fill="{StaticResource CyberLineBrush}" />
                                <Rectangle Width="3" Height="1" HorizontalAlignment="Right" Fill="{StaticResource CyberLineBrush}" />
                                <Rectangle Width="6" Height="1" Fill="{StaticResource CyberLineBrush}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,3,26,0" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                FontFamily="{StaticResource CyberJapaneseFont}"
                                FontSize="9"
                                Foreground="{StaticResource CyberDimBrush}"
                                Text="{TemplateBinding Subtitle}" />
                            <TextBlock
                                FontFamily="{StaticResource CyberMonoFont}"
                                FontSize="9"
                                CharacterSpacing="120"
                                Foreground="{StaticResource CyberDimBrush}"
                                Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UpperCase}}" />
                            <TextBlock FontFamily="{StaticResource CyberMonoFont}" FontSize="9" Foreground="{StaticResource CyberRedBrush}" Text="//NS" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The taskbar: a hairline along the top with a red scanner running along it now and then. -->
    <Style x:Key="TaskbarDecorationStyle" TargetType="themes:Decoration">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="themes:Decoration">
                    <Grid>
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScannerMove" Storyboard.TargetProperty="X">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-200" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:3.5" Value="4000">
                                                <EasingDoubleKeyFrame.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut" />
                                                </EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:12" Value="4000" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                        <Rectangle Height="1" VerticalAlignment="Top" Fill="{StaticResource CyberLineBrush}" />
                        <Rectangle Width="120" Height="2" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{StaticResource CyberRedBrush}" />
                        <Rectangle Width="1" Height="7" Margin="124,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{StaticResource CyberMarkerBrush}" />
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Spacing="3" Margin="0,0,16,0">
                            <Rectangle Width="1" Height="5" Fill="{StaticResource CyberMarkerBrush}" />
                            <Rectangle Width="1" Height="5" Fill="{StaticResource CyberMarkerBrush}" />
                            <Rectangle Width="1" Height="5" Fill="{StaticResource CyberMarkerBrush}" />
                            <Rectangle Width="18" Height="2" Margin="3,0,0,0" Fill="{StaticResource CyberRedBrush}" />
                        </StackPanel>
                        <Rectangle Width="160" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{StaticResource CyberScanBrush}">
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="ScannerMove" X="-200" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The desktop, over the wallpaper (shell mode): darker towards the top and bottom, brackets in the corners, a
        status line across the top and a faint red line sweeping down now and then.
    -->
    <Style x:Key="DesktopDecorationStyle" TargetType="themes:Decoration">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="themes:Decoration">
                    <Grid>
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SweepMove" Storyboard.TargetProperty="Y">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-120" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:6" Value="3000" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:20" Value="3000" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Online" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.8" Value="0.2" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="160" />
                            <RowDefinition />
                            <RowDefinition Height="200" />
                        </Grid.RowDefinitions>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#99000000" />
                                    <GradientStop Offset="1" Color="#00000000" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Grid.Row="2">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#00000000" />
                                    <GradientStop Offset="1" Color="#B3000000" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <Rectangle Grid.RowSpan="3" Height="120" VerticalAlignment="Top" Fill="{StaticResource CyberScanlineBrush}" Opacity="0.25">
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="SweepMove" Y="-120" />
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <!-- The bottom brackets clear the taskbar. -->
                        <Grid Grid.RowSpan="3" Margin="14,14,14,62">
                            <Path HorizontalAlignment="Left" VerticalAlignment="Top" Data="M0,22 L0,0 L22,0" Stroke="{StaticResource CyberMarkerBrush}" StrokeThickness="2" Opacity="0.7" />
                            <Path HorizontalAlignment="Right" VerticalAlignment="Top" Data="M0,0 L22,0 L22,22" Stroke="{StaticResource CyberMarkerBrush}" StrokeThickness="2" Opacity="0.7" />
                            <Path HorizontalAlignment="Left" VerticalAlignment="Bottom" Data="M0,0 L0,22 L22,22" Stroke="{StaticResource CyberMarkerBrush}" StrokeThickness="2" Opacity="0.7" />
                            <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Data="M22,0 L22,22 L0,22" Stroke="{StaticResource CyberMarkerBrush}" StrokeThickness="2" Opacity="0.7" />
                        </Grid>

                        <StackPanel Margin="0,12,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Orientation="Horizontal" Spacing="10">
                            <Rectangle Width="80" Height="1" VerticalAlignment="Center" Fill="{StaticResource CyberLineBrush}" />
                            <Rectangle Width="6" Height="6" VerticalAlignment="Center" Fill="{StaticResource CyberRedBrush}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="45" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <TextBlock FontFamily="{StaticResource CyberDisplayFont}" FontSize="12" CharacterSpacing="300" Foreground="{StaticResource CyberWhiteBrush}" Text="NEO//SHELL" />
                            <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource CyberJapaneseFont}" FontSize="11" Foreground="{StaticResource CyberGrayBrush}" Text="ネオシェル" />
                            <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource CyberMonoFont}" FontSize="11" Foreground="{StaticResource CyberGrayBrush}" Text="{TemplateBinding Title}" />
                            <TextBlock x:Name="Online" VerticalAlignment="Center" FontFamily="{StaticResource CyberMonoFont}" FontSize="11" Foreground="{StaticResource CyberRedBrush}" Text="&#x25CF; ONLINE" />
                            <Rectangle Width="80" Height="1" VerticalAlignment="Center" Fill="{StaticResource CyberLineBrush}" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "// PINNED  ピン留め ―" -->
    <Style x:Key="CyberHeadingStyle" TargetType="themes:Heading">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="themes:Heading">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <TextBlock FontFamily="{StaticResource CyberDisplayFont}" FontSize="13" Foreground="{StaticResource CyberRedBrush}" Text="//" />
                        <TextBlock
                            FontFamily="{StaticResource CyberDisplayFont}"
                            FontSize="13"
                            CharacterSpacing="200"
                            Foreground="{StaticResource CyberWhiteBrush}"
                            Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UpperCase}}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CyberJapaneseFont}"
                            FontSize="11"
                            Foreground="{StaticResource CyberDimBrush}"
                            Text="{TemplateBinding Subtitle}" />
                        <Rectangle Width="28" Height="1" VerticalAlignment="Center" Fill="{StaticResource CyberLineBrush}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="themes:Heading" BasedOn="{StaticResource CyberHeadingStyle}" />
    <Style x:Key="PlainHeadingStyle" TargetType="themes:Heading" BasedOn="{StaticResource CyberHeadingStyle}" />

    <Style x:Key="WidgetCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    </Style>
    <!-- The card's label names the widget (CardDecorationStyle). -->
    <Style x:Key="WidgetTitleStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>
    <!-- Room at the top for the card's label (CardDecorationStyle). -->
    <Thickness x:Key="WidgetCardPadding">12,30,12,12</Thickness>

    <!-- Square marks under the task buttons: a white tick while running, a red bar while active. -->
    <Style x:Key="TaskRunningIndicatorStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="4" />
        <Setter Property="Height" Value="2" />
        <Setter Property="Fill" Value="{StaticResource CyberGrayBrush}" />
    </Style>
    <Style x:Key="TaskActiveIndicatorStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="2" />
        <Setter Property="Fill" Value="{StaticResource CyberRedBrush}" />
    </Style>

    <Style x:Key="ClockTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CyberMonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
</ResourceDictionary>
